<style>
  #shopify-section-{{ section.id }} .gn-contact {
    background: {{ section.settings.background_color | default: '#f7f5ef' }};
    padding: {{ section.settings.padding_top | default: 70 }}px 32px {{ section.settings.padding_bottom | default: 80 }}px;
  }
  #shopify-section-{{ section.id }} .gn-contact__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: 60px;
  }
  #shopify-section-{{ section.id }} .gn-contact__info-heading {
    margin: 0 0 10px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 700;
    font-size: 1.5rem;
    color: {{ section.settings.heading_color | default: '#464646' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__info-desc {
    margin: 0 0 28px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: {{ section.settings.text_color | default: '#767671' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #shopify-section-{{ section.id }} .gn-contact__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .gn-contact__item-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: {{ section.settings.accent_color | default: '#ec7901' }};
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .gn-contact__item-icon svg {
    width: 17px;
    height: 17px;
  }
  #shopify-section-{{ section.id }} .gn-contact__item-label {
    margin: 0 0 2px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#ec7901' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__item-value {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.4;
    color: {{ section.settings.heading_color | default: '#464646' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__item-value a {
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .gn-contact__item-value a:hover {
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .gn-contact__form-box {
    background: #ffffff;
    border-radius: 16px;
    padding: 40px;
  }
  #shopify-section-{{ section.id }} .gn-contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .gn-contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .gn-contact__label {
    font-size: 0.82rem;
    font-weight: 600;
    color: {{ section.settings.heading_color | default: '#464646' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__input,
  #shopify-section-{{ section.id }} .gn-contact__textarea {
    width: 100%;
    padding: 13px 16px;
    border-radius: 8px;
    border: 1px solid {{ section.settings.border_color | default: '#d2d3cc' }};
    background: #ffffff;
    color: {{ section.settings.heading_color | default: '#464646' }};
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 0.95rem;
  }
  #shopify-section-{{ section.id }} .gn-contact__input:focus,
  #shopify-section-{{ section.id }} .gn-contact__textarea:focus {
    outline: none;
    border-color: {{ section.settings.accent_color | default: '#ec7901' }};
  }
  #shopify-section-{{ section.id }} .gn-contact__textarea {
    resize: vertical;
    min-height: 130px;
  }
  #shopify-section-{{ section.id }} .gn-contact__error {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: #c0392b;
  }
  #shopify-section-{{ section.id }} .gn-contact__success {
    margin: 0 0 20px;
    padding: 14px 18px;
    border-radius: 8px;
    background: #e9f5ec;
    color: #1d3d2a;
    font-size: 0.92rem;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .gn-contact__submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border: none;
    border-radius: 6px;
    background: {{ section.settings.accent_color | default: '#ec7901' }};
    color: #ffffff;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .gn-contact__submit:hover {
    opacity: 0.88;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .gn-contact__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    #shopify-section-{{ section.id }} .gn-contact__form-box {
      padding: 28px 22px;
    }
    #shopify-section-{{ section.id }} .gn-contact__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<div class="gn-contact">
  <div class="gn-contact__inner">
    <div class="gn-contact__info">
      {%- if section.settings.info_heading != blank -%}
        <h2 class="gn-contact__info-heading">{{ section.settings.info_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.info_description != blank -%}
        <p class="gn-contact__info-desc">{{ section.settings.info_description }}</p>
      {%- endif -%}
      <div class="gn-contact__items">
        {%- for block in section.blocks -%}
          {%- if block.type == 'info' -%}
            <div class="gn-contact__item" {{ block.shopify_attributes }}>
              <span class="gn-contact__item-icon">
                {%- case block.settings.icon -%}
                  {%- when 'mail' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  {%- when 'marker' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                {%- endcase -%}
              </span>
              <span>
                {%- if block.settings.label != blank -%}
                  <p class="gn-contact__item-label">{{ block.settings.label }}</p>
                {%- endif -%}
                {%- if block.settings.value != blank -%}
                  <p class="gn-contact__item-value">
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}">{{ block.settings.value }}</a>
                    {%- else -%}
                      {{ block.settings.value }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="gn-contact__form-box">
      {%- form 'contact', id: 'GnContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="gn-contact__success">Thanks — your message has been sent. We'll get back to you soon.</p>
        {%- endif -%}

        <div class="gn-contact__row">
          <div class="gn-contact__field">
            <label class="gn-contact__label" for="GnContactForm-name">Name</label>
            <input class="gn-contact__input" type="text" id="GnContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
          <div class="gn-contact__field">
            <label class="gn-contact__label" for="GnContactForm-phone">Phone</label>
            <input class="gn-contact__input" type="tel" id="GnContactForm-phone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          </div>
        </div>

        <div class="gn-contact__field">
          <label class="gn-contact__label" for="GnContactForm-email">Email *</label>
          <input class="gn-contact__input" autocomplete="email" type="email" id="GnContactForm-email" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="GnContactForm-email-error"{% endif %}>
          {%- if form.errors contains 'email' -%}
            <p class="gn-contact__error" id="GnContactForm-email-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        </div>

        <div class="gn-contact__field">
          <label class="gn-contact__label" for="GnContactForm-body">Message</label>
          <textarea class="gn-contact__textarea" id="GnContactForm-body" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="gn-contact__submit">
          {{ section.settings.submit_label | default: 'Send message' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Info column" },
    { "type": "text", "id": "info_heading", "label": "Heading", "default": "Contact information" },
    { "type": "textarea", "id": "info_description", "label": "Description", "default": "Prefer to reach us directly? Use any of the details below." },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f7f5ef" },
    { "type": "color", "id": "heading_color", "label": "Heading / text color", "default": "#464646" },
    { "type": "color", "id": "text_color", "label": "Description color", "default": "#767671" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ec7901" },
    { "type": "color", "id": "border_color", "label": "Input border color", "default": "#d2d3cc" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "marker", "label": "Location" },
            { "value": "clock", "label": "Hours" }
          ],
          "default": "mail"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "value", "label": "Value", "default": "support@golfernow.com" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "info", "settings": { "icon": "mail", "label": "Email", "value": "support@golfernow.com", "link": "mailto:support@golfernow.com" } },
        { "type": "info", "settings": { "icon": "phone", "label": "Phone", "value": "(555) 555-1002", "link": "tel:5555551002" } },
        { "type": "info", "settings": { "icon": "clock", "label": "Hours", "value": "Mon–Fri, 9:00 AM – 5:00 PM" } }
      ]
    }
  ]
}
{% endschema %}
