<style>
  .gn-v2w {
    --gn-bg: #F5F1E8;
    --gn-card: #FFFFFF;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-forest: #1D3D2A;
    --gn-mid: #3A8A5B;
    --gn-mint: #9CCFB0;
    --gn-pale: #DDEFE3;
    --gn-border: #E8E2D4;
    --gn-mark: #DDEFE3;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2w *, .gn-v2w *::before, .gn-v2w *::after { box-sizing: border-box; }
  .gn-v2w__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2w__head { max-width: 680px; margin: 0 auto 40px; text-align: center; }
  .gn-v2w__eyebrow { margin: 0 0 10px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2w__heading { margin: 0 0 12px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.9rem, 3.6vw, 2.8rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }
  .gn-v2w__heading mark { padding: 0 0.18em; margin: 0 -0.05em; border-radius: 8px; background: var(--gn-mark); color: inherit; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .gn-v2w__copy { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--gn-muted); }
  .gn-v2w__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; list-style: none; margin: 0; padding: 0; }
  .gn-v2w__step { display: flex; flex-direction: column; align-items: flex-start; padding: 32px 28px 30px; background: var(--gn-card); border: 1px solid var(--gn-border); border-radius: 20px; }
  .gn-v2w__num { display: block; margin: 0 0 18px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: 3.4rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--gn-green); }
  .gn-v2w__title { margin: 0 0 10px; font-size: 1.35rem; font-weight: 800; line-height: 1.2; letter-spacing: -0.01em; }
  .gn-v2w__text { margin: 0 0 20px; font-size: 1rem; line-height: 1.55; color: var(--gn-muted); }
  .gn-v2w__chip { margin-top: auto; display: inline-block; padding: 7px 14px; border-radius: 999px; background: var(--gn-pale); color: var(--gn-green); font-size: 0.8rem; font-weight: 700; line-height: 1.2; }
  .gn-v2w__specs { margin: 20px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-radius: 20px; background: var(--gn-forest); color: #F5F1E8; overflow: hidden; }
  .gn-v2w__spec { padding: 26px 28px; border-left: 1px solid rgba(156, 207, 176, 0.2); }
  .gn-v2w__spec:first-child { border-left: 0; }
  .gn-v2w__spec-label { display: block; margin: 0 0 8px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mint); }
  .gn-v2w__spec-value { display: block; font-size: 1rem; font-weight: 700; line-height: 1.35; }
  @media (max-width: 989px) {
    .gn-v2w__steps { grid-template-columns: 1fr; }
    .gn-v2w__step { padding: 26px 24px; }
    .gn-v2w__num { font-size: 2.8rem; margin-bottom: 12px; }
    .gn-v2w__specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gn-v2w__spec:nth-child(odd) { border-left: 0; }
    .gn-v2w__spec:nth-child(n+3) { border-top: 1px solid rgba(156, 207, 176, 0.2); }
  }
  @media (max-width: 560px) {
    .gn-v2w__inner { padding: 0 16px; }
    .gn-v2w__head { margin-bottom: 28px; }
    .gn-v2w__spec { padding: 18px 18px; }
    .gn-v2w__spec-value { font-size: 0.92rem; }
  }
</style>

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign spec_blocks = section.blocks | where: 'type', 'spec'
  assign heading_html = section.settings.heading | escape
  if section.settings.highlight_text != blank
    assign highlight_safe = section.settings.highlight_text | escape
    if heading_html contains highlight_safe
      assign mark_html = '<mark>' | append: highlight_safe | append: '</mark>'
      assign heading_html = heading_html | replace: highlight_safe, mark_html
    endif
  endif
-%}

<section
  class="gn-v2w"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-green: {{ section.settings.accent_color }};
    --gn-forest: {{ section.settings.dark_color }};
    --gn-mid: {{ section.settings.highlight_color }};
    --gn-mint: {{ section.settings.mint_color }};
    --gn-pale: {{ section.settings.pale_color }};
    --gn-mark: {{ section.settings.mark_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2w__inner">
    <div class="gn-v2w__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gn-v2w__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="gn-v2w__heading">{{ heading_html }}</h2>
      {%- if section.settings.copy != blank -%}
        <p class="gn-v2w__copy">{{ section.settings.copy }}</p>
      {%- endif -%}
    </div>

    <ol class="gn-v2w__steps">
      {%- for block in step_blocks -%}
        <li class="gn-v2w__step" {{ block.shopify_attributes }}>
          <span class="gn-v2w__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="gn-v2w__title">{{ block.settings.title }}</h3>
          <p class="gn-v2w__text">{{ block.settings.text }}</p>
          {%- if block.settings.chip != blank -%}
            <span class="gn-v2w__chip">{{ block.settings.chip }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if spec_blocks.size > 0 -%}
      <ul class="gn-v2w__specs">
        {%- for block in spec_blocks -%}
          <li class="gn-v2w__spec" {{ block.shopify_attributes }}>
            <span class="gn-v2w__spec-label">{{ block.settings.label }}</span>
            <span class="gn-v2w__spec-value">{{ block.settings.value }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 How to",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW TO USE IT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five minutes. Anywhere." },
    { "type": "text", "id": "highlight_text", "label": "Highlighted words", "default": "Five minutes.", "info": "Must match part of the heading exactly. Leave blank for no highlight." },
    { "type": "textarea", "id": "copy", "label": "Intro", "info": "Optional." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F1E8" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#0B1C12" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4B5A50" },
    { "type": "color", "id": "accent_color", "label": "Number green", "default": "#1D3D2A" },
    { "type": "color", "id": "dark_color", "label": "Spec strip", "default": "#1D3D2A" },
    { "type": "color", "id": "highlight_color", "label": "Highlight green", "default": "#3A8A5B" },
    { "type": "color", "id": "mint_color", "label": "Mint", "default": "#9CCFB0" },
    { "type": "color", "id": "pale_color", "label": "Chip background", "default": "#DDEFE3" },
    { "type": "color", "id": "mark_color", "label": "Heading highlight", "default": "#DDEFE3" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8E2D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Set your grip" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hold the moulded grip. It places your hands in a neutral position every time." },
        { "type": "text", "id": "chip", "label": "Chip text", "info": "Optional. Shown as a mint pill at the bottom of the card." }
      ]
    },
    {
      "type": "spec",
      "name": "Spec",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Use" },
        { "type": "text", "id": "value", "label": "Value", "default": "No ball, net, or app needed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 How to",
      "blocks": [
        { "type": "step", "settings": { "title": "Set your grip", "text": "Hold the moulded grip. It places your hands in a neutral position every time.", "chip": "No ball needed" } },
        { "type": "step", "settings": { "title": "Swing and listen", "text": "Take slow swings. Move the click later, from the top toward the ball.", "chip": "10 swings · 3 min" } },
        { "type": "step", "settings": { "title": "Take it to the course", "text": "Five swings before your round, then hit your first tee shot with the same feel.", "chip": "Fits in your bag" } },
        { "type": "spec", "settings": { "label": "Use", "value": "No ball, net, or app needed" } },
        { "type": "spec", "settings": { "label": "Size", "value": "15.3\" collapsed, 26.5\" extended" } },
        { "type": "spec", "settings": { "label": "Build", "value": "Stainless steel shaft, resin head, rubber grip" } },
        { "type": "spec", "settings": { "label": "Where", "value": "Living room, garage, range, or warm-up" } }
      ]
    }
  ]
}
{% endschema %}
