<style>
  #shopify-section-{{ section.id }} .gn-halloween {
    position: relative;
    overflow: hidden;
    text-align: center;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .gn-halloween__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-halloween__eyebrow {
    margin: 0 0 8px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-halloween__heading {
    margin: 0 0 12px;
    font-family: var(--font-body-family);
    font-size: 2.8rem;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .gn-halloween__text {
    margin: 0 auto 24px;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .gn-halloween__button {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.button_text_color }};
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .gn-halloween__button:hover {
    transform: translateY(-2px);
  }
  #shopify-section-{{ section.id }} .gn-halloween__fall {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .gn-halloween__item {
    position: absolute;
    top: -12%;
    line-height: 1;
    opacity: 0.9;
    animation: gn-halloween-fall linear infinite;
  }
  #shopify-section-{{ section.id }} .gn-halloween__deals {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 20px;
    max-width: 980px;
    margin: 40px auto 0;
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 220px;
    max-width: 300px;
    padding: 28px 18px 22px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  #shopify-section-{{ section.id }} a.gn-halloween__deal:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.14);
  }
  #shopify-section-{{ section.id }} .gn-halloween__badge {
    position: absolute;
    top: -12px;
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.button_text_color }};
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-img {
    width: auto;
    max-width: 100%;
    height: 130px;
    object-fit: contain;
    margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-sub {
    margin-top: 4px;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 12px;
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-sale {
    font-size: 1.6rem;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-halloween__deal-was {
    font-size: 1rem;
    opacity: 0.7;
  }
  @keyframes gn-halloween-fall {
    0%   { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(calc(100% + 140px)) rotate(360deg); }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gn-halloween__heading { font-size: 2rem; }
    #shopify-section-{{ section.id }} .gn-halloween__text { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .gn-halloween__item { animation: none; top: 10%; }
  }
</style>

<div class="gn-halloween">
  {%- if section.settings.show_falling -%}
    {%- assign icons = section.settings.icons | split: ',' -%}
    <div class="gn-halloween__fall" aria-hidden="true">
      {%- for i in (1..section.settings.item_count) -%}
        {%- assign idx = forloop.index0 | modulo: icons.size -%}
        <span
          class="gn-halloween__item"
          style="left: {{ forloop.index0 | times: 37 | modulo: 100 }}%; font-size: {{ forloop.index0 | modulo: 4 | times: 6 | plus: 20 }}px; animation-duration: {{ forloop.index0 | modulo: 5 | times: 2 | plus: 9 }}s; animation-delay: -{{ forloop.index0 | times: 1.7 }}s;"
        >{{ icons[idx] | strip }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="gn-halloween__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gn-halloween__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gn-halloween__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="gn-halloween__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="gn-halloween__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="gn-halloween__deals">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign title = block.settings.title | default: p.title -%}
        {%- assign img = block.settings.image | default: p.featured_image -%}
        {%- assign link = block.settings.link | default: p.url -%}
        {%- assign sale = block.settings.sale_price -%}
        {%- assign was = block.settings.original_price -%}
        {%- if sale == blank and p != blank -%}
          {%- assign sale = p.price | money -%}
          {%- if p.compare_at_price > p.price -%}
            {%- assign was = p.compare_at_price | money -%}
          {%- endif -%}
        {%- endif -%}
        {%- assign badge = block.settings.badge -%}
        {%- if badge == blank and p != blank and p.compare_at_price > p.price -%}
          {%- assign saved = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
          {%- assign badge = 'Save ' | append: saved | append: '%' -%}
        {%- endif -%}
        {%- if link != blank -%}<a href="{{ link }}" class="gn-halloween__deal" {{ block.shopify_attributes }}>{%- else -%}<div class="gn-halloween__deal" {{ block.shopify_attributes }}>{%- endif -%}
          {%- if badge != blank -%}<span class="gn-halloween__badge">{{ badge }}</span>{%- endif -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px', class: 'gn-halloween__deal-img', alt: title }}
          {%- endif -%}
          <span class="gn-halloween__deal-title">{{ title }}</span>
          {%- if block.settings.subtitle != blank -%}
            <span class="gn-halloween__deal-sub">{{ block.settings.subtitle }}</span>
          {%- endif -%}
          {%- if sale != blank -%}
            <span class="gn-halloween__deal-price">
              <span class="gn-halloween__deal-sale">{{ sale }}</span>
              {%- if was != blank -%}<s class="gn-halloween__deal-was">{{ was }}</s>{%- endif -%}
            </span>
          {%- endif -%}
        {%- if link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Halloween celebration",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Halloween Sale" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spooky season savings" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Treat your game to something special. Limited-time Halloween offers on our training aids." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Falling decorations" },
    { "type": "checkbox", "id": "show_falling", "label": "Show falling decorations", "default": true },
    { "type": "text", "id": "icons", "label": "Decorations (comma separated emoji)", "default": "🎃,🦇,👻,🕸️" },
    { "type": "range", "id": "item_count", "min": 4, "max": 30, "step": 1, "label": "Number of decorations", "default": 14 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#1b1230" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#e6dff2" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#ec7901" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Bundle / deal",
      "settings": [
        { "type": "product", "id": "product", "label": "Bundle product", "info": "Price, sale price, image and link come from the product. Set a compare-at price on it to show the discount." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "e.g. LINK ONE + ARC ONE + TRACE ONE" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "text", "id": "badge", "label": "Badge override", "info": "Defaults to Save X% when the product has a compare-at price." },
        { "type": "header", "content": "Manual prices (only if no product is selected)" },
        { "type": "text", "id": "sale_price", "label": "Sale price", "info": "e.g. €149" },
        { "type": "text", "id": "original_price", "label": "Original price", "info": "e.g. €199" }
      ]
    }
  ],
  "presets": [
    { "name": "Halloween celebration" }
  ]
}
{% endschema %}
