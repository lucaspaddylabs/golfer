      <div class="gn-click__page">
        <div class="gn-click__section-head">
          {% if section.settings.faq_kicker != blank %}
            <p class="gn-click__section-kicker">{{ section.settings.faq_kicker }}</p>
          {% endif %}
          <h2>{{ section.settings.faq_heading }}</h2>
        </div>
        <div class="gn-click__faq">
          {% for block in faq_blocks %}
            <div class="gn-click__faq-item" {{ block.shopify_attributes }}>
              <button
                class="gn-click__faq-button"
                type="button"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="gn-click-faq-{{ section.id }}-{{ block.id }}"
                data-gn-click-faq
              >
                <span>{{ block.settings.question }}</span>
                <span class="gn-click__faq-icon" aria-hidden="true">{% if forloop.first %}-{% else %}+{% endif %}</span>
              </button>
              <div
                id="gn-click-faq-{{ section.id }}-{{ block.id }}"
                class="gn-click__faq-panel"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {{ block.settings.answer }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_sticky_cta %}
    <div class="gn-click__sticky" data-gn-click-sticky>
      <div>
        <strong>{{ section.settings.sticky_heading }}</strong>
        <span>{{ section.settings.sticky_copy }}</span>
      </div>
      <a class="gn-click__button" href="{{ primary_cta_url }}">{{ section.settings.sticky_cta_text }}</a>
    </div>
  {% endif %}

  <script>
    (function () {
      var root = document.getElementById('gn-click-test-{{ section.id }}');
      if (!root) return;

      root.querySelectorAll('[data-gn-click-faq]').forEach(function (button) {
        button.addEventListener('click', function () {
          var panel = document.getElementById(button.getAttribute('aria-controls'));
          var icon = button.querySelector('.gn-click__faq-icon');
          var expanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          if (panel) panel.hidden = expanded;
          if (icon) icon.textContent = expanded ? '+' : '-';
        });
      });

      root.querySelectorAll('[data-gn-diagnosis]').forEach(function (module) {
        var choices = module.querySelectorAll('[data-gn-diagnosis-choice]');
        var results = module.querySelectorAll('[data-gn-diagnosis-result]');
        choices.forEach(function (choice) {
          choice.addEventListener('click', function () {
            var target = choice.getAttribute('data-gn-diagnosis-choice');
            choices.forEach(function (item) {
              item.setAttribute('aria-pressed', item === choice ? 'true' : 'false');
            });
            results.forEach(function (result) {
              result.classList.toggle('is-active', result.getAttribute('data-gn-diagnosis-result') === target);
            });
          });
        });
      });

      var sticky = root.querySelector('[data-gn-click-sticky]');
      var hero = root.querySelector('[data-gn-click-hero]');
      if (sticky && hero && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          sticky.classList.toggle('is-visible', !entries[0].isIntersecting);
        }, { threshold: 0 });
        observer.observe(hero);
      } else if (sticky) {
        sticky.classList.add('is-visible');
      }
    })();
  </script>
</section>

