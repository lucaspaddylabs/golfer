            <div class="gn-click__card" {{ block.shopify_attributes }}>
              {% if block.settings.kicker != blank %}
                <p class="gn-click__card-kicker">{{ block.settings.kicker }}</p>
              {% endif %}
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.copy }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
