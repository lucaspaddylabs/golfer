<style>
  #shopify-section-{{ section.id }} .gn-golf-feed {
    background: {{ section.settings.background_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 50 }}px 32px {{ section.settings.padding_bottom | default: 60 }}px;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__wrap {
    max-width: 1400px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__heading {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.3rem;
    line-height: 1.35;
    font-weight: 500;
    color: {{ section.settings.heading_color | default: '#464646' }};
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__nav {
    display: flex;
    gap: 10px;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 8px;
    background: {{ section.settings.accent_color | default: '#1d3d2a' }};
    color: #ffffff;
    cursor: pointer;
    transition: opacity 0.2s ease;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__arrow:hover {
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__arrow svg {
    width: 18px;
    height: 18px;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__track {
    display: flex;
    align-items: stretch;
    gap: 6px;
    height: {{ section.settings.card_height | default: 520 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__card {
    position: relative;
    flex: 1 1 0%;
    min-width: 0;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: {{ section.settings.divider_color | default: '#e8e9e6' }};
    transition: flex-grow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__card.is-active {
    flex-grow: {{ section.settings.expand_ratio | default: 3 }};
    cursor: default;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__image {
    position: absolute;
    inset: 0;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 24px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.75) 100%);
    color: {{ section.settings.card_text_color | default: '#ffffff' }};
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__card.is-active .gn-golf-feed__overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__title {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 700;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__title a {
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .gn-golf-feed__desc {
    margin: 0;
    max-width: 480px;
    font-size: 0.92rem;
    line-height: 1.4;
    opacity: 0.85;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .gn-golf-feed__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .gn-golf-feed__track {
      height: {{ section.settings.card_height | default: 520 | times: 0.65 }}px;
    }
    #shopify-section-{{ section.id }} .gn-golf-feed__title {
      font-size: 1.2rem;
    }
    #shopify-section-{{ section.id }} .gn-golf-feed__desc {
      font-size: 0.85rem;
    }
  }
</style>

<div class="gn-golf-feed">
  <div class="gn-golf-feed__wrap">
    <div class="gn-golf-feed__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="gn-golf-feed__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="gn-golf-feed__nav">
        <button type="button" class="gn-golf-feed__arrow" data-direction="prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        </button>
        <button type="button" class="gn-golf-feed__arrow" data-direction="next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="gn-golf-feed__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="gn-golf-feed__card{% if forloop.index0 == 0 %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="gn-golf-feed__image">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
            <div class="gn-golf-feed__overlay">
              {%- if block.settings.title != blank -%}
                <h3 class="gn-golf-feed__title">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                  {%- else -%}
                    {{ block.settings.title }}
                  {%- endif -%}
                </h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="gn-golf-feed__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;
  var feed = section.querySelector('.gn-golf-feed');
  if (!feed) return;
  var cards = Array.prototype.slice.call(feed.querySelectorAll('.gn-golf-feed__card'));
  var total = cards.length;
  if (!total) return;
  var activeIndex = 0;

  function setActive(index) {
    activeIndex = (index + total) % total;
    cards.forEach(function (card, i) {
      card.classList.toggle('is-active', i === activeIndex);
    });
  }

  var arrows = feed.querySelectorAll('.gn-golf-feed__arrow');
  for (var a = 0; a < arrows.length; a++) {
    arrows[a].addEventListener('click', function (e) {
      var dir = e.currentTarget.getAttribute('data-direction') === 'next' ? 1 : -1;
      setActive(activeIndex + dir);
    });
  }

  cards.forEach(function (card, i) {
    card.addEventListener('click', function (e) {
      if (i !== activeIndex) {
        e.preventDefault();
        setActive(i);
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Golf content feed",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Stay up-to-date with everything about golf and better practice." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#464646" },
    { "type": "color", "id": "card_text_color", "label": "Card text color (title & description)", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Arrow button color", "default": "#1d3d2a" },
    { "type": "color", "id": "divider_color", "label": "Card placeholder color", "default": "#e8e9e6" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_height", "min": 320, "max": 700, "step": 10, "unit": "px", "label": "Card height", "default": 520 },
    { "type": "range", "id": "expand_ratio", "min": 2, "max": 6, "step": 0.5, "label": "Expanded card width ratio", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Article title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Short teaser description." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Golf content feed",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "The Best Part of Golf Isn't the Score",
            "description": "Why the moments between shots often matter more than the number on the card."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Building a Pre-Round Routine That Actually Works",
            "description": "Five minutes at the mat can change your entire round."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Why Clean Clubs Change Your Contact",
            "description": "A dirty face costs you more spin and distance than you think."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Practice Reps vs. Real Rounds: What Actually Transfers",
            "description": "The drills that translate to the course, and the ones that don't."
          }
        }
      ]
    }
  ]
}
{% endschema %}
