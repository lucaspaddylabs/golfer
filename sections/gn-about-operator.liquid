<style>
  #shopify-section-{{ section.id }} .gn-operator {
    background: {{ section.settings.page_background }};
    padding: {{ section.settings.padding_top }}px 32px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .gn-operator__panel {
    max-width: 960px;
    margin: 0 auto;
    padding: 48px clamp(24px, 5vw, 64px);
    border-radius: 18px;
    background: {{ section.settings.panel_color }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .gn-operator__eyebrow {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-operator__heading {
    margin: 0 0 18px;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .gn-operator__body p {
    margin: 0 0 14px;
    font-size: 1rem;
    line-height: 1.65;
  }
  #shopify-section-{{ section.id }} .gn-operator__body a {
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-operator__button {
    display: inline-block;
    margin-top: 10px;
    padding: 13px 30px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    background: {{ section.settings.accent_color }};
    color: {{ section.settings.button_text_color }};
  }
</style>

<div class="gn-operator">
  <div class="gn-operator__panel">
    {%- if section.settings.eyebrow != blank -%}<p class="gn-operator__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="gn-operator__heading">{{ section.settings.heading }}</h2>
    <div class="gn-operator__body">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="gn-operator__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About operator",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Transparency" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who operates Golfer Now" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Golfer Now is operated by <strong>Zinetic LLC</strong>. Zinetic LLC also operates a network of subscription-based websites. Golfer Now is its online store for golf and outdoor products, run as a separate shop with its own catalogue, pricing and customer service.</p><p>We want you to know exactly who you are buying from. If you have any questions about Golfer Now, Zinetic LLC or how the two relate, please get in touch and we will be happy to explain.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "page_background", "label": "Section background", "default": "#f7f5ef" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#1d3d2a" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#e6ebe7" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ec7901" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "About operator" }]
}
{% endschema %}
