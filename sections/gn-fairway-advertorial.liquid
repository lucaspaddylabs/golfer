<script>
  /* Affise param tagging */
  (function(){
    var MAP = {fbclid:'fbclid', utm_campaign:'sub1', utm_term:'sub2', utm_content:'sub3'};
    var HOST = 'clicks.metricszoom.com';
    var KEY = 'gn_affise_params';
    var vals = {};
    try { vals = JSON.parse(sessionStorage.getItem(KEY) || '{}'); } catch(e) {}
    var q = new URLSearchParams(location.search);
    for (var k in MAP) { if (q.get(k)) vals[k] = q.get(k); }
    try { sessionStorage.setItem(KEY, JSON.stringify(vals)); } catch(e) {}
    function tag(href){
      try {
        var u = new URL(href, location.href);
        if (u.hostname !== HOST) return href;
        for (var k in MAP) { if (vals[k]) u.searchParams.set(MAP[k], vals[k]); }
        return u.toString();
      } catch(e) { return href; }
    }
    function run(){
      document.querySelectorAll('a[href*="' + HOST + '"]').forEach(function(a){ a.href = tag(a.href); });
    }
    document.addEventListener('click', function(ev){
      var a = ev.target && ev.target.closest ? ev.target.closest('a[href*="' + HOST + '"]') : null;
      if (a) a.href = tag(a.href);
    }, true);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
    window.addEventListener('load', run);
  })();

  /* Progress bar, sticky CTA, countdown */
  (function(){
    var root = document.querySelector('[data-gn-fairway]');
    if (!root) return;
    var bar = root.querySelector('.progress');
    var fcta = root.querySelector('.fcta');
    var timerEl = root.querySelector('[data-gn-timer]');
    var closeBtn = root.querySelector('.fcta-close');
    var showAfter = parseInt(fcta.getAttribute('data-show-after'), 10);
    if (isNaN(showAfter)) showAfter = 400;
    var dismissed = false;

    function onScroll(){
      var doc = document.documentElement;
      var y = window.pageYOffset || doc.scrollTop || 0;
      var max = (doc.scrollHeight - window.innerHeight) || 1;
      bar.style.width = Math.min(100, Math.max(0, (y / max) * 100)) + '%';
      if (!dismissed) fcta.classList.toggle('visible', y > showAfter);
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', onScroll);
    onScroll();

    if (closeBtn) closeBtn.addEventListener('click', function(){
      dismissed = true;
      fcta.classList.remove('visible');
    });

    /* Countdown to offer end (local time). Accepts "YYYY-MM-DDTHH:MM[:SS]" */
    var raw = (fcta.getAttribute('data-offer-end') || '').trim();
    var m = raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s](\d{2}):(\d{2})(?::(\d{2}))?)?$/);
    var end = m
      ? new Date(+m[1], +m[2] - 1, +m[3], +(m[4] || 23), +(m[5] || 59), +(m[6] || 59)).getTime()
      : new Date(2026, 10, 30, 23, 59, 59).getTime();

    function pad(n){ return n < 10 ? '0' + n : '' + n; }
    function tick(){
      if (!timerEl) return;
      var diff = end - Date.now();
      if (diff <= 0) { timerEl.textContent = '00:00:00'; return; }
      var s = Math.floor(diff / 1000);
      var d = Math.floor(s / 86400); s -= d * 86400;
      var h = Math.floor(s / 3600); s -= h * 3600;
      var mi = Math.floor(s / 60); s -= mi * 60;
      timerEl.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(mi) + ':' + pad(s);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

