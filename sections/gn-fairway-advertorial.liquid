{%- comment -%}
  GN Fairway Advertorial
  Golf-reviews.com style advertorial for Golfer Now / ARC ONE.
  Self-contained: fonts, CSS, markup and JS (Affise param tagging, sticky CTA, countdown, progress bar).
{%- endcomment -%}

{%- liquid
  assign cta_url = section.settings.cta_url | default: 'https://clicks.metricszoom.com/click?pid=51&offer_id=381'

  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 1600
  else
    assign hero_src = section.settings.hero_image_url
  endif

  assign use_schematic = section.settings.use_schematic
  if section.settings.spec_image != blank
    assign spec_src = section.settings.spec_image | image_url: width: 1200
    assign use_schematic = false
  elsif section.settings.spec_image_url != blank
    assign spec_src = section.settings.spec_image_url
  else
    assign spec_src = blank
  endif

  if section.settings.figure_image != blank
    assign figure_src = section.settings.figure_image | image_url: width: 1600
  else
    assign figure_src = section.settings.figure_image_url
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#f5f1ea;--paper:#fbf8f2;--ink:#14201a;--ink-2:#3a4a42;--muted:#6b7a72;
    --rule:#d9d2c4;--green:#1d3b2a;--green-2:#24513a;--accent:#c8862a;--accent-2:#8d3b2a;
    --maxw:720px;
    --font-serif:"Source Serif 4", Georgia, "Times New Roman", serif;
    --font-sans: Inter, system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  /* Hide theme chrome */
  .shopify-section-group-header-group,
  #shopify-section-header,
  #shopify-section-announcement-bar,
  .shopify-section-header,
  .announcement-bar-section,
  sticky-header,
  header-component,
  .shopify-section-group-footer-group,
  #shopify-section-footer,
  footer.footer,
  .gn-footer-main,
  [id*="gn_footer"],
  [id*="footer_sticky"] {
    display: none !important;
  }

  body:has(.review){background:var(--bg)}

  /* Defensive resets so theme styles don't leak in */
  .review,.review *,.review *::before,.review *::after{box-sizing:border-box}
  .review img{max-width:100%}
  .review h1,.review h2,.review h3,.review h4{text-transform:none}
  .review a{text-decoration:none}
  .review .body a{text-decoration:underline}
  .review .masthead-logo{text-decoration:underline;text-underline-offset:3px}

  /* ===== Reference CSS (golf-reviews.com) ===== */
  .review{font-family:var(--font-serif);font-optical-sizing:auto;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;text-rendering:optimizelegibility;font-size:18px;line-height:1.65}
  .review .masthead{border-bottom:1px solid var(--rule);background:var(--paper)}
  .review .masthead-inner{max-width:1100px;font-family:var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2);justify-content:space-between;align-items:center;margin:0 auto;padding:14px 24px;font-size:12px;display:flex}
  .review .masthead-logo{font-family:var(--font-serif);letter-spacing:-.01em;text-transform:none;color:var(--ink);font-size:22px;font-style:italic;font-weight:700}
  .review .masthead-nav{gap:22px;display:flex}
  .review .masthead-nav a{color:var(--ink-2);text-decoration:none}
  .review .masthead-nav a:hover{color:var(--ink)}
  .review .masthead-meta{color:var(--muted);font-size:11px}
  @media (max-width:720px){.review .masthead-nav{display:none}}
  .review article{max-width:var(--maxw);margin:0 auto;padding:48px 24px 160px}
  @media (max-width:640px){.review article{padding:28px 20px 180px}.review{font-size:17px}}
  .review .eyebrow{font-family:var(--font-sans);letter-spacing:.16em;text-transform:uppercase;color:var(--accent-2);align-items:center;gap:10px;margin:0 0 18px;font-size:12px;font-weight:600;display:flex}
  .review .eyebrow:before{content:"";background:var(--accent-2);width:28px;height:2px;display:inline-block}
  .review h1.deck{font-family:var(--font-serif);letter-spacing:-.02em;text-wrap:balance;margin:0 0 22px;font-size:clamp(34px,5.2vw,54px);font-weight:700;line-height:1.04}
  .review h1.deck em{color:var(--green);font-style:italic}
  .review .standfirst{color:var(--ink-2);text-wrap:pretty;max-width:58ch;margin:0 0 28px;font-size:clamp(18px,2.1vw,22px);line-height:1.5}
  .review .byline{border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);font-family:var(--font-sans);color:var(--ink-2);align-items:center;gap:14px;margin-bottom:36px;padding:18px 0;font-size:13px;display:flex}
  .review .byline .avatar{width:40px;height:40px;box-shadow:inset 0 0 0 2px var(--paper);background:radial-gradient(circle at 30% 30%,#6b8a76,#1d3b2a 70%);border-radius:50%;flex-shrink:0}
  .review .byline .who{color:var(--ink);font-weight:600}
  .review .byline .dot{color:var(--rule)}
  .review .hero{margin:0 -24px 36px;position:relative}
  @media (min-width:720px){.review .hero{margin:0 0 40px}}
  .review .hero-img{aspect-ratio:1;object-fit:contain;background:#0c1a14;width:100%;display:block}
  @media (min-width:720px){.review .hero-img{aspect-ratio:16/10;object-fit:cover;object-position:center 38%;border-radius:4px}}
  .review .hero-caption{font-family:var(--font-sans);color:var(--muted);justify-content:space-between;gap:16px;padding:10px 24px 0;font-size:12px;display:flex}
  @media (min-width:720px){.review .hero-caption{padding:10px 0 0}}
  .review .hero-caption span:last-child{text-transform:uppercase;letter-spacing:.08em}
  .review .body p{text-wrap:pretty;margin:0 0 22px}
  .review .body>p:first-of-type:first-letter{font-family:var(--font-serif);float:left;color:var(--green);padding:6px 10px 0 0;font-size:68px;font-weight:700;line-height:.85}
  .review .body h2{font-family:var(--font-serif);letter-spacing:-.01em;text-wrap:balance;margin:48px 0 18px;font-size:clamp(24px,3vw,30px);font-weight:700;line-height:1.2}
  .review .body h2 .num{font-family:var(--font-mono);color:var(--accent);vertical-align:.3em;letter-spacing:.02em;margin-right:10px;font-size:.55em;font-weight:500;display:inline-block}
  .review .body a{color:var(--green)}
  .review blockquote{border-left:3px solid var(--green);color:var(--ink);text-wrap:balance;margin:32px 0;padding:4px 0 4px 22px;font-size:22px;font-style:italic;line-height:1.4}
  .review blockquote cite{font-style:normal;font-family:var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:10px;font-size:12px;display:block}
  .review .pull{background:var(--paper);border:1px solid var(--rule);border-radius:2px;margin:40px -8px;padding:28px 24px 28px 52px;position:relative}
  .review .pull:before{content:"“";font-family:var(--font-serif);color:var(--green);font-size:84px;line-height:1;position:absolute;top:-8px;left:14px}
  .review .pull p{font-family:var(--font-serif);color:var(--ink);margin:0;font-size:22px;font-style:italic;line-height:1.4}
  .review figure{margin:36px -24px}
  @media (min-width:720px){.review figure{margin:36px 0}}
  .review figure img{background:#111;width:100%;display:block}
  @media (min-width:720px){.review figure img{border-radius:4px}}
  .review figcaption{font-family:var(--font-sans);color:var(--muted);justify-content:space-between;gap:16px;padding:10px 24px 0;font-size:12px;display:flex}
  @media (min-width:720px){.review figcaption{padding:10px 0 0}}
  .review .stat-row{border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);grid-template-columns:repeat(3,1fr);gap:0;margin:36px 0;display:grid}
  .review .stat{text-align:center;border-right:1px solid var(--rule);padding:22px 16px}
  .review .stat:last-child{border-right:0}
  .review .stat-num{font-family:var(--font-serif);letter-spacing:-.02em;color:var(--green);font-size:clamp(32px,5vw,44px);font-weight:700;line-height:1}
  .review .stat-label{font-family:var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:8px;font-size:11px}
  @media (max-width:520px){.review .stat-row{grid-template-columns:1fr}.review .stat{border-right:0;border-bottom:1px solid var(--rule)}.review .stat:last-child{border-bottom:0}}
  .review .inline-tag{font-family:var(--font-sans);letter-spacing:.1em;text-transform:uppercase;background:var(--green);color:#e9f0ea;vertical-align:2px;border-radius:2px;margin:0 4px;padding:4px 10px;font-size:11px;font-weight:600;display:inline-block}
  .review .spec-strip{background:var(--green);color:#eef2ed;grid-template-columns:1.3fr 1fr;gap:0;margin:36px -24px;display:grid;overflow:hidden}
  @media (min-width:720px){.review .spec-strip{border-radius:4px;margin:36px 0}}
  @media (max-width:640px){.review .spec-strip{grid-template-columns:1fr}}
  .review .spec-strip .photo{aspect-ratio:4/3;background:linear-gradient(135deg,#00000040,#0000 60%),repeating-linear-gradient(45deg,#0f2419 0 16px,#13291d 16px 32px);position:relative;overflow:hidden}
  .review .spec-strip .photo svg{width:100%;height:100%;position:absolute;inset:0}
  .review .spec-strip .meta{flex-direction:column;justify-content:center;gap:18px;padding:28px 26px;display:flex}
  .review .spec-strip .tag{font-family:var(--font-sans);letter-spacing:.14em;text-transform:uppercase;color:#c8d6cc;font-size:11px}
  .review .spec-strip .title{font-family:var(--font-serif);letter-spacing:-.01em;text-wrap:balance;font-size:26px;font-weight:700;line-height:1.2}
  .review .spec-list{gap:10px;display:grid}
  .review .spec-list .row{font-family:var(--font-sans);border-top:1px solid #ffffff24;grid-template-columns:110px 1fr;padding:10px 0;font-size:13px;display:grid}
  .review .spec-list .row .k{color:#a6b8ae;letter-spacing:.08em;text-transform:uppercase;font-size:11px}
  .review .spec-list .row .v{color:#eef2ed}
  .review .testi-wrap{background:var(--paper);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);margin:44px -24px;padding:30px 24px}
  @media (min-width:720px){.review .testi-wrap{border:1px solid var(--rule);border-radius:4px;margin:44px 0}}
  .review .testi-head{font-family:var(--font-sans);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);align-items:center;gap:10px;margin-bottom:18px;font-size:11px;display:flex}
  .review .testi-head:before{content:"";background:var(--rule);width:24px;height:1px}
  .review .testi-grid{grid-template-columns:1fr 1fr;gap:22px 28px;display:grid}
  @media (max-width:560px){.review .testi-grid{grid-template-columns:1fr}}
  .review .testi{font-family:var(--font-serif)}
  .review .testi p{text-wrap:pretty;margin:0 0 10px;font-size:17px;line-height:1.5}
  .review .testi .who{font-family:var(--font-sans);color:var(--muted);letter-spacing:.04em;font-size:12px}
  .review .stars{color:var(--accent);letter-spacing:2px;margin-bottom:6px;font-size:13px;display:block}
  .review .compare{background:var(--paper);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);grid-template-columns:1fr 1fr;margin:36px -24px;display:grid}
  @media (min-width:720px){.review .compare{border:1px solid var(--rule);border-radius:4px;margin:36px 0}}
  .review .compare .col{padding:22px 22px 24px}
  .review .compare .col.before{border-right:1px solid var(--rule)}
  .review .compare .tag{font-family:var(--font-sans);letter-spacing:.14em;text-transform:uppercase;border-radius:2px;margin-bottom:14px;padding:4px 8px;font-size:10px;font-weight:700;display:inline-block}
  .review .tag.bad{color:#8d3b2a;background:#f3e1dd}
  .review .tag.good{color:#1d3b2a;background:#dde9df}
  .review .compare h4{font-family:var(--font-serif);margin:0 0 10px;font-size:18px;font-weight:700;line-height:1.25}
  .review .compare ul{font-family:var(--font-sans);color:var(--ink-2);margin:0;padding:0;font-size:14px;line-height:1.55;list-style:none}
  .review .compare li{padding:6px 0 6px 22px;position:relative}
  .review .compare li:before{font-family:var(--font-sans);font-size:13px;font-weight:700;position:absolute;top:6px;left:0}
  .review .compare .bad li:before{content:"—";color:#8d3b2a}
  .review .compare .good li:before{content:"✓";color:#1d3b2a}
  .review .cta-inline{background:var(--ink);color:#f5f1ea;border-radius:4px;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px;margin:32px 0;padding:24px;display:flex}
  .review .cta-inline .label{font-family:var(--font-serif);text-wrap:pretty;max-width:34ch;font-size:18px;line-height:1.35}
  .review .cta-inline .label b{color:var(--accent);font-weight:600}
  .review .cta-inline a{font-family:var(--font-sans);letter-spacing:.06em;background:var(--accent);color:var(--ink);white-space:nowrap;border-radius:2px;padding:12px 18px;font-size:13px;font-weight:600;text-decoration:none;transition:transform .15s,background .15s}
  .review .cta-inline a:hover{background:#e09a34;transform:translateY(-1px)}
  .review .trust{font-family:var(--font-sans);color:var(--muted);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);flex-wrap:wrap;align-items:center;gap:10px 16px;margin:28px 0;padding:14px 0;font-size:12px;display:flex}
  .review .trust .badge{align-items:center;gap:6px;display:inline-flex}
  .review .trust .dot{background:var(--green);border-radius:50%;width:6px;height:6px}
  .review .kicker{background:var(--green);color:#e9efe9;border-radius:4px;margin:56px 0 0;padding:28px 24px}
  .review .kicker h3{font-family:var(--font-serif);text-wrap:balance;margin:0 0 10px;font-size:24px;font-weight:700;line-height:1.2}
  .review .kicker p{color:#c7d2c8;margin:0 0 16px;font-size:16px;line-height:1.55}
  .review .kicker a.primary{background:var(--accent);color:var(--ink);font-family:var(--font-sans);letter-spacing:.06em;border-radius:2px;padding:14px 22px;font-size:13px;font-weight:600;text-decoration:none;display:inline-block}
  .review .kicker .micro{font-family:var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:#8ea395;margin-top:12px;font-size:11px;display:block}
  .review footer.article-foot{max-width:var(--maxw);border-top:1px solid var(--rule);font-family:var(--font-sans);color:var(--muted);flex-wrap:wrap;justify-content:space-between;gap:24px;margin:0 auto;padding:40px 24px 120px;font-size:12px;display:flex}
  .review footer.article-foot .disc{max-width:60ch;line-height:1.6}
  .review .fcta{z-index:90;padding:10px env(safe-area-inset-right) calc(10px + env(safe-area-inset-bottom)) env(safe-area-inset-left);pointer-events:none;background:linear-gradient(#14201a00,#14201afa 40%);transition:transform .4s cubic-bezier(.2,.7,.2,1);position:fixed;bottom:0;left:0;right:0;transform:translateY(calc(100% + 40px))}
  .review .fcta.visible{transform:translateY(0)}
  .review .fcta-inner{pointer-events:auto;color:#f5f1ea;background:#14201a;border:1px solid #2a3a31;border-radius:10px;align-items:center;gap:16px;max-width:860px;margin:0 auto;padding:16px 20px 16px 22px;display:flex;box-shadow:0 18px 40px -14px #00000073,inset 0 2px #ffffff0a}
  .review .fcta-pulse{background:#6ee08a;border-radius:50%;flex-shrink:0;width:12px;height:12px;animation:1.8s infinite gnfw-pulse;box-shadow:0 0 #6ee08aa6}
  @keyframes gnfw-pulse{0%{box-shadow:0 0 #6ee08a8c}70%{box-shadow:0 0 0 10px #6ee08a00}to{box-shadow:0 0 #6ee08a00}}
  .review .fcta-copy{min-width:0;font-family:var(--font-sans);flex:1;line-height:1.25}
  .review .fcta-head{color:#f5f1ea;white-space:nowrap;text-overflow:ellipsis;font-size:17px;font-weight:600;overflow:hidden}
  .review .fcta-sub{color:#a6b8ae;letter-spacing:.04em;white-space:nowrap;text-overflow:ellipsis;margin-top:3px;font-size:13px;overflow:hidden}
  .review .fcta-sub .strike{color:#6b7a72;margin-right:6px;text-decoration:line-through}
  .review .fcta-sub b{color:#f3c46a;font-weight:600}
  .review .fcta-btn{font-family:var(--font-sans);letter-spacing:.03em;background:var(--accent);color:#14201a;white-space:nowrap;border:0;border-radius:9px;align-items:center;gap:8px;padding:15px 24px;font-size:15px;font-weight:700;text-decoration:none;transition:transform .15s,background .15s,box-shadow .15s;display:inline-flex;box-shadow:0 6px 16px -4px #c8862a80}
  .review .fcta-btn:hover{background:#e09a34;transform:translateY(-1px)}
  .review .fcta-btn svg{width:16px;height:16px}
  .review .fcta-close{color:#6b7a72;cursor:pointer;background:0 0;border:0;border-radius:6px;padding:6px;line-height:0}
  .review .fcta-close:hover{color:#c7d2c8;background:#ffffff0a}
  .review .fcta-timer{font-family:var(--font-mono);color:#f3c46a;font-size:13px}
  @media (max-width:600px){.review .fcta-inner{border-radius:12px;gap:10px;padding:14px 12px 14px 14px}.review .fcta-head{white-space:normal;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:13px;line-height:1.2;display:-webkit-box}.review .fcta-sub{white-space:normal;text-overflow:clip;font-size:10px;overflow:visible}.review .fcta-timer{font-size:10px}.review .fcta-btn{border-radius:8px;padding:14px;font-size:12px}.review .fcta-close{display:none}}
  .review .progress{background:var(--green);z-index:100;width:0%;height:2px;transition:width .12s linear;position:fixed;top:0;left:0}
  .review .fcta.style-pill .fcta-inner{border-radius:999px;padding:8px 8px 8px 18px}
  .review .fcta.style-pill .fcta-btn{border-radius:999px}
  @media (min-width:900px){.review .fcta.style-side{background:0 0;max-width:340px;padding:0;bottom:24px;left:auto;right:24px;transform:translate(calc(100% + 40px))}.review .fcta.style-side.visible{transform:translate(0)}.review .fcta.style-side .fcta-inner{border-radius:14px;flex-direction:column;align-items:stretch;gap:12px;padding:18px}.review .fcta.style-side .fcta-copy{order:1}.review .fcta.style-side .fcta-pulse{order:0;align-self:flex-start}.review .fcta.style-side .fcta-btn{order:2;justify-content:center;padding:14px 18px}.review .fcta.style-side .fcta-close{position:absolute;top:10px;right:10px}}

  /* ===== Golfer Now additions ===== */
  .review .kicker .bf-tag{display:inline-block;background:var(--accent);color:var(--ink);font-family:var(--font-sans);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;padding:4px 8px;border-radius:2px;margin-bottom:14px}
  .review .kicker .price-rows{margin:4px 0 22px}
  .review .kicker .price-row{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #ffffff24;padding:10px 0;font-family:var(--font-sans);font-size:14px}
  .review .kicker .price-row:last-child{border-bottom:1px solid #ffffff24}
  .review .kicker .price-row .amt{text-align:right}
  .review .kicker .price-row .amt strong{color:#fff;font-weight:700;margin-right:4px}
  .review .kicker .price-row .was{color:#9FB0A5;text-decoration:line-through}
  .review .kicker .price-row .save{color:#9FB0A5}
  .review .kicker .price-row.featured{color:#E0B062;font-weight:600}
  .review .kicker .trust{border-color:#ffffff24;color:#a9bbb0;margin:22px 0 0;padding:14px 0 0;border-bottom:0}
  .review .kicker .trust .dot{background:var(--accent)}
  .review .kicker .trust b{color:#e9efe9;font-weight:600}
  .review .kicker a.primary{text-align:center}
  @media (max-width:520px){
    .review .kicker a.primary{display:block}
    .review .kicker .price-row{flex-direction:column;gap:2px}
    .review .kicker .price-row .amt{text-align:left}
  }
  .review .trust .stars-inline{color:var(--accent);letter-spacing:2px;font-size:13px}
  .review .trust .rated b{color:var(--ink);font-weight:600}
  .review .trust .quote-note{font-family:var(--font-serif);font-style:italic;font-size:13px;color:var(--ink-2)}
  .review .trust .check{color:#2F7A3F;font-weight:700}
  .review .spec-strip .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:18px;background:transparent}
  .review .pull cite{display:block;margin-top:12px;font-family:var(--font-sans);font-style:normal;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .review .masthead-logo{color:var(--ink)}
</style>

<div class="review" data-gn-fairway>
  <div class="progress" aria-hidden="true"></div>

  <header class="masthead">
    <div class="masthead-inner">
      <a class="masthead-logo" href="/">{{ section.settings.brand_name | default: 'Golfer Now' }}</a>
      {%- if section.settings.masthead_meta != blank -%}
        <span class="masthead-meta">{{ section.settings.masthead_meta }}</span>
      {%- endif -%}
    </div>
  </header>

  <article>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="deck">{{ section.settings.headline }}</h1>
    <p class="standfirst">{{ section.settings.standfirst }}</p>

    <div class="byline">
