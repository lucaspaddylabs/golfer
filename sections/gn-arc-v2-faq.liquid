{%- liquid
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
-%}
<style>
  .gn-v2f {
    --gn-bg: #F5F1E8;
    --gn-card: #FFFFFF;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-mid: #3A8A5B;
    --gn-border: #E8E2D4;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2f *, .gn-v2f *::before, .gn-v2f *::after { box-sizing: border-box; }
  .gn-v2f__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2f__layout { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px; align-items: start; }
  .gn-v2f__head { position: sticky; top: 24px; max-width: 460px; }
  .gn-v2f__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; margin: 24px 0 0; padding: 0 24px; border-radius: 12px;
    border: 1.5px solid var(--gn-green); color: var(--gn-green); background: transparent;
    font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none; transition: background 0.15s ease, color 0.15s ease;
  }
  .gn-v2f__btn:hover { background: var(--gn-green); color: #F5F1E8; }
  .gn-v2f__eyebrow { margin: 0 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2f__heading { margin: 0 0 12px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }
  .gn-v2f__copy { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--gn-muted); }
  .gn-v2f__stack { display: grid; gap: 12px; min-width: 0; }
  .gn-v2f__item { border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-card); overflow: hidden; }
  .gn-v2f__item[open] { background: #fff; border-color: var(--gn-green); }
  .gn-v2f__q {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; cursor: pointer; list-style: none;
    font-size: 1.02rem; font-weight: 800; line-height: 1.3;
  }
  .gn-v2f__q::-webkit-details-marker { display: none; }
  .gn-v2f__q:focus-visible { outline: 2px solid var(--gn-mid); outline-offset: -2px; border-radius: 16px; }
  .gn-v2f__icon { position: relative; flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%; background: var(--gn-green); }
  .gn-v2f__icon::before, .gn-v2f__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 10px; height: 2px; background: #F5F1E8; transform: translate(-50%, -50%); transition: transform 0.2s ease; }
  .gn-v2f__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .gn-v2f__item[open] .gn-v2f__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .gn-v2f__a { padding: 0 22px 20px; font-size: 0.98rem; line-height: 1.55; color: var(--gn-muted); }
  .gn-v2f__a p { margin: 0 0 10px; }
  .gn-v2f__a p:last-child { margin-bottom: 0; }
  @media (max-width: 860px) {
    .gn-v2f__inner { padding: 0 16px; }
    .gn-v2f__layout { grid-template-columns: 1fr; gap: 28px; }
    .gn-v2f__head { position: static; max-width: none; }
    .gn-v2f__q { padding: 16px 18px; }
    .gn-v2f__a { padding: 0 18px 18px; }
  }
  @media (max-width: 749px) {
    .gn-v2f { padding-top: 40px !important; padding-bottom: 40px !important; }
  }
  @media (prefers-reduced-motion: reduce) { .gn-v2f__icon::before, .gn-v2f__icon::after { transition: none; } }
</style>

<section
  class="gn-v2f"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-green: {{ section.settings.accent_color }};
    --gn-mid: {{ section.settings.highlight_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2f__inner">
    <div class="gn-v2f__layout">
      <div class="gn-v2f__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gn-v2f__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="gn-v2f__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.copy != blank -%}
          <p class="gn-v2f__copy">{{ section.settings.copy }}</p>
        {%- endif -%}
        {%- if section.settings.contact_url != blank -%}
          <a class="gn-v2f__btn" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label | default: 'Contact us' }}</a>
        {%- endif -%}
      </div>

      <div class="gn-v2f__stack">
        {%- for block in faq_blocks -%}
          <details class="gn-v2f__item" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
            <summary class="gn-v2f__q"><span>{{ block.settings.question }}</span><span class="gn-v2f__icon" aria-hidden="true"></span></summary>
            <div class="gn-v2f__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 FAQ",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight answers." },
    { "type": "textarea", "id": "copy", "label": "Intro", "default": "Still wondering about something? Email us and a real person will answer." },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact us" },
    { "type": "url", "id": "contact_url", "label": "Contact button link", "info": "Optional. The button only shows when a link is set." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F1E8" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#0B1C12" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4B5A50" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1D3D2A" },
    { "type": "color", "id": "highlight_color", "label": "Highlight green", "default": "#3A8A5B" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8E2D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What does ARC ONE Swing Trainer do?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>A weight inside the shaft clicks when your wrists let go. That tells you when it happened on a practice swing.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What does ARC ONE Swing Trainer do?", "answer": "<p>A weight inside the shaft clicks when your wrists let go. That tells you when it happened on a practice swing.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do I need a ball or a net?", "answer": "<p>No. It is built for dry swings. No ball, net, or app.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I use it indoors?", "answer": "<p>Yes, if you have room to swing safely. Start with half swings.</p>" } },
        { "type": "faq_item", "settings": { "question": "Does it come in a left-handed version?", "answer": "<p>Yes. Pick right-handed or left-handed at the top of the page.</p>" } },
        { "type": "faq_item", "settings": { "question": "Will it fit in my golf bag?", "answer": "<p>Yes. It collapses to about 15.3 inches and extends to 26.5 inches.</p>" } },
        { "type": "faq_item", "settings": { "question": "How fast will I see a difference?", "answer": "<p>It depends on you. One customer told us their contact felt cleaner at the range after less than a week of daily use. Results vary.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do I need LINK ONE or LINE ONE too?", "answer": "<p>No. ARC ONE Swing Trainer works on its own. LINK ONE Training Belt and LINE ONE Putting Tutor are add-ons for connection and putting.</p>" } },
        { "type": "faq_item", "settings": { "question": "What if it is not for me?", "answer": "<p>Send it back within 30 days. Shipping is free on orders over $50 and we ship worldwide.</p>" } }
      ]
    }
  ]
}
{% endschema %}
