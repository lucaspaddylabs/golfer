{% comment %}
  Golfer Now homepage hero — Fairway variant.
  Replaces the old "Play better, faster" slider slide.
  Background defaults to theme asset hero-golfer-fairway.png so it ships with the theme.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Will you keep muddling along as a golfer, or is it time to improve?'
  assign support = section.settings.support | default: 'Golf training essentials so you can get serious from today.'
  assign button_label = section.settings.button_label | default: 'Shop the system'
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url

  if section.settings.image != blank
    assign hero_img = section.settings.image | image_url: width: 2400
    assign hero_img_alt = section.settings.image.alt | default: heading
  else
    assign hero_img = 'hero-golfer-fairway.png' | asset_url
    assign hero_img_alt = 'Golfer on the fairway at golden hour'
  endif

  assign heading_html = heading | escape
-%}

<style>
  #theme-section-{{ section.id }} {
    --gn-hero-ink: {{ section.settings.button_color }};
    --gn-hero-min-h-desktop: {{ section.settings.min_height_desktop }}px;
    --gn-hero-min-h-mobile: {{ section.settings.min_height_mobile }}px;
  }

  #theme-section-{{ section.id }} .gn-home-hero {
    position: relative;
    overflow: hidden;
    /* Grow gently with width, then cap — avoids a sudden crop/lighting jump */
    min-height: clamp(var(--gn-hero-min-h-desktop), 45vw, 740px);
    background: #122018;
    color: #fff;
  }

  #theme-section-{{ section.id }} .gn-home-hero__media {
    position: absolute;
    inset: 0;
  }

  #theme-section-{{ section.id }} .gn-home-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bias upward so the golfer's head stays in frame when cover crops */
    object-position: {{ section.settings.image_position_desktop }};
    display: block;
  }

  #theme-section-{{ section.id }} .gn-home-hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Left read shade + soft top-right veil so the sun flare stays even across widths */
    background:
      linear-gradient(
        100deg,
        rgba(12, 22, 14, 0.58) 0%,
        rgba(12, 22, 14, 0.30) 42%,
        rgba(12, 22, 14, 0.10) 68%,
        rgba(12, 22, 14, 0.06) 100%
      ),
      radial-gradient(
        ellipse 75% 55% at 88% 8%,
        rgba(12, 22, 14, 0.42) 0%,
        rgba(12, 22, 14, 0.16) 42%,
        transparent 72%
      );
  }

  #theme-section-{{ section.id }} .gn-home-hero__content {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(var(--gn-hero-min-h-desktop), 45vw, 740px);
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    /* Extra left inset on wide so the stack sits in the left-center, not the edge */
    padding:
      clamp(48px, 8vh, 88px)
      clamp(48px, 5vw, 96px)
      clamp(48px, 8vh, 88px)
      clamp(64px, 9vw, 180px);
  }

  /* Copy column sized for a natural 3–4 line headline, not a skinny left strip */
  #theme-section-{{ section.id }} .gn-home-hero__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(100%, 36rem);
    max-width: 100%;
  }

  #theme-section-{{ section.id }} .gn-home-hero__heading {
    margin: 0 0 16px;
    font-family: var(--font-body-family), Inter, sans-serif;
    font-weight: 700;
    font-size: clamp(1.55rem, 2.2vw + 0.55rem, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-transform: none;
    color: #fff;
    text-wrap: balance;
  }

  #theme-section-{{ section.id }} .gn-home-hero__support {
    margin: 0 0 26px;
    /* Let it use the full stack width so it stays one line under the headline */
    max-width: none;
    font-family: var(--font-body-family), Inter, sans-serif;
    font-weight: 500;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
    text-wrap: pretty;
  }

  #theme-section-{{ section.id }} .gn-home-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 50px;
    padding: 0 36px;
    border: 2px solid #ffffff;
    border-radius: 8px;
    background: #ffffff;
    color: var(--gn-hero-ink);
    font-family: var(--font-body-family), Inter, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  #theme-section-{{ section.id }} .gn-home-hero__cta:hover {
    background: #f3f1ea;
    color: var(--gn-hero-ink);
    border-color: #ffffff;
  }

  @media (max-width: 749px) {
    #theme-section-{{ section.id }} .gn-home-hero {
      min-height: var(--gn-hero-min-h-mobile);
    }

    #theme-section-{{ section.id }} .gn-home-hero__media img {
      object-position: {{ section.settings.image_position_mobile }};
    }

    #theme-section-{{ section.id }} .gn-home-hero__shade {
      background: linear-gradient(
        180deg,
        rgba(12, 22, 14, 0.18) 0%,
        rgba(12, 22, 14, 0.52) 42%,
        rgba(12, 22, 14, 0.82) 100%
      );
    }

    #theme-section-{{ section.id }} .gn-home-hero__content {
      min-height: var(--gn-hero-min-h-mobile);
      justify-content: flex-end;
      align-items: stretch;
      max-width: none;
      margin-inline: 0;
      padding: 32px max(24px, 7%) 40px;
    }

    #theme-section-{{ section.id }} .gn-home-hero__stack {
      width: 100%;
      align-items: stretch;
    }

    #theme-section-{{ section.id }} .gn-home-hero__heading {
      font-size: clamp(1.45rem, 6.2vw, 1.9rem);
    }

    #theme-section-{{ section.id }} .gn-home-hero__support {
      max-width: none;
    }

    #theme-section-{{ section.id }} .gn-home-hero__cta {
      align-self: center;
      width: min(100%, 320px);
      min-height: 54px;
      margin-top: 4px;
    }
  }
</style>

<div id="theme-section-{{ section.id }}" class="gn-home-hero-section">
  <section class="gn-home-hero" aria-label="{{ heading | escape }}">
    <div class="gn-home-hero__media">
      <img
        src="{{ hero_img }}"
        alt="{{ hero_img_alt | escape }}"
        width="1942"
        height="809"
        loading="eager"
        fetchpriority="high"
      >
    </div>
    <div class="gn-home-hero__shade" aria-hidden="true"></div>
    <div class="gn-home-hero__content">
      <div class="gn-home-hero__stack">
        <h1 class="gn-home-hero__heading">{{ heading_html }}</h1>
        {%- if support != blank -%}
          <p class="gn-home-hero__support">{{ support | escape | replace: 'get serious from today', 'get&nbsp;serious&nbsp;from&nbsp;today' }}</p>
        {%- endif -%}
        {%- if button_label != blank -%}
          <a class="gn-home-hero__cta" href="{{ button_link }}">{{ button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "GN Homepage hero",
  "tag": "section",
  "class": "section-gn-homepage-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. If empty, uses the Fairway theme asset."
    },
    {
      "type": "text",
      "id": "image_position_desktop",
      "label": "Image position (desktop)",
      "default": "58% 22%",
      "info": "X% Y%. ~55–62% X keeps the golfer nearer the copy on wide screens."
    },
    {
      "type": "text",
      "id": "image_position_mobile",
      "label": "Image position (mobile)",
      "default": "78% 28%"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Will you keep muddling along as a golfer, or is it time to improve?"
    },
    {
      "type": "textarea",
      "id": "support",
      "label": "Support text",
      "default": "Golf training essentials so you can get serious from today."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the system"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#1d3d2a"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 420,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Min height (desktop)",
      "default": 620
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 420,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Min height (mobile)",
      "default": 560
    }
  ],
  "presets": [
    {
      "name": "GN Homepage hero"
    }
  ]
}
{% endschema %}
