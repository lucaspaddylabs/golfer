<style>
  .gn-v2c {
    --gn-bg: #173122;
    --gn-ink: #F5F1E8;
    --gn-muted: #9CCFB0;
    --gn-panel: #0F2418;
    --gn-sub: #1D3D2A;
    --gn-mint: #9CCFB0;
    --gn-orange: #E8863A;
    --gn-gold: #C9A249;
    --gn-border: rgba(156, 207, 176, 0.22);
    --gn-early: 25%;
    --gn-through: 75%;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2c *, .gn-v2c *::before, .gn-v2c *::after { box-sizing: border-box; }
  .gn-v2c__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2c__layout { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: center; }
  .gn-v2c__head { max-width: 460px; }
  .gn-v2c__eyebrow { margin: 0 0 10px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mint); }
  .gn-v2c__heading { margin: 0 0 16px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.04; font-weight: 800; letter-spacing: -0.025em; color: var(--gn-ink); }
  .gn-v2c__copy { margin: 0; font-size: 1.05rem; line-height: 1.55; color: rgba(245, 241, 232, 0.8); }

  .gn-v2c__card { padding: 28px 28px 24px; border-radius: 20px; background: var(--gn-panel); border: 1px solid var(--gn-border); }
  .gn-v2c__labels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); text-align: center; margin: 0 0 14px; }
  .gn-v2c__label { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(245, 241, 232, 0.6); }
  .gn-v2c__label.is-impact { color: var(--gn-ink); }

  .gn-v2c__track { position: relative; height: 96px; }
  .gn-v2c__line { position: absolute; left: 12.5%; right: 12.5%; top: 28px; height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--gn-orange) 0%, var(--gn-gold) 45%, var(--gn-mint) 100%); opacity: 0.9; }
  .gn-v2c__tick { position: absolute; top: 30px; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--gn-panel); border: 2px solid rgba(245, 241, 232, 0.55); }
  .gn-v2c__ball { position: absolute; left: 62.5%; top: 4px; bottom: 0; width: 0; border-left: 2px dashed rgba(245, 241, 232, 0.55); }
  .gn-v2c__ball span { position: absolute; left: 0; bottom: 0; transform: translateX(-50%); padding: 3px 10px; border-radius: 999px; background: var(--gn-ink); color: var(--gn-panel); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.14em; line-height: 1.2; }
  .gn-v2c__marker { position: absolute; top: 30px; width: 26px; height: 26px; margin: -13px 0 0 -13px; border-radius: 50%; border: 3px solid var(--gn-panel); }
  .gn-v2c__marker--early { left: var(--gn-early); background: var(--gn-orange); box-shadow: 0 0 0 6px rgba(232, 134, 58, 0.22); }
  .gn-v2c__marker--through { left: var(--gn-through); background: var(--gn-mint); box-shadow: 0 0 0 6px rgba(156, 207, 176, 0.22); }
  .gn-v2c__marker-tag { position: absolute; top: 54px; transform: translateX(-50%); white-space: nowrap; font-size: 0.74rem; font-weight: 800; line-height: 1.2; }
  .gn-v2c__marker-tag--early { left: var(--gn-early); color: var(--gn-orange); }
  .gn-v2c__marker-tag--through { left: var(--gn-through); color: var(--gn-mint); }

  .gn-v2c__subs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 16px; }
  .gn-v2c__sub { padding: 22px 22px 24px; border-radius: 16px; background: var(--gn-sub); border: 1px solid var(--gn-border); border-top: 3px solid var(--gn-mint); }
  .gn-v2c__sub[data-tone="early"] { border-top-color: var(--gn-orange); }
  .gn-v2c__sub-dot { display: inline-block; width: 10px; height: 10px; margin: 0 8px 0 0; border-radius: 50%; background: var(--gn-mint); }
  .gn-v2c__sub[data-tone="early"] .gn-v2c__sub-dot { background: var(--gn-orange); }
  .gn-v2c__sub-title { display: flex; align-items: center; margin: 0 0 8px; font-size: 1.12rem; font-weight: 800; line-height: 1.2; color: var(--gn-mint); }
  .gn-v2c__sub[data-tone="early"] .gn-v2c__sub-title { color: var(--gn-orange); }
  .gn-v2c__sub-text { margin: 0; font-size: 0.95rem; line-height: 1.5; color: rgba(245, 241, 232, 0.82); }

  @media (max-width: 860px) {
    .gn-v2c__inner { padding: 0 16px; }
    .gn-v2c__layout { grid-template-columns: 1fr; gap: 32px; }
    .gn-v2c__head { max-width: none; }
    .gn-v2c__card { padding: 22px 14px 18px; }
    .gn-v2c__label { font-size: 0.58rem; letter-spacing: 0.08em; }
    .gn-v2c__marker-tag { font-size: 0.66rem; }
    .gn-v2c__subs { grid-template-columns: 1fr; }
  }
</style>

<section
  class="gn-v2c"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-ink: {{ section.settings.text_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-panel: {{ section.settings.panel_color }};
    --gn-sub: {{ section.settings.sub_color }};
    --gn-mint: {{ section.settings.mint_color }};
    --gn-orange: {{ section.settings.early_color }};
    --gn-gold: {{ section.settings.gold_color }};
    --gn-early: {{ section.settings.early_position }}%;
    --gn-through: {{ section.settings.through_position }}%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2c__inner">
    <div class="gn-v2c__layout">
      <div class="gn-v2c__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gn-v2c__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="gn-v2c__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.copy != blank -%}
          <p class="gn-v2c__copy">{{ section.settings.copy }}</p>
        {%- endif -%}
      </div>

      <div class="gn-v2c__right">
        <div class="gn-v2c__card" role="img" aria-label="{{ section.settings.label_1 }}, {{ section.settings.label_2 }}, {{ section.settings.label_3 }}, {{ section.settings.label_4 }}: an early click lands between top and downswing, a good click lands through the ball.">
          <div class="gn-v2c__labels" aria-hidden="true">
            <span class="gn-v2c__label">{{ section.settings.label_1 }}</span>
            <span class="gn-v2c__label">{{ section.settings.label_2 }}</span>
            <span class="gn-v2c__label is-impact">{{ section.settings.label_3 }}</span>
            <span class="gn-v2c__label">{{ section.settings.label_4 }}</span>
          </div>
          <div class="gn-v2c__track" aria-hidden="true">
            <span class="gn-v2c__line"></span>
            <span class="gn-v2c__tick" style="left: 12.5%"></span>
            <span class="gn-v2c__tick" style="left: 37.5%"></span>
            <span class="gn-v2c__tick" style="left: 62.5%"></span>
            <span class="gn-v2c__tick" style="left: 87.5%"></span>
            <span class="gn-v2c__ball"><span>{{ section.settings.ball_label }}</span></span>
            <span class="gn-v2c__marker gn-v2c__marker--early"></span>
            <span class="gn-v2c__marker gn-v2c__marker--through"></span>
            {%- if section.settings.early_tag != blank -%}
              <span class="gn-v2c__marker-tag gn-v2c__marker-tag--early">{{ section.settings.early_tag }}</span>
            {%- endif -%}
            {%- if section.settings.through_tag != blank -%}
              <span class="gn-v2c__marker-tag gn-v2c__marker-tag--through">{{ section.settings.through_tag }}</span>
            {%- endif -%}
          </div>
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="gn-v2c__subs">
            {%- for block in section.blocks -%}
              <div class="gn-v2c__sub" data-tone="{{ block.settings.tone }}" {{ block.shopify_attributes }}>
                <h3 class="gn-v2c__sub-title"><span class="gn-v2c__sub-dot" aria-hidden="true"></span>{{ block.settings.title }}</h3>
                <p class="gn-v2c__sub-text">{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 Click meaning",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT THE CLICK MEANS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The click is your coach." },
    { "type": "textarea", "id": "copy", "label": "Paragraph", "default": "There's a weight inside the shaft. When your wrists let go, you hear a click. That tells you when it happened — no video to watch, no number to read." },
    { "type": "header", "content": "Timeline" },
    { "type": "text", "id": "label_1", "label": "Label 1", "default": "TOP" },
    { "type": "text", "id": "label_2", "label": "Label 2", "default": "DOWNSWING" },
    { "type": "text", "id": "label_3", "label": "Label 3 (impact)", "default": "IMPACT" },
    { "type": "text", "id": "label_4", "label": "Label 4", "default": "FINISH" },
    { "type": "text", "id": "ball_label", "label": "Ball line label", "default": "BALL" },
    { "type": "text", "id": "early_tag", "label": "Early marker tag", "default": "Early click" },
    { "type": "text", "id": "through_tag", "label": "Click-through marker tag", "default": "Click through" },
    { "type": "range", "id": "early_position", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Early marker position", "default": 25 },
    { "type": "range", "id": "through_position", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Click-through marker position", "default": 75 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#173122" },
    { "type": "color", "id": "panel_color", "label": "Timeline card", "default": "#0F2418" },
    { "type": "color", "id": "sub_color", "label": "Sub cards", "default": "#1D3D2A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F1E8" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#9CCFB0" },
    { "type": "color", "id": "mint_color", "label": "Mint (click through)", "default": "#9CCFB0" },
    { "type": "color", "id": "early_color", "label": "Orange (early click)", "default": "#E8863A" },
    { "type": "color", "id": "gold_color", "label": "Gold (track)", "default": "#C9A249" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "marker",
      "name": "Click card",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Early click" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "You're letting go near the top. The clubhead passes your hands before impact — weak, high, and short." },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "early", "label": "Early (orange)" },
            { "value": "target", "label": "Click through (mint)" }
          ],
          "default": "early"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Click meaning",
      "blocks": [
        { "type": "marker", "settings": { "title": "Early click", "text": "You're letting go near the top. The clubhead passes your hands before impact — weak, high, and short.", "tone": "early" } },
        { "type": "marker", "settings": { "title": "Click near the ball", "text": "Your wrists hold on longer. Contact feels more solid, and you have a clearer target to practice toward.", "tone": "target" } }
      ]
    }
  ]
}
{% endschema %}
