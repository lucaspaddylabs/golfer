<style>
  .gn-v2c {
    --gn-bg: #0B1C12;
    --gn-ink: #F5F1E8;
    --gn-muted: #9CCFB0;
    --gn-panel: #173122;
    --gn-green: #1D3D2A;
    --gn-mid: #3A8A5B;
    --gn-mint: #9CCFB0;
    --gn-pale: #DDEFE3;
    --gn-gold: #C9A249;
    --gn-border: rgba(156, 207, 176, 0.22);
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2c *, .gn-v2c *::before, .gn-v2c *::after { box-sizing: border-box; }
  .gn-v2c__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2c__layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 64px; align-items: center; }
  .gn-v2c__head { max-width: 520px; margin: 0; }
  .gn-v2c__eyebrow { margin: 0 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-gold); }
  .gn-v2c__heading { margin: 0 0 12px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; color: var(--gn-ink); }
  .gn-v2c__copy { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--gn-muted); }
  .gn-v2c__timeline { position: relative; display: grid; grid-template-columns: 1fr; gap: 20px; }
  .gn-v2c__timeline::before {
    content: ""; position: absolute; left: 27px; top: 28px; bottom: 28px; width: 3px; border-radius: 3px;
    background: linear-gradient(180deg, var(--gn-gold) 0%, var(--gn-mint) 100%); opacity: 0.8;
  }
  .gn-v2c__step { position: relative; min-width: 0; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 20px; align-items: start; }
  .gn-v2c__node {
    position: relative; z-index: 1; width: 56px; height: 56px; border-radius: 50%;
    background: var(--gn-bg); border: 3px solid var(--gn-gold); color: var(--gn-gold);
    display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800; margin: 0;
  }
  .gn-v2c__step[data-tone="mid"] .gn-v2c__node { border-color: #b9c27a; color: #b9c27a; }
  .gn-v2c__step[data-tone="target"] .gn-v2c__node { background: var(--gn-mint); border-color: var(--gn-mint); color: var(--gn-bg); box-shadow: 0 0 0 8px rgba(156, 207, 176, 0.18); }
  .gn-v2c__card { padding: 22px; border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-panel); }
  .gn-v2c__step[data-tone="target"] .gn-v2c__card { border-color: var(--gn-mint); background: #1D3D2A; }
  .gn-v2c__when { margin: 0 0 6px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gn-gold); }
  .gn-v2c__step[data-tone="target"] .gn-v2c__when { color: var(--gn-mint); }
  .gn-v2c__title { margin: 0 0 8px; font-size: 1.25rem; font-weight: 800; line-height: 1.2; color: var(--gn-ink); }
  .gn-v2c__text { margin: 0; font-size: 0.98rem; line-height: 1.5; color: rgba(245, 241, 232, 0.8); }
  .gn-v2c__fix { margin: 14px 0 0; padding-top: 14px; border-top: 1px solid var(--gn-border); font-size: 0.92rem; font-weight: 700; line-height: 1.4; color: var(--gn-pale); }
  .gn-v2c__fix span { color: var(--gn-gold); text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.12em; margin-right: 6px; }
  .gn-v2c__step[data-tone="target"] .gn-v2c__fix span { color: var(--gn-mint); }
  .gn-v2c__foot { margin: 28px 0 0; padding: 20px 24px; border: 1px solid var(--gn-border); border-radius: 16px; background: rgba(23, 49, 34, 0.6); font-size: 1.05rem; font-weight: 600; line-height: 1.45; color: var(--gn-pale); }
  @media (max-width: 860px) {
    .gn-v2c__inner { padding: 0 16px; }
    .gn-v2c__layout { grid-template-columns: 1fr; gap: 32px; }
    .gn-v2c__head { max-width: none; }
    .gn-v2c__step { gap: 16px; }
  }
</style>

<section
  class="gn-v2c"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-ink: {{ section.settings.text_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-panel: {{ section.settings.panel_color }};
    --gn-mint: {{ section.settings.mint_color }};
    --gn-gold: {{ section.settings.gold_color }};
    --gn-count: {{ section.blocks.size | at_least: 1 }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2c__inner">
    <div class="gn-v2c__layout">
    <div class="gn-v2c__left">
      <div class="gn-v2c__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gn-v2c__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="gn-v2c__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.copy != blank -%}
          <p class="gn-v2c__copy">{{ section.settings.copy }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.footer_text != blank -%}
        <p class="gn-v2c__foot">{{ section.settings.footer_text }}</p>
      {%- endif -%}
    </div>

    <ol class="gn-v2c__timeline" style="list-style:none;margin:0;padding:0">
      {%- for block in section.blocks -%}
        <li class="gn-v2c__step" data-tone="{{ block.settings.tone }}" {{ block.shopify_attributes }}>
          <span class="gn-v2c__node" aria-hidden="true">{{ forloop.index }}</span>
          <div class="gn-v2c__card">
            {%- if block.settings.when != blank -%}
              <p class="gn-v2c__when">{{ block.settings.when }}</p>
            {%- endif -%}
            <h3 class="gn-v2c__title">{{ block.settings.title }}</h3>
            <p class="gn-v2c__text">{{ block.settings.text }}</p>
            {%- if block.settings.fix != blank -%}
              <p class="gn-v2c__fix"><span>{{ block.settings.fix_label }}</span>{{ block.settings.fix }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 Click meaning",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What the click means" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear it. Then fix it." },
    { "type": "textarea", "id": "copy", "label": "Intro", "default": "ARC ONE Swing Trainer clicks the moment you release the club. Where the click lands in your swing tells you what your hands are doing." },
    { "type": "text", "id": "footer_text", "label": "Footer line", "default": "Rule of thumb: the later the click, the better. Move it toward impact and keep it there." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0B1C12" },
    { "type": "color", "id": "panel_color", "label": "Card", "default": "#173122" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F1E8" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#9CCFB0" },
    { "type": "color", "id": "mint_color", "label": "Mint (target)", "default": "#9CCFB0" },
    { "type": "color", "id": "gold_color", "label": "Gold (early)", "default": "#C9A249" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "marker",
      "name": "Click point",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "when", "label": "When it clicks", "default": "Near the top" },
        { "type": "text", "id": "title", "label": "Title", "default": "Early click" },
        { "type": "textarea", "id": "text", "label": "What it means", "default": "You are letting go too soon. The speed is gone before the ball." },
        { "type": "text", "id": "fix_label", "label": "Fix label", "default": "Fix" },
        { "type": "text", "id": "fix", "label": "Fix", "default": "Hold the angle a beat longer." },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "options": [
            { "value": "early", "label": "Early (gold)" },
            { "value": "mid", "label": "Getting there" },
            { "value": "target", "label": "Target (green)" }
          ],
          "default": "early"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Click meaning",
      "blocks": [
        { "type": "marker", "settings": { "when": "Near the top", "title": "Early click", "text": "You are letting go too soon. The speed is gone before the ball.", "fix_label": "Fix", "fix": "Hold the angle a beat longer.", "tone": "early" } },
        { "type": "marker", "settings": { "when": "Halfway down", "title": "Getting closer", "text": "Better, but you are still releasing before you need to.", "fix_label": "Fix", "fix": "Let the hands trail the body into the downswing.", "tone": "mid" } },
        { "type": "marker", "settings": { "when": "Near impact", "title": "Late click", "text": "This is the timing to keep. You held on and let go at the ball.", "fix_label": "Keep", "fix": "Repeat it until it feels boring.", "tone": "target" } }
      ]
    }
  ]
}
{% endschema %}
