<style>
  #shopify-section-{{ section.id }} .gn-values {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 32px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .gn-values__heading {
    margin: 0 auto 44px;
    max-width: 700px;
    text-align: center;
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .gn-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-values__card {
    padding: 32px 26px;
    border-radius: 14px;
    background: {{ section.settings.card_color }};
    border-top: 3px solid {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-values__number {
    margin: 0 0 10px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-values__title {
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .gn-values__text {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: {{ section.settings.text_color }};
  }
</style>

<div class="gn-values">
  {%- if section.settings.heading != blank -%}
    <h2 class="gn-values__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="gn-values__grid">
    {%- for block in section.blocks -%}
      <div class="gn-values__card" {{ block.shopify_attributes }}>
        <p class="gn-values__number">{{ forloop.index | prepend: '0' }}</p>
        <h3 class="gn-values__title">{{ block.settings.title }}</h3>
        <p class="gn-values__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "About values",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#e8e9e6" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5c5c56" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ec7901" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Top padding", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Bottom padding", "default": 70 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Simple tools" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Easy-to-use training aids that anyone can pick up and use." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }]
    }
  ]
}
{% endschema %}
