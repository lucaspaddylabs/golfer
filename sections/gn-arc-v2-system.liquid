<style>
  .gn-v2s {
    --gn-bg: #F5F1E8;
    --gn-card: #FFFFFF;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-forest: #173122;
    --gn-mid: #3A8A5B;
    --gn-mint: #9CCFB0;
    --gn-pale: #DDEFE3;
    --gn-gold: #C9A249;
    --gn-border: #E8E2D4;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2s *, .gn-v2s *::before, .gn-v2s *::after { box-sizing: border-box; }
  .gn-v2s__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2s__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 48px; margin: 0 0 36px; }
  .gn-v2s__head-main { max-width: 640px; }
  .gn-v2s__head .gn-v2s__copy { max-width: 42ch; text-align: right; }
  .gn-v2s__head .gn-v2s__heading { margin-bottom: 0; }
  .gn-v2s__eyebrow { margin: 0 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2s__heading { margin: 0 0 12px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }
  .gn-v2s__copy { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--gn-muted); }
  .gn-v2s__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .gn-v2s__card {
    position: relative; display: flex; flex-direction: column; min-width: 0;
    background: var(--gn-card); border: 1px solid var(--gn-border); border-radius: 16px; overflow: hidden;
    color: inherit; text-decoration: none; transition: transform 0.15s ease, border-color 0.15s ease;
  }
  a.gn-v2s__card:hover { transform: translateY(-3px); border-color: var(--gn-mid); }
  .gn-v2s__card.is-current { border: 2px solid var(--gn-forest); }
  .gn-v2s__media { aspect-ratio: 220 / 200; background: #F5F1E8; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--gn-border); }
  .gn-v2s__media img { width: 100%; height: 100%; object-fit: contain; padding: 18px; display: block; }
  .gn-v2s__num { position: absolute; top: 12px; left: 12px; z-index: 2; padding: 5px 9px; border-radius: 999px; background: var(--gn-card); color: var(--gn-green); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; line-height: 1; }
  .gn-v2s__card.is-current .gn-v2s__num { background: rgba(255,255,255,0.92); color: var(--gn-forest); }
  .gn-v2s__here-badge {
    position: absolute; top: 12px; right: 12px; z-index: 2;
    padding: 7px 12px; border-radius: 999px; background: var(--gn-forest); color: #fff;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.04em; line-height: 1;
  }
  .gn-v2s__body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .gn-v2s__name { margin: 0; font-size: 1.05rem; font-weight: 800; line-height: 1.2; }
  .gn-v2s__covers { margin: 0; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2s__text { margin: 0; font-size: 0.92rem; line-height: 1.45; color: var(--gn-muted); }
  .gn-v2s__price { margin: 2px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: 1rem; font-weight: 800; line-height: 1.2; color: var(--gn-ink); }
  .gn-v2s__price-was { font-size: 0.85rem; font-weight: 600; color: var(--gn-muted); text-decoration: line-through; }
  .gn-v2s__foot { margin-top: auto; padding-top: 10px; display: flex; justify-content: flex-end; align-items: center; font-size: 0.9rem; font-weight: 800; }
  .gn-v2s__add {
    width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--gn-border);
    display: inline-flex; align-items: center; justify-content: center; color: var(--gn-green); font-size: 1.2rem; line-height: 1;
    padding: 0; background: #fff; cursor: pointer; font-family: inherit;
  }
  .gn-v2s__add:hover { border-color: var(--gn-green); background: var(--gn-pale); }
  .gn-v2s__add[disabled] { opacity: 0.45; cursor: default; }
  .gn-v2s__add.is-added { background: var(--gn-forest); color: #fff; border-color: var(--gn-forest); }
  .gn-v2s__here {
    width: 32px; height: 32px; border-radius: 50%; background: var(--gn-forest); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .gn-v2s__here svg { width: 14px; height: 14px; display: block; }
  .gn-v2s__banner {
    margin-top: 20px; padding: 28px 32px; border-radius: 16px; background: var(--gn-forest); color: #F5F1E8;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px;
  }
  .gn-v2s__banner-title { margin: 0 0 4px; font-size: clamp(1.25rem, 2.2vw, 1.6rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
  .gn-v2s__banner-text { margin: 0; max-width: 56ch; font-size: 0.98rem; line-height: 1.45; color: var(--gn-mint); }
  .gn-v2s__banner-side { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .gn-v2s__banner-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
  .gn-v2s__banner-now { font-size: 2rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; }
  .gn-v2s__banner-was { font-size: 1.05rem; color: var(--gn-mint); text-decoration: line-through; }
  .gn-v2s__banner-save { padding: 5px 10px; border-radius: 999px; background: var(--gn-gold); color: var(--gn-ink); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1; }
  .gn-v2s__banner-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border: 0; border-radius: 12px;
    background: #fff; color: var(--gn-ink); font-size: 0.9rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none; cursor: pointer;
  }
  .gn-v2s__banner-btn:hover { filter: brightness(0.96); }
  .gn-v2s__banner-btn[disabled], .gn-v2s__banner-btn[aria-disabled="true"] { opacity: 0.55; cursor: not-allowed; }
  .gn-v2s__banner-btn .gn-v2s__spinner {
    width: 16px; height: 16px; border: 2px solid rgba(11, 28, 18, 0.2); border-top-color: var(--gn-ink); border-radius: 50%;
    animation: gn-v2s-spin 700ms linear infinite;
  }
  .gn-v2s__banner-btn .gn-v2s__spinner[hidden] { display: none; }
  .gn-v2s__banner-error { margin: 12px 0 0; width: 100%; font-size: 0.88rem; font-weight: 600; color: #ffb4a8; }
  .gn-v2s__banner-error[hidden] { display: none; }
  @keyframes gn-v2s-spin { to { transform: rotate(360deg); } }
  @media (max-width: 1099px) and (min-width: 750px) {
    .gn-v2s__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .gn-v2s__head { gap: 12px 24px; margin-bottom: 28px; }
  }
  @media (max-width: 989px) {
    .gn-v2s__head { display: block; }
    .gn-v2s__head .gn-v2s__heading { margin-bottom: 12px; }
    .gn-v2s__head .gn-v2s__copy { max-width: none; text-align: left; }
  }
  @media (max-width: 749px) {
    .gn-v2s { padding-top: 40px !important; padding-bottom: 40px !important; }
    .gn-v2s__inner { padding: 0 16px; }
    .gn-v2s__head { margin-bottom: 20px; }
    .gn-v2s__grid {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -16px;
      padding: 0 16px 4px;
    }
    .gn-v2s__grid::-webkit-scrollbar { display: none; }
    .gn-v2s__card {
      flex: 0 0 78%;
      max-width: 300px;
      scroll-snap-align: start;
    }
    .gn-v2s__body { padding: 14px 14px 16px; }
    .gn-v2s__banner { padding: 22px 20px; margin-top: 16px; }
    .gn-v2s__banner-side { width: 100%; }
    .gn-v2s__banner-btn { width: 100%; }
  }
</style>

<section
  class="gn-v2s"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-green: {{ section.settings.accent_color }};
    --gn-forest: {{ section.settings.dark_color }};
    --gn-mid: {{ section.settings.highlight_color }};
    --gn-mint: {{ section.settings.mint_color }};
    --gn-gold: {{ section.settings.gold_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2s__inner">
    <div class="gn-v2s__head">
      <div class="gn-v2s__head-main">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gn-v2s__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="gn-v2s__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.copy != blank -%}
        <p class="gn-v2s__copy">{{ section.settings.copy }}</p>
      {%- endif -%}
    </div>

    <div class="gn-v2s__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          if card_product == blank and block.settings.handle != blank
            assign card_product = all_products[block.settings.handle]
          endif
          assign card_handle = card_product.handle | default: block.settings.handle

          assign card_price_product = card_product
          if card_price_product.title == blank and block.settings.current
            assign card_price_product = product
          endif
          assign card_price = null
          assign card_compare = 0
          assign card_variant = null
          if card_price_product.title != blank
            assign card_variant = card_price_product.selected_or_first_available_variant
            assign card_price = card_variant.price
            assign card_compare = card_variant.compare_at_price | default: 0
          endif

          assign card_image = block.settings.image
          if card_image == blank and card_product.featured_image
            assign card_image = card_product.featured_image
          endif
          assign card_fallback = null
          if card_image == blank
            case card_handle
              when 'golf-training-belt'
                assign card_fallback = 'gn-link-one-product.png'
              when 'pro-swing-click-trainer'
                assign card_fallback = 'gn-arc-one-product.png'
              when 'swing-detection-training-mat'
                assign card_fallback = 'gn-trace-one-product.png'
              when 'golf-putting-tutor'
                assign card_fallback = 'gn-line-one-product.png'
            endcase
          endif

        -%}
        <div class="gn-v2s__card{% if block.settings.current %} is-current{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}
            <span class="gn-v2s__num">{{ block.settings.number }}</span>
          {%- endif -%}
          {%- if block.settings.current -%}
            <span class="gn-v2s__here-badge">{{ block.settings.current_label }}</span>
          {%- endif -%}
          <span class="gn-v2s__media">
            {%- if card_image != blank -%}
              {{ card_image | image_url: width: 600 | image_tag: alt: block.settings.name, loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 280px, 50vw' }}
            {%- elsif card_fallback != blank -%}
              <img src="{{ card_fallback | asset_url }}" alt="{{ block.settings.name | escape }}" width="600" height="600" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="gn-v2s__body">
            <span class="gn-v2s__covers">{{ block.settings.covers }}</span>
            <span class="gn-v2s__name" style="display:block">{{ block.settings.name }}</span>
            <span class="gn-v2s__text" style="display:block">{{ block.settings.text }}</span>
            {%- if card_price != blank and section.settings.show_card_price -%}
              <span class="gn-v2s__price">
                <span class="gn-v2s__price-now">{{ card_price | money }}</span>
                {%- if card_compare > card_price -%}
                  <span class="gn-v2s__price-was">{{ card_compare | money }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="gn-v2s__foot">
              {%- if block.settings.current -%}
                <span class="gn-v2s__here" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
              {%- elsif card_variant -%}
                <button
                  class="gn-v2s__add"
                  type="button"
                  data-gn-v2s-add
                  data-variant-id="{{ card_variant.id }}"
                  aria-label="Add {{ block.settings.name | escape }} to cart"
                  {% unless card_variant.available %}disabled{% endunless %}
                >+</button>
              {%- endif -%}
            </span>
          </span>
        </div>
      {%- endfor -%}
    </div>

    {%- liquid
      assign bundle_price = 0
      assign bundle_compare = 0
      assign bundle_ok = true
      assign bundle_count = 0
      assign bundle_items_json = ''
      for block in section.blocks
        assign bp = block.settings.product
        if bp == blank and block.settings.handle != blank
          assign bp = all_products[block.settings.handle]
        endif
        if bp.title == blank and block.settings.current
          assign bp = product
        endif
        if bp.title == blank
          assign bundle_ok = false
        else
          assign bv = bp.selected_or_first_available_variant
          unless bv.available
            assign bundle_ok = false
          endunless
          assign bundle_price = bundle_price | plus: bv.price
          assign bv_cmp = bv.compare_at_price | at_least: bv.price
          assign bundle_compare = bundle_compare | plus: bv_cmp
          assign bundle_count = bundle_count | plus: 1
          if bundle_items_json != blank
            assign bundle_items_json = bundle_items_json | append: ','
          endif
          assign bundle_items_json = bundle_items_json | append: '{"id":' | append: bv.id | append: ',"quantity":1}'
        endif
      endfor

      assign save_major = section.settings.banner_save_amount | default: 30
      if save_major < 0
        assign save_major = 0
      endif
      assign save_cents = save_major | times: 100
      assign bundle_now = bundle_price | minus: save_cents
      if bundle_now < 0
        assign bundle_now = 0
      endif
      assign bundle_save = bundle_compare | minus: bundle_now
      if bundle_save < 0
        assign bundle_save = 0
      endif

      assign show_live_price = false
      if section.settings.banner_use_live_price and bundle_count > 0
        assign show_live_price = true
      endif

      assign discount_code = section.settings.banner_discount_code | strip
      assign use_atc = false
      if section.settings.banner_add_all and bundle_ok and bundle_count > 0
        assign use_atc = true
      endif
    -%}

    {%- if section.settings.banner_title != blank -%}
      <div
        class="gn-v2s__banner"
        data-gn-v2s-banner
        data-discount-code="{{ discount_code | escape }}"
        data-error="{{ section.settings.banner_error_text | escape }}"
        {% if use_atc %}data-items='[{{ bundle_items_json }}]'{% endif %}
      >
        <div>
          <p class="gn-v2s__banner-title">{{ section.settings.banner_title }}</p>
          {%- if section.settings.banner_text != blank -%}
            <p class="gn-v2s__banner-text">{{ section.settings.banner_text }}</p>
          {%- endif -%}
        </div>
        <div class="gn-v2s__banner-side">
          {%- if show_live_price -%}
            <div class="gn-v2s__banner-price">
              <span class="gn-v2s__banner-now">{{ bundle_now | money }}</span>
              {%- if bundle_compare > bundle_now -%}
                <span class="gn-v2s__banner-was">{{ bundle_compare | money }}</span>
              {%- endif -%}
              {%- if bundle_save > 0 -%}
                <span class="gn-v2s__banner-save">Save {{ bundle_save | money }}</span>
              {%- endif -%}
            </div>
          {%- elsif section.settings.banner_price != blank -%}
            <div class="gn-v2s__banner-price">
              <span class="gn-v2s__banner-now">{{ section.settings.banner_price }}</span>
              {%- if section.settings.banner_compare != blank -%}
                <span class="gn-v2s__banner-was">{{ section.settings.banner_compare }}</span>
              {%- endif -%}
              {%- if section.settings.banner_save != blank -%}
                <span class="gn-v2s__banner-save">{{ section.settings.banner_save }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.banner_button != blank -%}
            {%- if use_atc -%}
              <button class="gn-v2s__banner-btn" type="button" data-gn-v2s-atc{% unless bundle_ok %} disabled aria-disabled="true"{% endunless %}>
                <span data-gn-v2s-label>{{ section.settings.banner_button }}</span>
                <span class="gn-v2s__spinner" data-gn-v2s-spinner hidden aria-hidden="true"></span>
              </button>
            {%- else -%}
              <a class="gn-v2s__banner-btn" href="{{ section.settings.banner_url | default: '#gn-v2-buybox' }}">{{ section.settings.banner_button }}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
        <p class="gn-v2s__banner-error" data-gn-v2s-error hidden></p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if use_atc -%}
<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-gn-v2s-banner]') || document.querySelector('[data-gn-v2s-banner][data-items]');
    if (!root || root.dataset.gnBound) return;
    root.dataset.gnBound = '1';
    const btn = root.querySelector('[data-gn-v2s-atc]');
    const spinner = root.querySelector('[data-gn-v2s-spinner]');
    const errorBox = root.querySelector('[data-gn-v2s-error]');
    if (!btn) return;
    let busy = false;
    let items = [];
    try { items = JSON.parse(root.getAttribute('data-items') || '[]'); } catch (e) { items = []; }

    const showError = (msg) => {
      if (!errorBox) return;
      errorBox.textContent = msg || '';
      errorBox.hidden = !msg;
    };

    const sectionIdsFor = (cart) => {
      if (cart && typeof cart.getSectionsToRender === 'function') {
        return cart.getSectionsToRender().map((s) => s.id);
      }
      return ['cart-drawer', 'cart-icon-bubble', 'cart-icon-bubble--mobile', 'cart-free-delivery'];
    };

    const fetchCartWithSections = async (cart) => {
      const cartUrl = ((window.routes && window.routes.cart_url) || '/cart').replace(/\/$/, '') + '.js';
      const ids = sectionIdsFor(cart);
      const [cartJson, sections] = await Promise.all([
        fetch(cartUrl, { headers: { Accept: 'application/json' } }).then((r) => r.json()),
        fetch('/?sections=' + ids.join(',')).then((r) => r.json())
      ]);
      return Object.assign({}, cartJson, { sections: sections });
    };

    const applyDiscount = async (code, cart) => {
      if (!code) return null;
      const cartUrl = ((window.routes && window.routes.cart_url) || '/cart').replace(/\/$/, '') + '.js';
      const updateUrl = ((window.routes && window.routes.cart_update_url) || '/cart/update').replace(/\.js$/, '') + '.js';
      const current = await fetch(cartUrl, { headers: { Accept: 'application/json' } }).then((r) => r.json());
      const existing = (current.discount_codes || []).map((d) => d.code).filter(Boolean);
      if (existing.map((c) => c.toLowerCase()).includes(code.toLowerCase())) return null;
      const payload = {
        discount: existing.concat([code]).join(','),
        sections: sectionIdsFor(cart),
        sections_url: window.location.pathname
      };
      const res = await fetch(updateUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(payload)
      });
      return res.json();
    };

    const addAll = async () => {
      if (busy || btn.disabled || !items.length) return;
      busy = true;
      showError('');
      btn.disabled = true;
      if (spinner) spinner.hidden = false;
      const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
      const discountCode = (root.dataset.discountCode || '').trim();
      const labeled = items.map((item) => Object.assign({}, item, {
        properties: { _gn_bundle: 'Complete System' }
      }));
      const body = {
        items: labeled,
        sections: sectionIdsFor(cart),
        sections_url: window.location.pathname
      };
      const base = (window.routes && window.routes.cart_add_url) || '/cart/add';
      const url = base.replace(/\.js$/, '') + '.js';
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify(body)
        });
        const json = await res.json();
        if (!res.ok || json.status) {
          showError(json.description || json.message || root.dataset.error || 'Could not add to cart.');
          return;
        }
        if (discountCode) {
          try {
            await applyDiscount(discountCode, cart);
          } catch (err) {
            console.warn('Complete system discount could not be applied', err);
          }
        }
        const state = await fetchCartWithSections(cart);
        const first = Array.isArray(state.items) && state.items.length ? state.items[0] : {};
        Object.assign(state, { key: first.key, id: first.id });
        if (cart && typeof cart.renderContents === 'function') {
          if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);
          if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
          cart.renderContents(state);
        } else {
          window.location.href = (window.routes && window.routes.cart_url) || '/cart';
          return;
        }
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'gn-arc-v2-system', productVariantId: first.id, cartData: state });
        }
      } catch (err) {
        console.error(err);
        showError(root.dataset.error || 'Could not add to cart.');
      } finally {
        busy = false;
        btn.disabled = false;
        if (spinner) spinner.hidden = true;
      }
    };

    btn.addEventListener('click', addAll);
  })();
</script>
{%- endif -%}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.gnCardAdd === '1') return;
    section.dataset.gnCardAdd = '1';
    const buttons = [...section.querySelectorAll('[data-gn-v2s-add]')];
    if (!buttons.length) return;

    const sectionIdsFor = (cart) => {
      if (cart && typeof cart.getSectionsToRender === 'function') {
        return cart.getSectionsToRender().map((s) => s.id);
      }
      return ['cart-drawer', 'cart-icon-bubble', 'cart-icon-bubble--mobile', 'cart-free-delivery'];
    };

    const fetchCartWithSections = async (cart) => {
      const cartUrl = ((window.routes && window.routes.cart_url) || '/cart').replace(/\/$/, '') + '.js';
      const ids = sectionIdsFor(cart);
      const [cartJson, sections] = await Promise.all([
        fetch(cartUrl, { headers: { Accept: 'application/json' } }).then((r) => r.json()),
        fetch('/?sections=' + ids.join(',')).then((r) => r.json())
      ]);
      return Object.assign({}, cartJson, { sections: sections });
    };

    buttons.forEach((button) => {
      const label = button.getAttribute('aria-label') || 'Add to cart';
      button.addEventListener('click', async () => {
        if (button.disabled || button.dataset.busy === '1') return;
        button.dataset.busy = '1';
        button.disabled = true;
        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        const body = {
          items: [{ id: Number(button.dataset.variantId), quantity: 1 }],
          sections: sectionIdsFor(cart),
          sections_url: window.location.pathname
        };
        const base = (window.routes && window.routes.cart_add_url) || '/cart/add';
        const url = base.replace(/\.js$/, '') + '.js';
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify(body)
          });
          const json = await res.json();
          if (!res.ok || json.status) {
            button.setAttribute('aria-label', json.description || json.message || 'Could not add to cart');
            return;
          }
          const state = await fetchCartWithSections(cart);
          const first = Array.isArray(state.items) && state.items.length ? state.items[state.items.length - 1] : {};
          Object.assign(state, { key: first.key, id: first.id });
          if (cart && typeof cart.renderContents === 'function') {
            if (typeof cart.setActiveElement === 'function') cart.setActiveElement(button);
            if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
            cart.renderContents(state);
          } else {
            window.location.href = (window.routes && window.routes.cart_url) || '/cart';
            return;
          }
          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'gn-arc-v2-system-card', productVariantId: first.id, cartData: state });
          }
          button.classList.add('is-added');
          button.textContent = '✓';
          button.setAttribute('aria-label', 'Added to cart');
          window.setTimeout(() => {
            button.classList.remove('is-added');
            button.textContent = '+';
            button.setAttribute('aria-label', label);
          }, 1200);
        } catch (err) {
          console.error(err);
          button.setAttribute('aria-label', 'Could not add to cart');
        } finally {
          button.disabled = false;
          button.dataset.busy = '0';
        }
      });
    });
  })();
</script>

