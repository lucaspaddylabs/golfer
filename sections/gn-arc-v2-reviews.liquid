<style>
  .gn-v2r {
    --gn-bg: #FFFFFF;
    --gn-card: #F5F1E8;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-forest: #173122;
    --gn-mint: #9CCFB0;
    --gn-pale: #DDEFE3;
    --gn-gold: #C9A249;
    --gn-border: #E8E2D4;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2r *, .gn-v2r *::before, .gn-v2r *::after { box-sizing: border-box; }
  .gn-v2r__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2r__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; margin: 0 0 32px; }
  .gn-v2r__eyebrow { margin: 0 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #3A8A5B; }
  .gn-v2r__heading { margin: 0; max-width: 18ch; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }
  .gn-v2r__score { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-card); }
  .gn-v2r__score-num { font-size: 2rem; font-weight: 800; line-height: 1; }
  .gn-v2r__stars { display: inline-flex; gap: 2px; }
  .gn-v2r__stars svg { width: 18px; height: 18px; fill: var(--gn-gold); display: block; }
  .gn-v2r__score-text { display: block; margin-top: 4px; font-size: 0.82rem; font-weight: 600; color: var(--gn-muted); }
  .gn-v2r__grid { column-count: 3; column-gap: 20px; }
  .gn-v2r__card {
    break-inside: avoid; margin: 0 0 20px; padding: 24px; border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-card);
    display: block;
  }
  .gn-v2r__card .gn-v2r__stars svg { width: 15px; height: 15px; }
  .gn-v2r__quote { margin: 12px 0 14px; font-size: 1rem; line-height: 1.5; font-weight: 500; }
  .gn-v2r__who { margin: 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gn-muted); }
  .gn-v2r__who { display: flex; align-items: center; gap: 8px; }
  .gn-v2r__verified { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: var(--gn-pale); color: #3A8A5B; }
  .gn-v2r__verified svg { width: 10px; height: 10px; display: block; }
  .gn-v2r__card.is-featured .gn-v2r__verified { background: rgba(156, 207, 176, 0.2); color: var(--gn-mint); }
  .gn-v2r__card.is-featured { background: var(--gn-forest); border-color: var(--gn-forest); color: #F5F1E8; }
  .gn-v2r__card.is-featured .gn-v2r__quote { font-size: 1.28rem; line-height: 1.4; font-weight: 600; }
  .gn-v2r__card.is-featured .gn-v2r__who { color: var(--gn-mint); }
  @media (max-width: 989px) { .gn-v2r__grid { column-count: 2; } }
  @media (max-width: 640px) {
    .gn-v2r__inner { padding: 0 16px; }
    .gn-v2r__grid { column-count: 1; }
    .gn-v2r__head { align-items: flex-start; }
  }
</style>

<section
  id="gn-v2-reviews"
  class="gn-v2r"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-forest: {{ section.settings.feature_color }};
    --gn-mint: #9CCFB0;
    --gn-pale: #DDEFE3;
    --gn-gold: {{ section.settings.gold_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2r__inner">
    <div class="gn-v2r__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="gn-v2r__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="gn-v2r__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.show_score -%}
        <div class="gn-v2r__score">
          <span class="gn-v2r__score-num">{{ section.settings.rating }}</span>
          <span>
            <span class="gn-v2r__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20"><path d="M10 1.5l2.35 4.76 5.25.76-3.8 3.7.9 5.22L10 13.77l-4.7 2.47.9-5.22-3.8-3.7 5.25-.76L10 1.5z"/></svg>
              {%- endfor -%}
            </span>
            <span class="gn-v2r__score-text">{{ section.settings.score_text }}</span>
          </span>
        </div>
      {%- endif -%}
    </div>

    <div class="gn-v2r__grid">
      {%- for block in section.blocks -%}
        <figure class="gn-v2r__card{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
          <span class="gn-v2r__stars" aria-label="5 out of 5 stars" role="img">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.35 4.76 5.25.76-3.8 3.7.9 5.22L10 13.77l-4.7 2.47.9-5.22-3.8-3.7 5.25-.76L10 1.5z"/></svg>
            {%- endfor -%}
          </span>
          <blockquote class="gn-v2r__quote" style="margin-left:0;margin-right:0">{{ block.settings.quote }}</blockquote>
          <figcaption class="gn-v2r__who">
            <span class="gn-v2r__verified" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
            <span>{{ block.settings.attribution | default: 'Verified buyer' }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 Reviews",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From golfers who use it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real golfers. Real swings." },
    { "type": "checkbox", "id": "show_score", "label": "Show rating box", "default": true },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "score_text", "label": "Rating text", "default": "Based on verified reviews" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F1E8" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "feature_color", "label": "Featured card", "default": "#173122" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#0B1C12" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4B5A50" },
    { "type": "color", "id": "gold_color", "label": "Stars", "default": "#C9A249" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8E2D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "It helps my timing when I swing." },
        { "type": "text", "id": "attribution", "label": "Attribution", "default": "Verified buyer", "info": "Only real names or handles you have permission to use. No made-up handicaps. Blank shows Verified buyer." },
        { "type": "checkbox", "id": "featured", "label": "Featured (dark card, larger text)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "It works! I'm hitting my drives 20-30 yards further. My partner in my scramble league is very happy. We won our league this year. The long par 4s are reachable again!", "featured": true } },
        { "type": "review", "settings": { "quote": "It helps my timing when I swing." } },
        { "type": "review", "settings": { "quote": "I use it in my right hand for about 6 swings. Then I do in in the left hand about 6 swings, then both hands with the normal grip. it is like a quick tune up." } },
        { "type": "review", "settings": { "quote": "Using the swing trainer is an easy way to evaluate your swing without going to the driving range." } },
        { "type": "review", "settings": { "quote": "Has really helped improve my contact. Very noticeable the first time I went to the range after using it every day for less than a week" } },
        { "type": "review", "settings": { "quote": "I purchased 2 of them. I use them and they help me groove my swing. I'm a satisfied person" } }
      ]
    }
  ]
}
{% endschema %}
