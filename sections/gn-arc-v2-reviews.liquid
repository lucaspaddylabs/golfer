<style>
  .gn-v2r {
    --gn-bg: #F5F1E8;
    --gn-card: #FFFFFF;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-mid: #3A8A5B;
    --gn-pale: #DDEFE3;
    --gn-gold: #C9A249;
    --gn-border: #E8E2D4;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2r *, .gn-v2r *::before, .gn-v2r *::after { box-sizing: border-box; }
  .gn-v2r__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2r__head { margin: 0 0 32px; }
  .gn-v2r__eyebrow { margin: 0 0 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2r__heading { margin: 0; max-width: 20ch; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }

  .gn-v2r__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .gn-v2r__reviews { display: contents; }
  .gn-v2r__dots { display: none; }

  .gn-v2r__stars { display: inline-flex; gap: 2px; }
  .gn-v2r__stars svg { width: 16px; height: 16px; display: block; fill: var(--gn-gold); }
  .gn-v2r__stars svg.is-off { fill: var(--gn-border); }

  /* Summary card */
  .gn-v2r__summary {
    display: flex; flex-direction: column; gap: 14px; padding: 28px 24px;
    border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-card);
  }
  .gn-v2r__score-num { margin: 0; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: 4rem; font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; }
  .gn-v2r__summary .gn-v2r__stars svg { width: 20px; height: 20px; }
  .gn-v2r__score-text { margin: 0; font-size: 0.9rem; font-weight: 600; line-height: 1.4; color: var(--gn-muted); }
  .gn-v2r__bars { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 9px; }
  .gn-v2r__bar { display: grid; grid-template-columns: 12px minmax(0, 1fr) 36px; align-items: center; gap: 10px; font-size: 0.82rem; font-weight: 700; }
  .gn-v2r__bar-track { height: 8px; border-radius: 999px; background: #EFE9D9; overflow: hidden; }
  .gn-v2r__bar-fill { display: block; height: 100%; border-radius: 999px; background: var(--gn-green); }
  .gn-v2r__bar-pct { text-align: right; color: var(--gn-muted); font-weight: 600; font-variant-numeric: tabular-nums; }
  .gn-v2r__btn {
    margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px;
    border: 1.5px solid var(--gn-green); border-radius: 12px; background: transparent; color: var(--gn-green);
    font-size: 0.9rem; font-weight: 800; letter-spacing: 0.02em; text-decoration: none; transition: background 0.15s ease, color 0.15s ease;
  }
  .gn-v2r__btn:hover { background: var(--gn-green); color: #fff; }

  /* Review card */
  .gn-v2r__card { margin: 0; display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--gn-border); border-radius: 16px; background: var(--gn-card); overflow: hidden; }
  .gn-v2r__photo { aspect-ratio: 276 / 180; background: #EFE9D9; overflow: hidden; }
  .gn-v2r__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gn-v2r__body { display: flex; flex-direction: column; flex: 1; gap: 12px; padding: 20px 22px 22px; }
  .gn-v2r__quote { margin: 0; font-size: 0.98rem; line-height: 1.5; font-weight: 500; }
  .gn-v2r__who { margin-top: auto; display: grid; gap: 8px; }
  .gn-v2r__name { font-size: 0.98rem; font-weight: 800; line-height: 1.2; }
  .gn-v2r__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .gn-v2r__hcp { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--gn-pale); color: var(--gn-green); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.04em; line-height: 1.2; }
  .gn-v2r__verified { display: inline-flex; align-items: center; gap: 5px; font-size: 0.78rem; font-weight: 700; color: var(--gn-mid); }
  .gn-v2r__verified svg { width: 12px; height: 12px; display: block; }

  @media (max-width: 989px) {
    .gn-v2r__inner { padding: 0 16px; }
    .gn-v2r__grid { display: block; }
    .gn-v2r__summary { margin: 0 0 16px; }
    .gn-v2r__reviews {
      display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
      scrollbar-width: none; margin: 0 -16px; padding: 0 16px 4px; scroll-padding: 0 16px;
    }
    .gn-v2r__reviews::-webkit-scrollbar { display: none; }
    .gn-v2r__card { flex: 0 0 82%; max-width: 360px; scroll-snap-align: start; }
    .gn-v2r__dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
    .gn-v2r__dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 50%; background: #cfc9b8; cursor: pointer; transition: transform 0.15s ease, background 0.15s ease; }
    .gn-v2r__dot.is-active { background: var(--gn-green); transform: scale(1.25); }
  }
</style>

{%- assign review_count_text = section.settings.score_text -%}
{%- if section.settings.review_count != blank -%}
  {%- assign review_count_text = review_count_text | replace: '[N]', section.settings.review_count -%}
{%- endif -%}
<section
  id="gn-v2-reviews"
  class="gn-v2r"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-green: {{ section.settings.accent_color }};
    --gn-mid: {{ section.settings.highlight_color }};
    --gn-pale: {{ section.settings.pale_color }};
    --gn-gold: {{ section.settings.gold_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
  data-gn-v2r
>
  <div class="gn-v2r__inner">
    <div class="gn-v2r__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gn-v2r__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="gn-v2r__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="gn-v2r__grid">
      {%- if section.settings.show_score -%}
        <div class="gn-v2r__summary">
          <p class="gn-v2r__score-num">{{ section.settings.rating }}</p>
          <span class="gn-v2r__stars" role="img" aria-label="{{ section.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.35 4.76 5.25.76-3.8 3.7.9 5.22L10 13.77l-4.7 2.47.9-5.22-3.8-3.7 5.25-.76L10 1.5z"/></svg>
            {%- endfor -%}
          </span>
          <p class="gn-v2r__score-text">{{ review_count_text }}</p>
          <ul class="gn-v2r__bars">
            {%- for i in (1..5) -%}
              {%- liquid
                assign star_n = 6 | minus: i
                case star_n
                  when 5
                    assign pct = section.settings.bar_5
                  when 4
                    assign pct = section.settings.bar_4
                  when 3
                    assign pct = section.settings.bar_3
                  when 2
                    assign pct = section.settings.bar_2
                  else
                    assign pct = section.settings.bar_1
                endcase
              -%}
              <li class="gn-v2r__bar">
                <span>{{ star_n }}</span>
                <span class="gn-v2r__bar-track" aria-hidden="true"><span class="gn-v2r__bar-fill" style="width: {{ pct }}%"></span></span>
                <span class="gn-v2r__bar-pct">{{ pct }}%</span>
              </li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.button_label != blank -%}
            <a class="gn-v2r__btn" href="{{ section.settings.button_url | default: '#gn-v2-reviews' }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gn-v2r__reviews" data-gn-v2r-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign stars_on = block.settings.stars | default: 5
            assign photo = block.settings.image
            assign photo_fallback = block.settings.asset_fallback | strip
          -%}
          <figure class="gn-v2r__card" data-gn-v2r-card {{ block.shopify_attributes }}>
            {%- if photo != blank -%}
              <div class="gn-v2r__photo">
                {{ photo | image_url: width: 800 | image_tag: alt: block.settings.name, loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 280px, 82vw' }}
              </div>
            {%- elsif photo_fallback != blank -%}
              <div class="gn-v2r__photo">
                <img src="{{ photo_fallback | asset_url }}" alt="{{ block.settings.name | escape }}" width="800" height="600" loading="lazy">
              </div>
            {%- endif -%}
            <div class="gn-v2r__body">
              <span class="gn-v2r__stars" role="img" aria-label="{{ stars_on }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 20 20" aria-hidden="true"{% if i > stars_on %} class="is-off"{% endif %}><path d="M10 1.5l2.35 4.76 5.25.76-3.8 3.7.9 5.22L10 13.77l-4.7 2.47.9-5.22-3.8-3.7 5.25-.76L10 1.5z"/></svg>
                {%- endfor -%}
              </span>
              <blockquote class="gn-v2r__quote">{{ block.settings.quote }}</blockquote>
              <figcaption class="gn-v2r__who">
                {%- if block.settings.name != blank -%}
                  <span class="gn-v2r__name">{{ block.settings.name }}</span>
                {%- endif -%}
                <span class="gn-v2r__meta">
                  {%- if block.settings.hcp != blank -%}
                    <span class="gn-v2r__hcp">{{ block.settings.hcp }}</span>
                  {%- endif -%}
                  {%- if block.settings.verified -%}
                    <span class="gn-v2r__verified">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                      {{ section.settings.verified_text }}
                    </span>
                  {%- endif -%}
                </span>
              </figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="gn-v2r__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <button class="gn-v2r__dot{% if forloop.first %} is-active{% endif %}" type="button" data-gn-v2r-dot tabindex="-1"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('gn-v2-reviews');
    if (!root || root.dataset.gnReady === 'true') return;
    root.dataset.gnReady = 'true';
    const track = root.querySelector('[data-gn-v2r-track]');
    const cards = [...root.querySelectorAll('[data-gn-v2r-card]')];
    const dots = [...root.querySelectorAll('[data-gn-v2r-dot]')];
    if (!track || !cards.length || !dots.length) return;

    const setActive = (i) => dots.forEach((d, idx) => d.classList.toggle('is-active', idx === i));
    track.addEventListener('scroll', () => {
      const left = track.getBoundingClientRect().left;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, idx) => {
        const dist = Math.abs(card.getBoundingClientRect().left - left - 16);
        if (dist < bestDist) { bestDist = dist; best = idx; }
      });
      setActive(best);
    }, { passive: true });
    dots.forEach((dot, idx) => dot.addEventListener('click', () => {
      const card = cards[idx];
      if (card) track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 16, behavior: 'smooth' });
    }));
  })();
</script>

{% schema %}
{
  "name": "ARC v2 Reviews",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REVIEWS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Golfers who heard the difference." },
    { "type": "header", "content": "Summary card" },
    { "type": "checkbox", "id": "show_score", "label": "Show summary card", "default": true },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count (N)", "info": "Replaces [N] in the text below. Only use a real, verified number." },
    { "type": "text", "id": "score_text", "label": "Rating text", "default": "Based on verified reviews", "info": "Use [N] to insert the review count, e.g. Based on [N] verified reviews." },
    { "type": "range", "id": "bar_5", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "5 star share", "default": 84 },
    { "type": "range", "id": "bar_4", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "4 star share", "default": 11 },
    { "type": "range", "id": "bar_3", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "3 star share", "default": 3 },
    { "type": "range", "id": "bar_2", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "2 star share", "default": 1 },
    { "type": "range", "id": "bar_1", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "1 star share", "default": 1 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read all reviews", "info": "Leave blank to hide." },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave blank to stay on this section." },
    { "type": "text", "id": "verified_text", "label": "Verified label", "default": "Verified buyer" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F1E8" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#0B1C12" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4B5A50" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1D3D2A" },
    { "type": "color", "id": "highlight_color", "label": "Highlight green", "default": "#3A8A5B" },
    { "type": "color", "id": "pale_color", "label": "Pale green (HCP chip)", "default": "#DDEFE3" },
    { "type": "color", "id": "gold_color", "label": "Stars", "default": "#C9A249" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8E2D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "asset_fallback", "label": "Photo asset fallback", "info": "Theme asset file name used when no photo is picked, e.g. gn-arc-gallery-01.png." },
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "It helps my timing when I swing." },
        { "type": "text", "id": "name", "label": "Name", "default": "Verified golfer", "info": "Only real names or handles you have permission to use." },
        { "type": "text", "id": "hcp", "label": "HCP chip", "info": "Example: HCP 18 → 14. Leave blank to hide." },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Reviews",
      "blocks": [
        { "type": "review", "settings": { "asset_fallback": "gn-arc-gallery-01.png", "stars": 5, "quote": "It works! I'm hitting my drives 20-30 yards further. The long par 4s are reachable again!", "name": "Dave Ridge", "hcp": "HCP 18 → 14", "verified": true } },
        { "type": "review", "settings": { "asset_fallback": "gn-arc-gallery-03.png", "stars": 5, "quote": "It helps my timing when I swing.", "name": "Marcus", "hcp": "HCP 24", "verified": true } },
        { "type": "review", "settings": { "asset_fallback": "gn-arc-gallery-02.png", "stars": 4, "quote": "An easy way to evaluate your swing without going to the driving range.", "name": "Verified golfer", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
