<style>
  #shopify-section-{{ section.id }} .gn-promo-collage {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color | default: '#1d3d2a' }};
    color: {{ section.settings.text_color | default: '#f4f1e4' }};
    padding: {{ section.settings.padding_top | default: 80 }}px 32px {{ section.settings.padding_bottom | default: 80 }}px;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__pattern {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
      radial-gradient(circle at 20% 30%, transparent 40%, {{ section.settings.text_color | default: '#f4f1e4' }} 41%, {{ section.settings.text_color | default: '#f4f1e4' }} 42%, transparent 43%),
      radial-gradient(circle at 80% 70%, transparent 40%, {{ section.settings.text_color | default: '#f4f1e4' }} 41%, {{ section.settings.text_color | default: '#f4f1e4' }} 42%, transparent 43%);
    background-size: 340px 340px;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__heading {
    margin: 0 0 20px;
    font-size: 2.4rem;
    line-height: 1.15;
    color: {{ section.settings.text_color | default: '#f4f1e4' }};
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__desc {
    margin: 0 0 28px;
    opacity: 0.85;
    max-width: 460px;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    border-radius: 50px;
    background: {{ section.settings.text_color | default: '#f4f1e4' }};
    color: {{ section.settings.background_color | default: '#1d3d2a' }};
    font-weight: 700;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__images {
    position: relative;
    height: 420px;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__card {
    position: absolute;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    border: 4px solid {{ section.settings.text_color | default: '#f4f1e4' }};
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__card--1 {
    top: 0;
    left: 0;
    width: 46%;
    height: 55%;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__card--2 {
    top: 22%;
    left: 28%;
    width: 46%;
    height: 55%;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__card--3 {
    top: 8%;
    right: 0;
    width: 34%;
    height: 46%;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .gn-promo-collage__dashes {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .gn-promo-collage__inner {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .gn-promo-collage__images {
      height: 320px;
    }
    #shopify-section-{{ section.id }} .gn-promo-collage__heading {
      font-size: 1.8rem;
    }
  }
</style>

<div class="gn-promo-collage">
  <div class="gn-promo-collage__pattern"></div>
  <div class="gn-promo-collage__inner">
    <div class="gn-promo-collage__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="gn-promo-collage__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="gn-promo-collage__desc">{{ section.settings.description }}</div>
      {%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="gn-promo-collage__cta">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {{ section.settings.button_text }}
          {%- if section.settings.price_text != blank -%} &mdash; {{ section.settings.price_text }}{%- endif -%}
        </a>
      {%- endif -%}
    </div>
    <div class="gn-promo-collage__images">
      <svg class="gn-promo-collage__dashes" viewBox="0 0 400 400" fill="none">
        <path d="M40 320 C 120 300, 140 260, 120 220" stroke="{{ section.settings.text_color | default: '#f4f1e4' }}" stroke-width="2" stroke-dasharray="6 8" />
        <path d="M340 60 C 300 100, 320 140, 360 170" stroke="{{ section.settings.text_color | default: '#f4f1e4' }}" stroke-width="2" stroke-dasharray="6 8" />
      </svg>
      {%- if section.settings.image_1 != blank -%}
      <div class="gn-promo-collage__card gn-promo-collage__card--1">
        {{ section.settings.image_1 | image_url: width: 500 | image_tag: loading: 'lazy' }}
      </div>
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
      <div class="gn-promo-collage__card gn-promo-collage__card--2">
        {{ section.settings.image_2 | image_url: width: 500 | image_tag: loading: 'lazy' }}
      </div>
      {%- endif -%}
      {%- if section.settings.image_3 != blank -%}
      <div class="gn-promo-collage__card gn-promo-collage__card--3">
        {{ section.settings.image_3 | image_url: width: 500 | image_tag: loading: 'lazy' }}
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo collage CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Best Round Starts With One Click" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Train smarter. Score lower.</p>" },
    { "type": "text", "id": "price_text", "label": "Price text (shown in button)", "default": "$29.95" },
    { "type": "text", "id": "button_text", "label": "Button label", "default": "Get Yours Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Collage images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (top left, large)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (center, front)" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3 (top right, small)" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#1d3d2a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#f4f1e4" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [
    { "name": "Promo collage CTA" }
  ]
}
{% endschema %}
