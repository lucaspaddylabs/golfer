<style>
  #shopify-section-{{ section.id }} .gn-arc-band {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .gn-arc-band__inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: {{ section.settings.align }};
  }
  #shopify-section-{{ section.id }} .gn-arc-band__eyebrow {
    margin: 0 0 4px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .gn-arc-band__text {
    margin: 0;
    font-family: var(--font-body-family), sans-serif;
    font-size: 0.78rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gn-arc-band {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>

<div class="gn-arc-band">
  <div class="gn-arc-band__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gn-arc-band__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="gn-arc-band__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ARC ONE color bar",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If it clicks near the top, you’re letting go too soon." },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1d3d2a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f5f3ec" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#9fc3b0" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "min": 6, "max": 40, "step": 2, "unit": "px", "label": "Top padding", "default": 10 },
    { "type": "range", "id": "padding_bottom", "min": 6, "max": 40, "step": 2, "unit": "px", "label": "Bottom padding", "default": 10 }
  ],
  "presets": [
    { "name": "ARC ONE color bar" }
  ]
}
{% endschema %}
