<style>
  #shopify-section-{{ section.id }} .gn-footer {
    background: {{ section.settings.background_color | default: '#1d3d2a' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 64 }}px 32px {{ section.settings.padding_bottom | default: 32 }}px;
  }
  #shopify-section-{{ section.id }} .gn-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-footer__grid {
    display: grid;
    grid-template-columns: 1.35fr repeat(4, 1fr);
    gap: 40px 32px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .gn-footer__logo {
    display: inline-block;
    margin-bottom: 20px;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .gn-footer__logo img {
    display: block;
    width: {{ section.settings.logo_width | default: 140 }}px;
    height: auto;
  }
  #shopify-section-{{ section.id }} .gn-footer__tagline {
    margin: 0 0 28px;
    max-width: 280px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  #shopify-section-{{ section.id }} .gn-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .gn-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: #ffffff;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  #shopify-section-{{ section.id }} .gn-footer__social a:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #ffffff;
  }
  #shopify-section-{{ section.id }} .gn-footer__social svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .gn-footer__heading {
    margin: 0 0 18px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .gn-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .gn-footer__links li + li {
    margin-top: 10px;
  }
  #shopify-section-{{ section.id }} .gn-footer__links a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.4;
    transition: color 0.2s ease;
  }
  #shopify-section-{{ section.id }} .gn-footer__links a:hover {
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .gn-footer__newsletter-text {
    margin: 0 0 16px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }
  #shopify-section-{{ section.id }} .gn-footer__form {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .gn-footer__field {
    position: relative;
  }
  #shopify-section-{{ section.id }} .gn-footer__input {
    width: 100%;
    box-sizing: border-box;
    border: none;
    border-radius: 4px;
    background: {{ section.settings.input_background | default: '#f7f5ef' }};
    color: #1a1a1a;
    padding: 14px 44px 14px 16px;
    font-size: 0.92rem;
    outline: none;
  }
  #shopify-section-{{ section.id }} .gn-footer__input::placeholder {
    color: #767671;
  }
  #shopify-section-{{ section.id }} .gn-footer__submit {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    border: none;
    background: transparent;
    color: #1a1a1a;
    padding: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .gn-footer__submit svg {
    width: 18px;
    height: 18px;
  }
  #shopify-section-{{ section.id }} .gn-footer__message {
    margin: 10px 0 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.9);
  }
  #shopify-section-{{ section.id }} .gn-footer__divider {
    height: 1px;
    margin: 40px 0 20px;
    background: rgba(255, 255, 255, 0.18);
  }
  #shopify-section-{{ section.id }} .gn-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.72);
  }
  #shopify-section-{{ section.id }} .gn-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .gn-footer__legal a {
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .gn-footer__legal a:hover {
    color: #ffffff;
  }
  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .gn-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    #shopify-section-{{ section.id }} .gn-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .gn-footer {
      padding-left: 20px;
      padding-right: 20px;
    }
    #shopify-section-{{ section.id }} .gn-footer__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .gn-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<footer class="gn-footer">
  <div class="gn-footer__inner">
    <div class="gn-footer__grid">
      <div class="gn-footer__brand">
        <a href="{{ routes.root_url }}" class="gn-footer__logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 280 | image_tag: alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            <span class="gn-footer__heading">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="gn-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          <ul class="gn-footer__social">
            {%- assign social_links = 'instagram,youtube,facebook' | split: ',' -%}
            {%- for network in social_links -%}
              {%- assign url_key = network | append: '_url' -%}
              {%- assign url = section.settings[url_key] -%}
              {%- if url != blank -%}
                <li>
                  <a href="{{ url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ network | capitalize }}">
                    {%- case network -%}
                      {%- when 'instagram' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 4.5A5.5 5.5 0 1 1 6.5 14 5.5 5.5 0 0 1 12 8.5zm0 2A3.5 3.5 0 1 0 15.5 14 3.5 3.5 0 0 0 12 10.5zM18 6.8a1.2 1.2 0 1 1-1.2 1.2 1.2 1.2 0 0 1 1.2-1.2z"/></svg>
                      {%- when 'youtube' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.8 4.6 12 4.6 12 4.6s-5.8 0-7.5.5A3 3 0 0 0 2.4 7.2 31.4 31.4 0 0 0 2 12a31.4 31.4 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.7.5 7.5.5 7.5.5s5.8 0 7.5-.5a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 22 12a31.4 31.4 0 0 0-.4-4.8zM10 15.5v-7l6 3.5z"/></svg>
                      {%- when 'facebook' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 8.5V6.8c0-.7.1-1 .9-1h1.8V3h-2.4c-2.9 0-4.3 1.4-4.3 4v1.5H7v2.8h2.5V21h3.9v-9.7h2.6l.3-2.8h-2.9z"/></svg>
                    {%- endcase -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="gn-footer__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <ul class="gn-footer__links">
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign fallback_links = block.settings.fallback_links | newline_to_br | split: '<br />' -%}
                  {%- for line in fallback_links -%}
                    {%- assign parts = line | split: '|' -%}
                    {%- if parts.size >= 2 -%}
                      <li><a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="gn-footer__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="gn-footer__newsletter-text">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'gn-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="gn-footer__field">
                  <input
                    class="gn-footer__input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.placeholder | default: 'Your email' }}"
                    aria-required="true"
                    autocomplete="email"
                    required
                  >
                  <button type="submit" class="gn-footer__submit" aria-label="Subscribe">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 12h12.2l-4.3-4.3 1.4-1.4 6.7 6.7-6.7 6.7-1.4-1.4 4.3-4.3H5z"/></svg>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="gn-footer__message">{{ 'newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="gn-footer__divider"></div>

    <div class="gn-footer__bottom">
      <p class="gn-footer__copyright">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }} GolferNow. All rights reserved.
        {%- endif -%}
      </p>
      {%- if section.settings.show_policy -%}
        <ul class="gn-footer__legal">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GN Footer",
  "class": "gn-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Four instant-feedback tools designed to help you practise with purpose and play better, faster."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2024 GolferNow. All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1d3d2a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Newsletter input background",
      "default": "#f7f5ef"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "textarea",
          "id": "fallback_links",
          "label": "Fallback links",
          "info": "Used when no menu is selected. One link per line: Label | /url",
          "default": "All Products | /collections/all\nARC ONE | /products/arc-one\nConnection Trainer | /products/connection-trainer\nStrike Trainer | /products/strike-trainer\nRoll Trainer | /products/roll-trainer\nThe Complete System | /products/complete-system"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Tips, drills and product updates. No spam."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "Your email"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GN Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop",
            "fallback_links": "All Products | /collections/all\nARC ONE | /products/arc-one\nConnection Trainer | /products/connection-trainer\nStrike Trainer | /products/strike-trainer\nRoll Trainer | /products/roll-trainer\nThe Complete System | /products/complete-system"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Company",
            "fallback_links": "The System | /\nHow It Works | /\nOur Story | /pages/about-us\nReviews | /\nHelp | /pages/contact-us"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Support",
            "fallback_links": "Contact Us | /pages/contact-us\nShipping & Delivery | /policies/shipping-policy\nReturns & Refunds | /policies/refund-policy\nFAQ | /pages/contact-us\nTrack Your Order | /pages/contact-us"
          }
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
