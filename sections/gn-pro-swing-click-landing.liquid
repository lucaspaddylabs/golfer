  <script>
    (() => {
      const section = document.getElementById('gn-pro-swing-click-{{ section.id }}');
      if (!section || section.dataset.gnReady === 'true') return;
      section.dataset.gnReady = 'true';

      if (!customElements.get('product-form')) {
        customElements.define('product-form', class ProductForm extends HTMLElement {
          constructor() {
            super();
            this.form = this.querySelector('form');
            this.submitButton = this.querySelector('[type="submit"]');
            this.spinner = this.querySelector('.loading-overlay__spinner');
            this.errorWrapper = this.querySelector('.product-form__error-message-wrapper');
            this.errorMessage = this.querySelector('.product-form__error-message');

            if (this.form) this.form.addEventListener('submit', this.onSubmitHandler.bind(this));
          }

          getCart() {
            return document.querySelector('cart-drawer') || document.querySelector('cart-notification');
          }

          onSubmitHandler(event) {
            event.preventDefault();
            if (!this.form || this.submitButton?.getAttribute('aria-disabled') === 'true') return;

            this.handleErrorMessage();
            this.submitButton?.setAttribute('aria-disabled', 'true');
            this.submitButton?.classList.add('loading');
            this.spinner?.classList.remove('hidden');

            const cart = this.getCart();
            const formData = new FormData(this.form);
            if (cart && typeof cart.getSectionsToRender === 'function') {
              formData.append('sections', cart.getSectionsToRender().map((sectionToRender) => sectionToRender.id));
              formData.append('sections_url', window.location.pathname);
              if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);
            }

            const config = typeof fetchConfig === 'function'
              ? fetchConfig('javascript')
              : { method: 'POST', headers: { Accept: 'application/javascript' } };
            config.method = 'POST';
            config.headers = config.headers || {};
            config.headers['X-Requested-With'] = 'XMLHttpRequest';
            delete config.headers['Content-Type'];
            config.body = formData;

            fetch(window.routes?.cart_add_url || '/cart/add.js', config)
              .then((response) => response.json())
              .then((response) => {
                if (response.status) {
                  this.handleErrorMessage(response.description || response.message);
                  return;
                }

                if (cart && typeof cart.renderContents === 'function') {
                  cart.renderContents(response);
                } else if (cart && typeof cart.open === 'function') {
                  cart.open();
                } else {
                  window.location = window.routes?.cart_url || '/cart';
                }
              })
              .catch(() => {
                this.handleErrorMessage({{ 'There was an error adding this item to your cart. Please try again.' | json }});
              })
              .finally(() => {
                this.submitButton?.classList.remove('loading');
                this.spinner?.classList.add('hidden');
                if (this.submitButton && !this.submitButton.disabled) {
                  this.submitButton.removeAttribute('aria-disabled');
                }
              });
          }

          handleErrorMessage(errorMessage = false) {
            if (!this.errorWrapper || !this.errorMessage) return;
            this.errorWrapper.toggleAttribute('hidden', !errorMessage);
            if (errorMessage) this.errorMessage.textContent = errorMessage;
          }
        });
      }

      const variantsScript = section.querySelector('[data-gn-variants]');
      const variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];
      const form = section.querySelector('#{{ product_form_id }}');
      const variantInput = section.querySelector('[data-gn-variant-input]');
      const optionInputs = [...section.querySelectorAll('[data-gn-option-input]')];
      const submitButton = section.querySelector('[data-gn-submit]');
      const submitLabel = section.querySelector('[data-gn-submit-label]');
      const priceNode = section.querySelector('[data-gn-price]');
      const stickyPrice = section.querySelector('[data-gn-sticky-price]');
      const compareNode = section.querySelector('[data-gn-compare]');
      const saleBadge = section.querySelector('[data-gn-sale-badge]');
      const stockNode = section.querySelector('[data-gn-stock]');
      const paymentButton = section.querySelector('[data-gn-payment-button]');
      const sticky = section.querySelector('[data-gn-sticky-atc]');
      const stickyButton = section.querySelector('[data-gn-sticky-button]');
      const moneyFormat = section.dataset.moneyFormat || '';
      const currency = section.dataset.currency || 'USD';
      const labels = {
        add: {{ section.settings.add_to_cart_text | json }},
        sold: {{ section.settings.sold_out_text | json }},
        choose: {{ section.settings.choose_options_text | json }}
      };
      const hasOnlyDefaultVariant = {{ product.has_only_default_variant | json }};

      const formatMoney = (cents) => {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, moneyFormat);
        }

        try {
          return new Intl.NumberFormat(undefined, {
            style: 'currency',
            currency
          }).format(cents / 100);
        } catch (error) {
          return `$${(cents / 100).toFixed(2)}`;
        }
      };

      const getSelectedOptions = () => {
        const selected = [];
        optionInputs.forEach((input) => {
          if (input.checked) selected[Number(input.dataset.optionPosition) - 1] = input.value;
        });
        return selected;
      };

      const findVariant = () => {
        if (!optionInputs.length) return variants.find((variant) => variant.id === Number(variantInput?.value)) || variants[0];
        const selected = getSelectedOptions();
        return variants.find((variant) => variant.options.every((option, index) => option === selected[index]));
      };

      const showMedia = (mediaId) => {
        if (!mediaId) return;
        const target = section.querySelector(`[data-gn-media-panel][data-media-id="${mediaId}"]`);
        if (!target) return;

        section.querySelectorAll('[data-gn-media-panel]').forEach((panel) => {
          panel.classList.toggle('is-active', panel === target);
        });

        section.querySelectorAll('[data-gn-thumbnail]').forEach((thumb) => {
          thumb.setAttribute('aria-current', String(thumb.dataset.mediaId === String(mediaId)));
        });
      };

      const updateVariant = () => {
        const variant = findVariant();
        if (!variant) return;

        if (variantInput) variantInput.value = variant.id;
        if (priceNode) priceNode.textContent = formatMoney(variant.price);
        if (stickyPrice) stickyPrice.textContent = formatMoney(variant.price);

        const hasCompare = variant.compare_at_price && variant.compare_at_price > variant.price;
        if (compareNode) {
          compareNode.hidden = !hasCompare;
          compareNode.textContent = hasCompare ? formatMoney(variant.compare_at_price) : '';
        }
        if (saleBadge) saleBadge.hidden = !hasCompare;

        if (submitButton) {
          submitButton.disabled = !variant.available;
          submitButton.setAttribute('aria-disabled', String(!variant.available));
        }
        if (submitLabel) submitLabel.textContent = variant.available ? labels.add : labels.sold;
        if (stockNode) stockNode.hidden = !variant.available;
        if (paymentButton) paymentButton.hidden = !variant.available;

        if (stickyButton) {
          stickyButton.disabled = !variant.available && hasOnlyDefaultVariant;
          if (hasOnlyDefaultVariant) stickyButton.textContent = variant.available ? labels.add : labels.sold;
        }

        if (variant.featured_media && variant.featured_media.id) showMedia(variant.featured_media.id);
      };

      section.querySelectorAll('[data-gn-thumbnail]').forEach((button) => {
        button.addEventListener('click', () => showMedia(button.dataset.mediaId));
      });

      optionInputs.forEach((input) => input.addEventListener('change', updateVariant));

      section.querySelectorAll('[data-gn-faq-button]').forEach((button) => {
        button.addEventListener('click', () => {
          const panel = section.querySelector(`#${button.getAttribute('aria-controls')}`);
          const expanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!expanded));
          if (panel) panel.classList.toggle('is-open', !expanded);
        });
      });

      const scrollToForm = () => {
        const formWrap = section.querySelector('[data-gn-form-wrap]');
        if (!formWrap) return;
        formWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      const submitProductForm = () => {
        if (!form) return;
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      };

      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-gn-add-to-cart]');
        if (!button || !section.contains(button)) return;
        event.preventDefault();
        if (!hasOnlyDefaultVariant) {
          scrollToForm();
          return;
        }
        submitProductForm();
      });

      if (sticky) {
        const hero = section.querySelector('[data-gn-hero]');
        if ('IntersectionObserver' in window && hero) {
          const observer = new IntersectionObserver(([entry]) => {
            sticky.classList.toggle('is-visible', !entry.isIntersecting);
          }, { threshold: 0.05 });
          observer.observe(hero);
        } else {
          window.addEventListener('scroll', () => {
            sticky.classList.toggle('is-visible', window.scrollY > 650);
          }, { passive: true });
        }
      }

      updateVariant();
    })();
  </script>
</section>

