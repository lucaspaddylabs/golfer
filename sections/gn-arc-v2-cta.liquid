{%- liquid
  assign cta_variant = product.selected_or_first_available_variant
  assign cta_url = section.settings.button_url
  if cta_url == blank
    assign cta_url = '#gn-v2-buybox'
  endif
  assign cta_label = section.settings.button_text
  if section.settings.show_price and cta_variant.price > 0
    assign cta_price = cta_variant.price | money
    assign cta_label = cta_label | append: ' — ' | append: cta_price
  endif
  assign bg_image = section.settings.background_image
-%}
<style>
  .gn-v2x {
    --gn-bg: #0B1C12;
    --gn-overlay: #0B1C12;
    --gn-overlay-opacity: 0.78;
    --gn-ink: #FFFFFF;
    --gn-mint: #9CCFB0;
    --gn-gold: #C9A249;
    --gn-btn-bg: #FFFFFF;
    --gn-btn-ink: #0B1C12;
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2x *, .gn-v2x *::before, .gn-v2x *::after { box-sizing: border-box; }
  .gn-v2x__bg {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(52%, 720px);
    z-index: -2;
  }
  .gn-v2x__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .gn-v2x__overlay {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(
      90deg,
      var(--gn-overlay) 0%,
      var(--gn-overlay) 46%,
      transparent 92%
    );
  }
  .gn-v2x[data-align="center"] .gn-v2x__overlay {
    background: linear-gradient(
      90deg,
      var(--gn-overlay) 0%,
      var(--gn-overlay) 40%,
      transparent 90%
    );
  }
  .gn-v2x__inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2x__content { max-width: min(560px, 48%); }
  .gn-v2x[data-align="center"] .gn-v2x__content { margin: 0 auto; text-align: center; max-width: 620px; }
  .gn-v2x__eyebrow { margin: 0 0 14px; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gn-gold); }
  .gn-v2x__heading { margin: 0 0 16px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(2rem, 4.4vw, 3.4rem); line-height: 1.02; font-weight: 800; letter-spacing: -0.03em; color: var(--gn-ink); }
  .gn-v2x__copy { margin: 0 0 28px; max-width: 48ch; font-size: 1.1rem; line-height: 1.55; color: var(--gn-mint); }
  .gn-v2x[data-align="center"] .gn-v2x__copy { margin-left: auto; margin-right: auto; }
  .gn-v2x__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 58px; padding: 0 32px; border-radius: 12px;
    background: var(--gn-btn-bg); color: var(--gn-btn-ink); text-decoration: none; font-size: 1rem; font-weight: 800; letter-spacing: 0.01em;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25); transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .gn-v2x__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3); }
  .gn-v2x__btn svg { width: 18px; height: 18px; flex: 0 0 auto; }
  .gn-v2x__points { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.9rem; font-weight: 600; color: var(--gn-ink); }
  .gn-v2x[data-align="center"] .gn-v2x__points { justify-content: center; }
  .gn-v2x__points li { display: inline-flex; align-items: center; gap: 8px; }
  .gn-v2x__points svg { width: 14px; height: 14px; color: var(--gn-mint); flex: 0 0 auto; }
  @media (max-width: 860px) {
    .gn-v2x__inner { padding: 0 16px; }
    .gn-v2x__content { max-width: 100%; }
    .gn-v2x__bg { width: 58%; }
    .gn-v2x__overlay {
      background: linear-gradient(
        90deg,
        var(--gn-overlay) 0%,
        var(--gn-overlay) 48%,
        transparent 100%
      );
    }
    .gn-v2x__btn { width: 100%; padding: 0 20px; }
  }
</style>

<section
  class="gn-v2x"
  data-align="{{ section.settings.alignment }}"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-overlay: {{ section.settings.overlay_color }};
    --gn-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --gn-ink: {{ section.settings.text_color }};
    --gn-mint: {{ section.settings.mint_color }};
    --gn-gold: {{ section.settings.gold_color }};
    --gn-btn-bg: {{ section.settings.button_color }};
    --gn-btn-ink: {{ section.settings.button_text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2x__bg" aria-hidden="true">
    {%- if bg_image != blank -%}
      {{ bg_image | image_url: width: 2000 | image_tag: alt: '', loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ 'gn-arc-cta-bg.png' | asset_url }}" alt="" width="1400" height="900" loading="lazy">
    {%- endif -%}
  </div>
  <div class="gn-v2x__overlay" aria-hidden="true"></div>

  <div class="gn-v2x__inner">
    <div class="gn-v2x__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gn-v2x__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="gn-v2x__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.copy != blank -%}
        <p class="gn-v2x__copy">{{ section.settings.copy }}</p>
      {%- endif -%}
      <a class="gn-v2x__btn" href="{{ cta_url }}" data-gn-v2-scroll>
        <span>{{ cta_label }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
      {%- if section.blocks.size > 0 -%}
        <ul class="gn-v2x__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('#shopify-section-{{ section.id }} [data-gn-v2-scroll]').forEach((link) => {
      const href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      link.addEventListener('click', (event) => {
        const target = document.querySelector(href);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "ARC v2 Final CTA",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "info": "Falls back to the theme asset gn-arc-cta-bg.jpg." },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay strength", "default": 80 },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "30 DAYS, RISK-FREE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try ARC ONE for 30 days." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Try ARC ONE for 30 days. If your swing doesn't feel more consistent, send it back for a full refund." },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add ARC ONE" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave blank to scroll back to the buy box." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#0B1C12" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#0B1C12" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "mint_color", "label": "Mint copy", "default": "#9CCFB0" },
    { "type": "color", "id": "gold_color", "label": "Eyebrow gold", "default": "#C9A249" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0B1C12" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "30-day returns" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Final CTA",
      "blocks": [
        { "type": "point", "settings": { "text": "Free shipping on bundles" } },
        { "type": "point", "settings": { "text": "Black Friday price until 30 Nov" } }
      ]
    }
  ]
}
{% endschema %}
