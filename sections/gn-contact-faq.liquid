<style>
  #shopify-section-{{ section.id }} .gn-faq {
    background: {{ section.settings.background_color | default: '#f7f5ef' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 32px {{ section.settings.padding_bottom | default: 70 }}px;
  }
  #shopify-section-{{ section.id }} .gn-faq__inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .gn-faq__heading {
    margin: 0 0 {{ section.settings.heading_spacing | default: 28 }}px;
    color: {{ section.settings.heading_color | default: '#1d3d2a' }};
  }
  #shopify-section-{{ section.id }} .gn-faq__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .gn-faq__item {
    border: 1px solid {{ section.settings.border_color | default: '#e2ddcf' }};
    border-radius: 8px;
    margin-bottom: 16px;
    background: {{ section.settings.item_background | default: '#ffffff' }};
    overflow: hidden;
    align-self: start;
  }
  #shopify-section-{{ section.id }} .gn-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.98rem;
    color: {{ section.settings.text_color | default: '#1a1a1a' }};
  }
  #shopify-section-{{ section.id }} .gn-faq__question::-webkit-details-marker {
    display: none;
  }
  #shopify-section-{{ section.id }} .gn-faq__icon {
    flex: 0 0 auto;
    position: relative;
    width: 16px;
    height: 16px;
  }
  #shopify-section-{{ section.id }} .gn-faq__icon::before,
  #shopify-section-{{ section.id }} .gn-faq__icon::after {
    content: '';
    position: absolute;
    background: {{ section.settings.text_color | default: '#1a1a1a' }};
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  #shopify-section-{{ section.id }} .gn-faq__icon::before {
    width: 14px;
    height: 2px;
  }
  #shopify-section-{{ section.id }} .gn-faq__icon::after {
    width: 2px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .gn-faq__item[open] .gn-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg) scale(0);
  }
  #shopify-section-{{ section.id }} .gn-faq__answer {
    margin: 0;
    padding: 0 20px 18px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: {{ section.settings.answer_color | default: '#5c5c56' }};
  }
  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .gn-faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="gn-faq">
  <div class="gn-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gn-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="gn-faq__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details class="gn-faq__item" {{ block.shopify_attributes }}>
            <summary class="gn-faq__question">
              {{ block.settings.question }}
              <span class="gn-faq__icon"></span>
            </summary>
            {%- if block.settings.answer != blank -%}
              <div class="gn-faq__answer">{{ block.settings.answer }}</div>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f7f5ef" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1d3d2a" },
    { "type": "color", "id": "text_color", "label": "Question color", "default": "#1a1a1a" },
    { "type": "color", "id": "answer_color", "label": "Answer color", "default": "#5c5c56" },
    { "type": "color", "id": "item_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Card border color", "default": "#e2ddcf" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "heading_spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Space below heading", "default": 28 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding", "default": 70 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question text" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer text.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders ship within 24-48 hours and typically arrive within 3-5 business days.</p>" } },
        { "type": "faq", "settings": { "question": "Which trainer should I start with?", "answer": "<p>Most golfers start with ARC ONE — it's our flagship trainer and works well on its own or as part of the full system.</p>" } },
        { "type": "faq", "settings": { "question": "What's your return policy?", "answer": "<p>You have 30 days to return any item, no questions asked, as long as it's unused and in its original packaging.</p>" } },
        { "type": "faq", "settings": { "question": "Can I use the trainers indoors?", "answer": "<p>Yes, all of our tools are designed for both indoor practice mats and outdoor use.</p>" } },
        { "type": "faq", "settings": { "question": "Do I need a ball or net to use ARC ONE?", "answer": "<p>No. ARC ONE is a swing trainer that works on its own — no ball, mat, or net required.</p>" } },
        { "type": "faq", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship worldwide. Rates and delivery times are calculated at checkout based on your location.</p>" } }
      ]
    }
  ]
}
{% endschema %}
