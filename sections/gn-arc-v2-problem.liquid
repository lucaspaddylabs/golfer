<style>
  .gn-v2p {
    --gn-bg: #FFFFFF;
    --gn-card: #FFFFFF;
    --gn-after: #DDEFE3;
    --gn-ink: #0B1C12;
    --gn-muted: #4B5A50;
    --gn-green: #1D3D2A;
    --gn-mid: #3A8A5B;
    --gn-orange: #D9772B;
    --gn-terra: #C4553A;
    --gn-border: #E8E2D4;
    background: var(--gn-bg);
    color: var(--gn-ink);
    font-family: var(--font-body-family), sans-serif;
  }
  .gn-v2p *, .gn-v2p *::before, .gn-v2p *::after { box-sizing: border-box; }
  .gn-v2p__inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .gn-v2p__head { max-width: 720px; margin: 0 auto 40px; text-align: center; }
  .gn-v2p__eyebrow { margin: 0 0 10px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gn-mid); }
  .gn-v2p__heading { margin: 0 0 12px; font-family: var(--font-heading-family, var(--font-body-family)), sans-serif; font-size: clamp(1.8rem, 3.5vw, 2.7rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.025em; }
  .gn-v2p__copy { margin: 0; font-size: 1.05rem; line-height: 1.5; color: var(--gn-muted); }
  .gn-v2p__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .gn-v2p__col {
    display: grid; grid-template-columns: minmax(0, 40%) minmax(0, 1fr); min-width: 0;
    border-radius: 20px; border: 1px solid var(--gn-border); background: var(--gn-card); overflow: hidden;
  }
  .gn-v2p__col--after { background: var(--gn-after); border: 2px solid var(--gn-mid); }
  .gn-v2p__photo { position: relative; min-height: 280px; background: #EFE9D9; }
  .gn-v2p__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .gn-v2p__body { padding: 30px 28px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .gn-v2p__tag { margin: 0 0 10px; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.2; color: var(--gn-orange); }
  .gn-v2p__col--after .gn-v2p__tag { color: var(--gn-mid); }
  .gn-v2p__title { margin: 0 0 18px; font-size: 1.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.015em; }
  .gn-v2p__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .gn-v2p__item { display: flex; gap: 12px; align-items: flex-start; font-size: 1rem; line-height: 1.4; font-weight: 600; }
  .gn-v2p__icon { flex: 0 0 auto; width: 22px; height: 22px; margin-top: 1px; display: flex; align-items: center; justify-content: center; color: var(--gn-terra); }
  .gn-v2p__icon svg { width: 16px; height: 16px; display: block; }
  .gn-v2p__col--after .gn-v2p__icon { color: var(--gn-mid); }
  .gn-v2p__bottom { margin: 28px 0 0; text-align: center; font-size: 1.15rem; font-weight: 700; line-height: 1.4; }
  @media (max-width: 989px) {
    .gn-v2p__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .gn-v2p__inner { padding: 0 16px; }
    .gn-v2p__col { grid-template-columns: 1fr; }
    .gn-v2p__photo { min-height: 0; aspect-ratio: 16 / 10; }
    .gn-v2p__body { padding: 22px 20px 24px; }
  }
</style>

{%- liquid
  assign before_img = section.settings.before_image
  assign after_img = section.settings.after_image
-%}

<section
  class="gn-v2p"
  style="
    --gn-bg: {{ section.settings.background_color }};
    --gn-card: {{ section.settings.card_color }};
    --gn-after: {{ section.settings.after_color }};
    --gn-ink: {{ section.settings.ink_color }};
    --gn-muted: {{ section.settings.muted_color }};
    --gn-green: {{ section.settings.accent_color }};
    --gn-mid: {{ section.settings.highlight_color }};
    --gn-orange: {{ section.settings.before_color }};
    --gn-terra: {{ section.settings.terracotta_color }};
    --gn-border: {{ section.settings.border_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gn-v2p__inner">
    <div class="gn-v2p__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gn-v2p__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="gn-v2p__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.copy != blank -%}
        <p class="gn-v2p__copy">{{ section.settings.copy }}</p>
      {%- endif -%}
    </div>

    <div class="gn-v2p__grid">
      <div class="gn-v2p__col gn-v2p__col--before">
        <div class="gn-v2p__photo">
          {%- if before_img != blank -%}
            {{ before_img | image_url: width: 800 | image_tag: alt: section.settings.before_title, loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 240px, 100vw' }}
          {%- else -%}
            <img src="{{ 'gn-arc-ba-before.webp' | asset_url }}" alt="{{ section.settings.before_title | escape }}" width="600" height="600" loading="lazy">
          {%- endif -%}
        </div>
        <div class="gn-v2p__body">
          <p class="gn-v2p__tag">{{ section.settings.before_tag }}</p>
          <h3 class="gn-v2p__title">{{ section.settings.before_title }}</h3>
          <ul class="gn-v2p__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'before' -%}
                <li class="gn-v2p__item" {{ block.shopify_attributes }}>
                  <span class="gn-v2p__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <div class="gn-v2p__col gn-v2p__col--after">
        <div class="gn-v2p__photo">
          {%- if after_img != blank -%}
            {{ after_img | image_url: width: 800 | image_tag: alt: section.settings.after_title, loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 240px, 100vw' }}
          {%- else -%}
            <img src="{{ 'gn-arc-ba-after.webp' | asset_url }}" alt="{{ section.settings.after_title | escape }}" width="600" height="600" loading="lazy">
          {%- endif -%}
        </div>
        <div class="gn-v2p__body">
          <p class="gn-v2p__tag">{{ section.settings.after_tag }}</p>
          <h3 class="gn-v2p__title">{{ section.settings.after_title }}</h3>
          <ul class="gn-v2p__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'after' -%}
                <li class="gn-v2p__item" {{ block.shopify_attributes }}>
                  <span class="gn-v2p__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg></span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

    {%- if section.settings.bottom_text != blank -%}
      <p class="gn-v2p__bottom">{{ section.settings.bottom_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ARC v2 Problem",
  "tag": "section",
  "class": "gn-arc-v2-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PROBLEM IT SOLVES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most amateurs release too early. Few can feel it." },
    { "type": "textarea", "id": "copy", "label": "Intro", "default": "There's rarely time for a coach and rarely space for a net. ARC ONE gives you a signal you can use on the next swing." },
    { "type": "header", "content": "Before card" },
    { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "Falls back to the theme asset gn-arc-ba-before.webp." },
    { "type": "text", "id": "before_tag", "label": "Eyebrow", "default": "BEFORE" },
    { "type": "text", "id": "before_title", "label": "Title", "default": "Guessing on every swing" },
    { "type": "header", "content": "With ARC ONE card" },
    { "type": "image_picker", "id": "after_image", "label": "After image", "info": "Falls back to the theme asset gn-arc-ba-after.webp." },
    { "type": "text", "id": "after_tag", "label": "Eyebrow", "default": "WITH ARC ONE" },
    { "type": "text", "id": "after_title", "label": "Title", "default": "Knowing on every swing" },
    { "type": "text", "id": "bottom_text", "label": "Bottom line", "info": "Optional." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Before card", "default": "#FFFFFF" },
    { "type": "color", "id": "after_color", "label": "With ARC ONE card", "default": "#DDEFE3" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#0B1C12" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4B5A50" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1D3D2A" },
    { "type": "color", "id": "highlight_color", "label": "Green (border, eyebrow, ticks)", "default": "#3A8A5B" },
    { "type": "color", "id": "before_color", "label": "Before eyebrow (orange)", "default": "#D9772B" },
    { "type": "color", "id": "terracotta_color", "label": "Cross icons (terracotta)", "default": "#C4553A" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#E8E2D4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "before",
      "name": "Before item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Grip keeps changing" }
      ]
    },
    {
      "type": "after",
      "name": "After item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Grip locked in" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARC v2 Problem",
      "blocks": [
        { "type": "before", "settings": { "text": "Grip keeps changing" } },
        { "type": "before", "settings": { "text": "Thin and fat contact" } },
        { "type": "before", "settings": { "text": "Weak, high ball flight" } },
        { "type": "after", "settings": { "text": "Grip locked in" } },
        { "type": "after", "settings": { "text": "Consistent contact" } },
        { "type": "after", "settings": { "text": "Lag you can hear" } }
      ]
    }
  ]
}
{% endschema %}
