{%- capture sh_collapsible_content_css -%}
  <style>
    #sh-{{ section.id }}.sh-collapsible-content-section { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background: {{ section.settings.bg_color }}; }
    #sh-{{ section.id }} .sh-page-width {max-width: {{section.settings.section_max_width}}px;width: 100%;padding: 0 20px;margin: 0 auto;background: {{ section.settings.bg_color }};}
    #sh-{{ section.id }} .sh-collapsible-content-section-heading { font-size: {{ section.settings.title_size }}px;font-weight: 500;margin: 0 0 20px;color: {{section.settings.title_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-title {margin-bottom: 30px;}
    #sh-{{ section.id }} .sh-collapsible-content-section-desc p{margin:0;font-size: {{ section.settings.content_size }}px;line-height: 1.4;color: {{section.settings.content_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap .sh-collapsible-content-section-rows {border-bottom: 1px solid {{section.settings.border_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button {font-family: inherit;position: relative;display: block;text-align: left;width: 100%;padding: 1em 0;font-size: {{ section.settings.row_question_size }}px;font-weight: 400;border: none;background: none;outline: none;cursor: pointer;letter-spacing: inherit;}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button .sh-collapsible-content-section-que {padding: 0 3em 0 0;display: block;line-height: 1.4;color: {{section.settings.question_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button .sh-collapsible-content-icon {display: inline-block;position: absolute;top: 18px;right: 0;width: 22px;height: 22px;border: 1px solid;border-radius: 22px;color: {{section.settings.question_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button .sh-collapsible-content-icon::before {display: block;position: absolute;content: '';top: 9px;left: 5px;width: 10px;height: 2px;background: currentColor;color: {{section.settings.question_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button .sh-collapsible-content-icon::after {display: block;position: absolute;content: '';top: 5px;left: 9px;width: 2px;height: 10px;background: currentColor;color: {{section.settings.question_color}};}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button[aria-expanded='true'] .sh-collapsible-content-icon::after {width: 0;}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap button[aria-expanded='true'] + .sh-collapsible-content-section-ans {opacity: 1;max-height: 100%;transition: all 200ms linear;will-change: opacity, max-height;}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap .sh-collapsible-content-section-ans {opacity: 0;max-height: 0;overflow: hidden;transition: opacity 200ms linear, max-height 200ms linear;will-change: opacity, max-height;}
    #sh-{{ section.id }} .sh-collapsible-content-section-wrap .sh-collapsible-content-section-ans p {font-size: {{ section.settings.row_answer_size }}px;line-height: 1.4;margin: 10px 0 25px;color: {{section.settings.answer_color}}}
    
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }} .sh-collapsible-content-section-wrap .sh-collapsible-content-section-ans p {margin: 0 0 15px;font-size:14px; }
      #sh-{{ section.id }}.sh-collapsible-content-section {padding: {{ section.settings.mob_padding_top }}px 0 {{ section.settings.mob_padding_bottom }}px;}
      #sh-{{ section.id }} .sh-collapsible-content-section-heading{font-size: 26px; margin: 0 0 10px;}
      #sh-{{ section.id }} .sh-collapsible-content-section-desc p{font-size: 14px;} 
      #sh-{{ section.id }} .sh-collapsible-content-section-wrap button{font-size: 16px;}     
      #sh-{{ section.id }} .sh-collapsible-content-title {margin-bottom: 20px;} 
    }
  </style>
{%- endcapture -%}
{{- sh_collapsible_content_css | strip_newlines -}}
 
{% if section.blocks.size > 0 %}
  <div id="sh-{{ section.id }}" class="sh-collapsible-content-section">
    <div class="sh-page-width">  
      {% if section.settings.title != blank or section.settings.content != blank %}
        <div class="sh-collapsible-content-title sh-title-align-{{ section.settings.content_align }}">
          {% if section.settings.title != blank %}
            <h2 class="sh-collapsible-content-section-heading">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.content != blank %}
            <div class="sh-collapsible-content-section-desc sh-section-desc">{{ section.settings.content }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="sh-collapsible-content-section-wrap">
        {% assign sh_index = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.title != blank and block.settings.ans != blank %}
            <div class="sh-collapsible-content-section-rows">
              <button id="sh-collapsible-content-button-1" {% if sh_index == 0 and section.settings.open_first_collapsible_row %}aria-expanded="true" {% else %}aria-expanded="false"{% endif %}>
                <span class="sh-collapsible-content-section-que">{{ block.settings.title }}</span>
                <span class="sh-collapsible-content-icon" aria-hidden="true"></span>
              </button>
              <div class="sh-collapsible-content-section-ans">
                {{ block.settings.ans }}
              </div>
            </div>
            {% assign sh_index = sh_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    if(document.querySelector("#sh-{{ section.id }}")){
      let faqItems = document.querySelector("#sh-{{ section.id }}").querySelectorAll('.sh-collapsible-content-section-wrap button');
      faqItems.forEach((faqItem) => faqItem.addEventListener('click', toggleFaqsAccordion));

      function toggleFaqsAccordion() {
        let faqItemsNew = document.querySelector("#sh-{{ section.id }}").querySelectorAll('.sh-collapsible-content-section-wrap button');
        const faqItemToggle = this.getAttribute('aria-expanded');
        for (i = 0; i < faqItemsNew.length; i++) {
          faqItemsNew[i].setAttribute('aria-expanded', 'false');
        }
        if (faqItemToggle == 'false') {
          this.setAttribute('aria-expanded', 'true');
        }
      }
    }
  </script>
{% endif %}

{% schema %}
  {
