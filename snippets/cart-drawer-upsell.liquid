{%- liquid
  assign upsell_1 = settings.cart_drawer_upsell_1
  assign upsell_2 = settings.cart_drawer_upsell_2
  assign upsell_3 = settings.cart_drawer_upsell_3
  if upsell_1 == blank
    assign upsell_1 = all_products['magnetic-golf-towel']
  endif
  if upsell_2 == blank
    assign upsell_2 = all_products['golf-ball-marker-fork']
  endif
  if upsell_3 == blank
    assign upsell_3 = all_products['golf-club-brush-groove-sharpener-tool']
  endif

  assign offer_in_cart = 0
  assign remaining_count = 0
-%}

{%- capture upsell_slides -%}
  {%- for upsell_index in (1..3) -%}
    {%- liquid
      if upsell_index == 1
        assign product = upsell_1
      elsif upsell_index == 2
        assign product = upsell_2
      else
        assign product = upsell_3
      endif

      if product == blank or product.id == blank
        continue
      endif

      assign already_in_cart = false
      for item in cart.items
        if item.product_id == product.id
          assign already_in_cart = true
          break
        endif
      endfor

      if already_in_cart
        assign offer_in_cart = offer_in_cart | plus: 1
        continue
      endif

      unless product.available
        continue
      endunless

      assign remaining_count = remaining_count | plus: 1
      assign current_variant = product.selected_or_first_available_variant
      assign compare_at_price = current_variant.compare_at_price
      assign price = current_variant.price
    -%}
    <div class="gn-cart-upsell__slide" data-upsell-slide role="group" aria-roledescription="slide" aria-label="{{ remaining_count }} of remaining offers">
      <div class="gn-cart-upsell__card">
        {%- if product.featured_media != blank -%}
          <a class="gn-cart-upsell__media" href="{{ product.url }}" tabindex="-1">
            <img
              src="{{ product.featured_media | image_url: width: 240 }}"
              srcset="{{ product.featured_media | image_url: width: 160 }} 160w, {{ product.featured_media | image_url: width: 240 }} 240w"
              sizes="56px"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
        <div class="gn-cart-upsell__details">
          <div class="gn-cart-upsell__top">
            <a class="gn-cart-upsell__title" href="{{ product.url }}">{{ product.title | escape }}</a>
            <div class="gn-cart-upsell__price">
              <span class="gn-cart-upsell__price-current">{{ price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</span>
              {%- if compare_at_price > price -%}
                <s class="gn-cart-upsell__price-compare">{{ compare_at_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</s>
              {%- endif -%}
            </div>
          </div>
          <div class="gn-cart-upsell__row">
            <div class="gn-cart-upsell__swatches" role="radiogroup" aria-label="Color">
              {%- if product.has_only_default_variant == false -%}
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign swatch_name = variant.title | downcase | strip
                    assign swatch_hex = '#8a8a8a'
                    case swatch_name
                      when 'green', 'atrovirens'
                        assign swatch_hex = '#1d3d2a'
                      when 'black'
                        assign swatch_hex = '#111111'
                      when 'blue', 'royal blue'
                        assign swatch_hex = '#2a6fbb'
                      when 'navy blue', 'navy'
                        assign swatch_hex = '#1a365d'
                      when 'silver'
                        assign swatch_hex = '#c5c9cf'
                      when 'gray', 'grey'
                        assign swatch_hex = '#8d8d8d'
                      when 'dark gray', 'dark grey'
                        assign swatch_hex = '#4a4a4a'
                      when 'white'
                        assign swatch_hex = '#ffffff'
                      when 'orange'
                        assign swatch_hex = '#e67a2e'
                    endcase
                  -%}
                  <button
                    type="button"
                    class="gn-cart-upsell__swatch{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                    style="--swatch: {{ swatch_hex }};"
                    data-upsell-variant
                    data-variant-id="{{ variant.id }}"
                    aria-label="{{ variant.title | escape }}"
                    aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                    title="{{ variant.title | escape }}"
                    {% unless variant.available %}disabled{% endunless %}
                  ></button>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <button
              type="button"
              class="btn gn-cart-upsell__add"
              data-upsell-add
              data-variant-id="{{ current_variant.id }}"
            >
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- if remaining_count > 0 -%}
  <cart-drawer-upsell class="gn-cart-upsell" data-remaining="{{ remaining_count }}">
    <div class="gn-cart-upsell__carousel">
      <button type="button" class="gn-cart-upsell__nav gn-cart-upsell__nav--prev" data-upsell-prev aria-label="Previous product"{% if remaining_count < 2 %} aria-hidden="true" tabindex="-1"{% endif %}>
        {%- render 'icon-arrow-left' -%}
      </button>
      <div class="gn-cart-upsell__main">
        <div class="gn-cart-upsell__header">
          <h6 class="gn-cart-upsell__heading mt0 mb0">Buy 2, get the 3rd free</h6>
          <p class="gn-cart-upsell__sub mt0 mb0">
            {%- if offer_in_cart == 0 -%}
              Lowest-priced item is free with all 3.
            {%- elsif offer_in_cart == 1 -%}
              1 of 3 added. Add 2 more for the free item.
            {%- else -%}
              2 of 3 added. Add 1 more — it's free.
            {%- endif -%}
          </p>
        </div>
        <div class="gn-cart-upsell__viewport" data-upsell-viewport>
          <div class="gn-cart-upsell__track" data-upsell-track>
            {{ upsell_slides }}
          </div>
        </div>
      </div>
      <button type="button" class="gn-cart-upsell__nav gn-cart-upsell__nav--next" data-upsell-next aria-label="Next product"{% if remaining_count < 2 %} aria-hidden="true" tabindex="-1"{% endif %}>
        {%- render 'icon-arrow-right' -%}
      </button>
    </div>
  </cart-drawer-upsell>
{%- endif -%}
