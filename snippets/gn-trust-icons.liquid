{%- comment -%}
  Checkout trust icons: lock, returns, truck, shield, chat.
  Renders an inline SVG for a trust badge beside ATC / checkout.
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'lock' | downcase
  if text != blank
    assign lower = text | downcase
    if lower contains 'return'
      assign icon = 'returns'
    elsif lower contains 'ship' or lower contains 'track' or lower contains 'deliver'
      assign icon = 'truck'
    elsif lower contains 'support' or lower contains '24/7' or lower contains 'chat'
      assign icon = 'chat'
    elsif lower contains 'secure' or lower contains 'checkout' or lower contains 'payment'
      assign icon = 'lock'
    elsif lower contains 'guarantee' or lower contains 'protect'
      assign icon = 'shield'
    endif
  endif
-%}
<span class="gn-trust-icon" aria-hidden="true">
  {%- case icon -%}
    {%- when 'returns' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 3-6.7"/>
        <path d="M3 4v5h5"/>
      </svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7h11v10H3z"/>
        <path d="M14 11h4l3 3v3h-7"/>
        <circle cx="7" cy="18" r="2"/>
        <circle cx="17" cy="18" r="2"/>
      </svg>
    {%- when 'chat' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8z"/>
      </svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 20 7v6c0 5-3.4 7.7-8 9-4.6-1.3-8-4-8-9V7l8-4z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="11" width="14" height="10" rx="2"/>
        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
      </svg>
  {%- endcase -%}
</span>
