{%- comment -%}
  Checkout trust icons. Pass icon and/or text; copy is used to pick an icon when needed.
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'lock' | downcase
  if text != blank
    assign lower = text | downcase
    if lower contains 'worldwide' or lower contains 'global' or lower contains 'world'
      assign icon = 'globe'
    elsif lower contains 'return' or lower contains 'money back' or lower contains 'guarantee'
      assign icon = 'card'
    elsif lower contains 'ship' or lower contains 'track' or lower contains 'deliver' or lower contains 'free shipping'
      assign icon = 'truck'
    elsif lower contains 'support' or lower contains '24/7' or lower contains 'chat'
      assign icon = 'chat'
    elsif lower contains 'secure' or lower contains 'checkout' or lower contains 'payment'
      assign icon = 'lock'
    elsif lower contains 'protect'
      assign icon = 'shield'
    endif
  endif
-%}
<span class="gn-trust-icon" aria-hidden="true">
  {%- case icon -%}
    {%- when 'returns' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 24a16 16 0 1 0 4-11.2"/>
        <path d="M8 10v9h9"/>
      </svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 14h22v18H6z"/>
        <path d="M28 22h8l6 6v4H28"/>
        <circle cx="14" cy="34" r="3.2"/>
        <circle cx="36" cy="34" r="3.2"/>
        <path d="M17.2 34h11.6"/>
      </svg>
    {%- when 'chat' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M40 22a14 14 0 0 1-14 14H16l-8 6V22a14 14 0 0 1 14-14h4a14 14 0 0 1 14 14z"/>
      </svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 6 38 12v12c0 9-6 14-14 16.5C16 38 10 33 10 24V12L24 6z"/>
        <path d="m18 24 4 4 8-8"/>
      </svg>
    {%- when 'card' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6" y="14" width="28" height="20" rx="2.5"/>
        <path d="M6 20h28"/>
        <path d="M12 28h8"/>
        <path d="M32 22.5 40 18v10c0 4.2-2.6 6.6-8 8.2-5.4-1.6-8-4-8-8.2"/>
        <path d="m33.2 27.2 2.2 2.2 4.2-4.4"/>
      </svg>
    {%- when 'globe' -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="26" cy="16" r="9"/>
        <path d="M17 16h18"/>
        <path d="M26 7c-3.2 2.6-4.8 5.6-4.8 9s1.6 6.4 4.8 9c3.2-2.6 4.8-5.6 4.8-9s-1.6-6.4-4.8-9z"/>
        <path d="M14 24h20l4 8H18l-4-8z"/>
        <path d="M18 32v6h16v-6"/>
        <path d="M18 38h16"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="12" y="22" width="24" height="16" rx="2.5"/>
        <path d="M18 22v-5a6 6 0 0 1 12 0v5"/>
      </svg>
  {%- endcase -%}
</span>
