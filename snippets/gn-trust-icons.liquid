{%- comment -%}
  Checkout trust icons. Copy is used to pick an icon when the setting is generic.
{%- endcomment -%}
{%- liquid
  assign icon = icon | default: 'lock' | downcase
  if text != blank
    assign lower = text | downcase
    if lower contains 'worldwide' or lower contains 'global' or lower contains 'world'
      assign icon = 'globe'
    elsif lower contains 'return' or lower contains 'money back' or lower contains 'guarantee'
      assign icon = 'shield'
    elsif lower contains 'ship' or lower contains 'track' or lower contains 'deliver' or lower contains 'free shipping'
      assign icon = 'truck'
    elsif lower contains 'support' or lower contains '24/7' or lower contains 'chat'
      assign icon = 'chat'
    elsif lower contains 'secure' or lower contains 'checkout' or lower contains 'payment'
      assign icon = 'lock'
    elsif lower contains 'protect'
      assign icon = 'shield'
    endif
  endif
-%}
<span class="gn-trust-icon" aria-hidden="true">
  {%- case icon -%}
    {%- when 'returns' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 3-6.7"/>
        <path d="M3 4v5h5"/>
      </svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 7h13v9H1z"/>
        <path d="M14 10h4l3 3v3h-7"/>
        <circle cx="5.5" cy="18" r="1.75"/>
        <circle cx="16.5" cy="18" r="1.75"/>
      </svg>
    {%- when 'chat' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-4 3V11.5A7.5 7.5 0 0 1 10.5 4h3a7.5 7.5 0 0 1 7.5 7.5z"/>
      </svg>
    {%- when 'card' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="6" width="18" height="12" rx="2"/>
        <path d="M3 10h18"/>
      </svg>
    {%- when 'globe' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <path d="M3 12h18"/>
        <path d="M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
      </svg>
    {%- when 'lock' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="11" width="14" height="10" rx="2"/>
        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 20 7v6c0 5-3.5 7.6-8 9-4.5-1.4-8-4-8-9V7l8-4z"/>
      </svg>
  {%- endcase -%}
</span>
