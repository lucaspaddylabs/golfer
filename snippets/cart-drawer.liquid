{% comment %}
    Renders cart drawer

    Usage:
    {% render 'cart-drawer' %}
{% endcomment %}
{%- render 'style-loader',
array:'
component-cart-drawer.css,
component-price.css,
component-toggle.css,
component-cart-items.css,
component-free-delivery-bar.css,
swiper-bundle.min.css,
component-swiper-slider.css
' -%}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<cart-drawer class="popup-modal popup-modal__right cart-drawer-container{% if cart == empty %} is-empty{% endif %}">
  <div class="popup-modal__overlay" onclick="this.closest('.popup-modal').close()"></div>
  <div id="CartDrawer" class="cart-drawer popup-modal__content popup-modal__content__f-height">
    <div class="drawer__header">
      <h4 class="drawer__heading mt0 mb0">Your Cart ({{ cart.item_count }})</h4>
      <button class="popup-modal__toggle modal-close-animation" type="button" onclick="this.closest('.popup-modal').close()" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>
    <drawer-inner class="drawer__inner popup-modal__content__data custom__scrollbar" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}" tabindex="-1">
      {%- if cart == empty -%}
      <div class="drawer__inner-empty">
        <div class="cart__warnings text-center">
          <div class="cart-drawer__empty-content">
            <div class="cart__warnings__icon">
              {%- render "icon-cart" -%}
            </div>
            <h4 class="mb0">{{ 'sections.cart.empty' | t }}</h4>

            <button class="mt40 btn w-full"
                    type="button"
                    onclick="this.closest('cart-drawer').close()"
                    aria-label="{{ 'accessibility.close' | t }}"
                    >
              <span>{%- render "icon-arrow-left-2" -%}{{ 'general.continue_shopping' | t }}</span>
            </button>

            {%- comment -%} Empty-cart login prompt hidden — keep checkout path simple. {%- endcomment -%}
      
          </div>
        </div>

        {%- liquid
          assign empty_cart_collection = collections['the-system']
          if empty_cart_collection == blank or empty_cart_collection.products_count == 0
            assign empty_cart_collection = collections['frontpage']
          endif
        -%}
        {%- if empty_cart_collection != blank and empty_cart_collection.products_count > 0 -%}
        <div class="cart-drawer__collection-products mt40">
          <h6 class="mt0 mb0">Customers Also Bought</h6>
          <div class="mt16 swiper-no-mask-mobile">
            {%- assign data_grid = "2,3,2,2,3" -%}
            <swiper-slider class="swiper"
                           data-swiper-desktop-grid="3"
                           data-swiper-tablet-grid="3"
                           data-gutter="15"
                           data-gutter-mobile="15"
                           data-grid="{{ data_grid }}"
                           data-autoplay="false"
                           data-script="{{ 'swiper-bundle.min.js' | asset_url }}"
              >
              <div class="swiper-wrapper swiper-wrapper--max-height">
                {%- for product in empty_cart_collection.products limit:4 -%}
                <div class="swiper-slide" lazy="true">
                  {%- render 'product-card',
                    customize: true,
                    product_card_product: product,
                    product_collection: empty_cart_collection,
                    image_ratio_value: settings.cart_drawer_image_ratio,
                    image_hover_type: 'default',
                    show_secondary_image: 'normal',
                    show_price: true,
                    show_sku: false,
                    show_vendor: false,
                    show_type: false,
                    hover_underline: false,
                    button_type_product: "hide",
                    show_quantity: false,
                    show_badge_sold_out: true,
                    show_badge_on_sale: false,
                    show_badge_feature: false,
                    show_countdown: false,
                    truncate_product_name: true,
                    small_radius: true,
                    enable_rating_product_card: false
                -%}
                </div>
                {%- endfor -%}
              </div>
            </swiper-slider>
            <div class="swiper-control-container">
              <div class="custom-swiper-button-prev">{%- render "icon-arrow-left" -%}</div>
              <div class="swiper-pagination"></div>
              <div class="custom-swiper-button-next">{%- render "icon-arrow-right" -%}</div>
            </div>
          </div>
        </div>
        {%- endif -%}

      </div>        
      {%- endif -%}
      <div class="drawer__footer">
        {%- if settings.show_free_delivery -%}
        <div class="drawer__footer-shipping">
          <div id="cart-page-free-delivery" class="free-delivery-bar">
            {%- render "free-delivery-bar" -%}
            <div class="free-delivery-bar__end hide"></div>
          </div>
        </div>
        {%- endif -%}

        <div class="drawer__footer-content">
          <cart-drawer-items{% if cart == empty %} class="is-empty"{% endif %}>
            <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
              <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
  
                {%- if cart != empty -%}
                
                <div class="drawer__cart-items-wrapper">
                  {%- for item in cart.items -%}
                  {%- liquid
                    assign cart_item_save = item.original_line_price | minus: item.final_line_price
                    if item.line_level_total_discount > cart_item_save
                      assign cart_item_save = item.line_level_total_discount
                    endif
                    assign cart_item_alloc = 0
                    for allocation in item.discount_allocations
                      assign cart_item_alloc = cart_item_alloc | plus: allocation.amount
                    endfor
                    if cart_item_alloc > cart_item_save
                      assign cart_item_save = cart_item_alloc
                    endif
                    assign cart_item_pay = item.original_line_price | minus: cart_item_save
                    if cart_item_pay < 0
                      assign cart_item_pay = 0
                    endif
                  -%}
                  <div class="drawer__cart-item" id="CartDrawer-Item-{{ item.index | plus: 1 }}">
                    <div class="drawer__cart-item__content">
                      {% if item.image %}
                      <div class="drawer__cart-item__media {{ settings.image_hover }}">
                        <a href="{{ item.url }}" class="image-hover-box__container{% if settings.cart_drawer_image_ratio == '1.00' %} image-hover-box--circle{% endif %}">
                          <div class="image-hover-box image-hover-box__small-radius">
                            {%- liquid
                            if settings.cart_drawer_image_ratio != 'auto'
                            assign image_ratio = settings.cart_drawer_image_ratio
                            else
                            assign image_ratio = item.image.aspect_ratio
                            if item.image.aspect_ratio == nil
                            assign image_ratio = 1
                            endif
                            endif 
                            -%}
        
                            <div style="--aspect-ratio: {{image_ratio}};">
                              <img srcset="{{ item.image | image_url: width: 500 }} 1x, {{ item.image | image_url: width: 1000 }} 2x"
                                   src="{{ item.image | image_url: width: 500 }}"
                                   loading="lazy"
                                   width="{{ item.image.width }}"
                                   height="{{ item.image.height }}"
                                   alt="{{ item.image.alt | escape }}"
                                   >
                            </div>
                          </div>
                        </a>
                      </div>
                      {% endif %}
                      <div class="drawer__cart-item__details">
                        <div class="drawer__cart-item__details__items body3 mt--first-child-0">
                          <a href="{{ item.url }}" class="h6 cart-item__heading animation-underline">{{ item.product.title | escape }}</a>

                          <div class="cart-item__unit-price">{{ item.final_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</div>
                          {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                          <dl class="mt3">
                            {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                            <div class="product-option">
                              <dt>{{ option.name }}: </dt>
                              <dd>{{ option.value }}</dd>
                            </div>
                            {%- endfor -%}
                            {%- endif -%}
        
                            {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="product-option">
                              <dt>{{ property.first }}: </dt>
                              <dd>
                                {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}" target="_blank">
                                  {{ property.last | split: '/' | last }}
                                </a>
                                {%- else -%}
                                {{ property.last }}
                                {%- endif -%}
                              </dd>
                            </div>
                            {%- endif -%}
                            {%- endfor -%}
                          </dl>
        
                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          {%- if cart_item_save > 0 -%}
                            <span class="cart-item__discount-badge">
                              {%- if cart_item_pay == 0 -%}
                                Free
                              {%- else -%}
                                Save {{ cart_item_save | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                              {%- endif -%}
                            </span>
                          {%- endif -%}

                          <div class="cart-item__error cart-item-message__content" id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" role="alert">
                            <span class="cart-item__error-text cart-item-message__content__text"></span>
                            {%- render "icon-info" -%}
                          </div>
                        </div>
                        <div class="cart-item__actions">
                        <div class="cart-item__quantity">
                          <label class="visually-hidden" for="Drawer-quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <quantity-input class="field quantity">
                            {%- assign inv_man = item.variant.inventory_management -%}{%- assign inv_qua = item.variant.inventory_quantity | plus: 0 -%}{%- unless inv_man -%}{%- assign inv_qua = 100000 -%}{%- endunless -%}{%- if item.variant.inventory_policy == "continue" -%}{%- assign inv_qua = 100000 -%}{%- endif -%}
                            <button class="quantity__button" name="minus" type="button"{% if item.quantity == 1 %} style="display: none;"{% endif %}>
                              <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                              {% render 'icon-minus' %}
                            </button>
                            <input id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                   class="field__input quantity__input"
                                   type="number"
                                   name="updates[]"
                                   value="{{ item.quantity }}"
                                   data-quantity-variant-id="{{ item.variant.id }}"
                                   {% # theme-check-disable %}
                                   data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                   min="0"
                                   max="{{ inv_qua }}"
                                   step="1"
                                   {% # theme-check-enable %}
                                   aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                   data-index="{{ item.index | plus: 1 }}"
                                   {% if inv_qua == 1 %}disabled{% endif %}
                                   >
                            <button class="quantity__button" name="plus" type="button"{% if item.quantity == inv_qua %} style="display: none;"{% endif %}>
                              <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                              {% render 'icon-plus' %}
                            </button>
                          </quantity-input>
      
                          <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                            <a href="{{ item.url_to_remove }}" class="cart-item__remove-button transition-up" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                              {% render 'icon-remove' %}
                            </a>
                          </cart-remove-button>
                        </div>
                        <div class="cart-item__totals">
                          <div class="loading-overlay hidden">
                            <div class="loading-overlay__spinner">
                              <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                              </svg>
                            </div>
                          </div>
                          {%- if cart_item_save > 0 -%}
                            <div class="cart-item__discounted-prices">
                              <span class="price__sale{% if cart_item_pay == 0 %} price__free{% endif %}">
                                {%- if cart_item_pay == 0 -%}
                                  Free
                                {%- else -%}
                                  {{ item.final_line_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                                {%- endif -%}
                              </span>
                              <s class="price__regular">{{ item.original_line_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</s>
                            </div>
                          {%- else -%}
                            <span class="price__main">
                              {{ item.final_line_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                            </span>
                          {%- endif -%}
        
                          {%- if item.variant.available and item.unit_price_measurement -%}
                          <div class="mt3 unit-price body3">
                            <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                            {{ item.variant.unit_price | money }}
                            <span aria-hidden="true">/</span>
                            <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                            {%- if item.variant.unit_price_measurement.reference_value != 1 -%}
                            {{- item.variant.unit_price_measurement.reference_value -}}
                            {%- endif -%}
                            {{ item.variant.unit_price_measurement.reference_unit }}
                          </div>
                          {%- endif -%}
                        </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  {%- endfor -%}

                </div>
                {%- endif -%}
          
                <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
                <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
              </div>
              <div id="CartDrawer-CartErrors" role="alert"></div>
            </form>
          </cart-drawer-items>
        </div>
        <div class="drawer__footer-footer">
          {%- if cart != empty and settings.cart_drawer_upsell_enable != false -%}
            {%- capture gn_cart_upsell_html -%}
              {%- render 'gn-cart-upsell' -%}
            {%- endcapture -%}
            {%- if gn_cart_upsell_html != blank -%}
              <div class="gn-cart-upsell-pin">
                {{ gn_cart_upsell_html }}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- liquid
            assign free_ship_threshold_cents = settings.free_delivery_price | times: 100
            assign estimated_shipping_raw = settings.cart_estimated_shipping | default: '4.99'
            assign estimated_shipping_cents = estimated_shipping_raw | times: 100
            assign qualifies_free_shipping = false
            if free_ship_threshold_cents > 0 and cart.total_price >= free_ship_threshold_cents
              assign qualifies_free_shipping = true
            endif
            if qualifies_free_shipping
              assign estimated_shipping_cents = 0
            endif
            assign order_total_with_shipping = cart.total_price | plus: estimated_shipping_cents
          -%}
          <div class="cart__footer__information gn-cart-checkout-sticky">
            <div class="cart__footer__content js-contents body3" {{ block.shopify_attributes }}>
              <div class="totals gn-cart-totals{% if qualifies_free_shipping %} is-free-shipping{% endif %}">
                <div class="gn-cart-totals__row gn-cart-totals__row--order">
                  <span class="gn-cart-totals__label">Total</span>
                  <span class="gn-cart-totals__value">
                    {%- if qualifies_free_shipping -%}
                      {{ cart.total_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                      <span class="gn-cart-totals__ship-tag">Free shipping</span>
                    {%- else -%}
                      {{ cart.total_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                      <span class="gn-cart-totals__ship-add">+ {{ estimated_shipping_cents | money | replace: 'US$', '$' | replace: 'US $', '$' }} shipping</span>
                    {%- endif -%}
                  </span>
                </div>
              </div>

              {% if settings.show_installments %}
                <span class="cart__summary-item cart__installments display-block body2 mt8">{% form 'cart', cart %}{{ form | payment_terms }}{% endform %}</span>
              {% endif %}
              {%- if cart.cart_level_discount_applications.size > 0 -%}
              <div class="mt6">
                <ul class="discounts unstyle-ul body3" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                  {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount cart-item-message__content">
                    {%- render 'icon-discount' -%}
                    <span class="cart-item-message__content__text">{{ discount.title }}(-{{ discount.total_allocated_amount | money }})</span>
                  </li>
                  {%- endfor -%}
                </ul>
              </div>
              {%- endif -%}
            </div>

            {%- if settings.terms_and_condition_checkbox -%}
            <terms_and_condition-checkbox class="mt12 display-block">
              <label for="product-terms_and_condition_checkbox-{{ section.id }}" class="checkbox-input body2">
                <input id="product-terms_and_condition_checkbox-{{ section.id }}"
                       type="checkbox">
                <div class="checkbox-input__checkmark">
                  <div class="checkbox-input__flip">
                    <div class="checkbox-input__front"></div>
                    <div class="checkbox-input__back">
                      {%- render "icon-checkmark" -%}
                    </div>
                  </div>
                </div>
                <span>{{ 'general.accept_terms_checkbox_html' | t }}</span>
              </label>
            </terms_and_condition-checkbox>
            {%- endif -%}
            {%- if settings.show_checkout_button -%}
            <div class="gn-cart-checkout-action">
              <button type="submit"
                      id="CartDrawer-Checkout"
                      class="btn btn--checkout w-full"
                      name="checkout"
                      form="CartDrawer-Form"{% if cart == empty %} disabled{% endif %}
                      >
                <span>
                  Checkout
                  {%- if order_total_with_shipping > 0 -%}
                    &nbsp;— {{ order_total_with_shipping | money | replace: 'US$', '$' | replace: 'US $', '$' }}
                  {%- endif -%}
                </span>
              </button>
            </div>
            {%- endif -%}
            <div class="drawer__inner__links gn-cart-continue">
              <button class="link link--medium link-hover-span{% if settings.buttons_uppercase %} text-uppercase{% endif %}" type="button" onclick="this.closest('.popup-modal').close()" aria-label="{{ 'accessibility.close' | t }}">
                {%- render "icon-arrow-left-2" -%}
                <span>{{ 'general.continue_shopping' | t }}</span>
              </button>
            </div>
            {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
            <div class="cart__dynamic-checkout-buttons additional-checkout-buttons additional-checkout-buttons--vertical mt10">{{ content_for_additional_checkout_buttons }}</div>
            {% endif %}
          </div>            
          
        </div>
      </div>
      
    </drawer-inner>
  </div>
</cart-drawer>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // We use a "delegated" listener in case the sidebar opens/closes dynamically
  document.addEventListener('click', function(e) {
    // 1. Identify the checkout button
    const checkoutBtn = e.target.closest('button[name="checkout"], .cart__checkout-button, [href="/checkout"]');
    
    if (checkoutBtn) {
      e.preventDefault(); // Stop the default Shopify checkout
      e.stopPropagation();

      // 2. Fetch the latest cart data to get the fresh token
      fetch(window.Shopify.routes.root + 'cart.js')
        .then(response => response.json())
        .then(cart => {
          const token = cart.token;
          // 3. Redirect to your custom checkout page
          // Replace 'your-page-url' with your actual custom page path
          window.location.href = `https://checkout.golfernow.com?token=${token}`;
        })
        .catch(error => {
          console.error('Error fetching cart token:', error);
          // Fallback: if fetch fails, let them go to normal checkout so you don't lose the sale
          window.location.href = '/checkout';
        });
    }
  }, true); 
});
</script>
