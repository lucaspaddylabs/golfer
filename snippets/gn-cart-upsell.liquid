{%- comment -%}
  Cart drawer "Frequently Bought With" accessory strip.
  Horizontal product cards (image + Add + title + price), matching the cart-drawer upsell pattern.
  Uses settings.cart_drawer_upsell_enable + cart_drawer_upsell_1/2/3.
{%- endcomment -%}
{%- unless settings.cart_drawer_upsell_enable == false -%}
  {%- liquid
    assign upsell_1 = settings.cart_drawer_upsell_1
    assign upsell_2 = settings.cart_drawer_upsell_2
    assign upsell_3 = settings.cart_drawer_upsell_3
    if upsell_1 == blank
      assign upsell_1 = all_products['magnetic-golf-towel']
    endif
    if upsell_2 == blank
      assign upsell_2 = all_products['golf-ball-marker-fork']
    endif
    if upsell_3 == blank
      assign upsell_3 = all_products['golf-club-brush-groove-sharpener-tool']
    endif
  -%}

  {%- assign upsell_slide_count = 0 -%}
  {%- capture upsell_slides -%}
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign product = upsell_1
          when 2
            assign product = upsell_2
          when 3
            assign product = upsell_3
        endcase

        if product == blank or product.id == blank
          continue
        endif

        assign already_in_cart = false
        for item in cart.items
          if item.product_id == product.id
            assign already_in_cart = true
            break
          endif
        endfor
        if already_in_cart
          continue
        endif

        unless product.available
          continue
        endunless

        assign selected_variant = product.selected_or_first_available_variant
        assign upsell_slide_count = upsell_slide_count | plus: 1
      -%}
      <div class="gn-cart-upsell__slide" data-upsell-slide>
        <div class="gn-cart-upsell__card">
          <div class="gn-cart-upsell__media-wrap">
            <a class="gn-cart-upsell__media" href="{{ product.url }}" tabindex="-1">
              {%- if product.featured_media -%}
                <img
                  src="{{ product.featured_media | image_url: width: 280 }}"
                  srcset="{{ product.featured_media | image_url: width: 200 }} 200w, {{ product.featured_media | image_url: width: 280 }} 280w"
                  sizes="140px"
                  alt="{{ product.featured_media.alt | default: product.title | escape }}"
                  width="140"
                  height="140"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
            <button
              type="button"
              class="btn gn-cart-upsell__add"
              data-upsell-add
              data-variant-id="{{ selected_variant.id }}"
              aria-label="Add {{ product.title | escape }} to cart"
              {% unless selected_variant.available %}disabled{% endunless %}
            >
              <span>Add</span>
            </button>
          </div>
          <a class="gn-cart-upsell__title" href="{{ product.url }}">{{ product.title | escape }}</a>
          <div class="gn-cart-upsell__price">
            <span class="gn-cart-upsell__price-current">{{ selected_variant.price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</span>
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              <s class="gn-cart-upsell__price-compare">{{ selected_variant.compare_at_price | money | replace: 'US$', '$' | replace: 'US $', '$' }}</s>
            {%- endif -%}
          </div>
          {%- if product.has_only_default_variant == false -%}
            <div class="gn-cart-upsell__swatches" role="radiogroup" aria-label="Color">
              {%- for variant in product.variants -%}
                {%- liquid
                  assign swatch_color = variant.option1 | handle
                  case swatch_color
                    when 'green'
                      assign swatch_hex = '#1d3d2a'
                    when 'black'
                      assign swatch_hex = '#111111'
                    when 'blue'
                      assign swatch_hex = '#2a5f9e'
                    when 'gray'
                      assign swatch_hex = '#9a9a9a'
                    when 'grey'
                      assign swatch_hex = '#9a9a9a'
                    when 'white'
                      assign swatch_hex = '#f4f4f4'
                    when 'dark-gray'
                      assign swatch_hex = '#555555'
                    when 'silver'
                      assign swatch_hex = '#c0c0c0'
                    else
                      assign swatch_hex = '#d8d3c4'
                  endcase
                -%}
                <button
                  type="button"
                  class="gn-cart-upsell__swatch{% if variant.id == selected_variant.id %} is-selected{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                  style="--swatch: {{ swatch_hex }};"
                  data-upsell-variant
                  data-variant-id="{{ variant.id }}"
                  aria-label="{{ variant.title | escape }}"
                  aria-pressed="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}"
                  {% unless variant.available %}disabled{% endunless %}
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if upsell_slide_count > 0 -%}
    <cart-drawer-upsell class="gn-cart-upsell" data-remaining="{{ upsell_slide_count }}">
      <div class="gn-cart-upsell__header">
        <h6 class="gn-cart-upsell__heading mt0 mb0">Frequently Bought With</h6>
      </div>
      <div class="gn-cart-upsell__scroller" data-upsell-viewport>
        <div class="gn-cart-upsell__track" data-upsell-track>
          {{ upsell_slides }}
        </div>
      </div>
    </cart-drawer-upsell>
  {%- endif -%}
{%- endunless -%}
