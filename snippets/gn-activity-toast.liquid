{% comment %}
  Site-wide activity toast (social proof).
  Included from layout/theme.liquid. Sits above sticky ATC on mobile.
{% endcomment %}
<style>
  .gn-activity-toast {
    --gn-toast-ink: #182b20;
    --gn-toast-accent: #1d3d2a;
    --gn-toast-muted: #6b7a70;
    --gn-toast-divider: #d7ddd8;
    --gn-toast-clear: 24px;
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(var(--gn-toast-clear), calc(env(safe-area-inset-bottom) + 16px));
    z-index: 2147483000;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(360px, calc(100vw - 32px));
    padding: 12px;
    border-radius: 12px;
    background: #fff;
    color: var(--gn-toast-ink);
    box-shadow: 0 10px 30px rgba(24, 43, 32, 0.18);
    border: 1px solid var(--gn-toast-divider);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.28s ease, transform 0.28s ease, bottom 0.2s ease;
  }
  .gn-activity-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .gn-activity-toast[hidden] {
    display: none !important;
  }
  .gn-activity-toast__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #e7f0ea;
    color: var(--gn-toast-accent);
  }
  .gn-activity-toast__icon svg {
    width: 20px;
    height: 20px;
  }
  .gn-activity-toast__copy {
    margin: 0;
    flex: 1 1 auto;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .gn-activity-toast__dismiss {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    margin: 0 -4px 0 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--gn-toast-muted);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .gn-activity-toast__dismiss:hover {
    background: #f3f1ea;
    color: var(--gn-toast-ink);
  }
  @media (max-width: 900px) {
    .gn-activity-toast {
      --gn-toast-clear: 96px;
      max-width: calc(100vw - 24px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gn-activity-toast {
      transition: none;
    }
  }
</style>

<div
  class="gn-activity-toast"
  data-gn-activity-toast
  data-toast-first="4.5"
  data-toast-visible="6.5"
  data-toast-interval="17"
  role="status"
  aria-live="polite"
  hidden
>
  <span class="gn-activity-toast__icon" data-gn-toast-icon aria-hidden="true"></span>
  <p class="gn-activity-toast__copy" data-gn-toast-message></p>
  <button class="gn-activity-toast__dismiss" type="button" data-gn-toast-dismiss aria-label="Dismiss notifications">×</button>
</div>

<script>
  (() => {
    if (window.__gnActivityToastReady) return;
    window.__gnActivityToastReady = true;

    const toast = document.querySelector('[data-gn-activity-toast]');
    if (!toast) return;
    const storageKey = 'gn-activity-toast-dismissed';
    try {
      if (sessionStorage.getItem(storageKey) === '1') return;
    } catch (e) {}

    if (toast.parentElement !== document.body) {
      document.body.appendChild(toast);
    }

    const messageEl = toast.querySelector('[data-gn-toast-message]');
    const iconEl = toast.querySelector('[data-gn-toast-icon]');
    const dismissBtn = toast.querySelector('[data-gn-toast-dismiss]');
    const firstDelay = Number(toast.dataset.toastFirst || 4.5) * 1000;
    const visibleFor = Number(toast.dataset.toastVisible || 6.5) * 1000;
    const interval = Number(toast.dataset.toastInterval || 17) * 1000;

    const people = [
