            { name: 'Piper', city: 'Greenville, SC' },
            { name: 'Alex', city: 'Indianapolis, IN' },
            { name: 'Quinn', city: 'Milwaukee, WI' }
          ];

    // Shuffle once per visit so top-5 density stays ~50% while order feels random
    for (let i = people.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = people[i];
      people[i] = people[j];
      people[j] = tmp;
    }

    const svgAttrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
    const icons = {
      club: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="19.5" cy="19.5" r="1.5"/><path d="M17 5.92 9 2v18H7v-1.73c-1.79.35-3 .99-3 1.73 0 1.1 2.69 2 6 2s6-.9 6-2c0-.99-2.16-1.81-5-1.97V8.98l6-3.06z"/></svg>`,
      gift: `<svg ${svgAttrs}><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M4 13h16"/><path d="M12 10v10"/><path d="M12 10c-1.8-2.4-4.5-2.6-5.5-1.4C5.2 10 6.4 12 8.5 12"/><path d="M12 10c1.8-2.4 4.5-2.6 5.5-1.4C18.8 10 17.6 12 15.5 12"/></svg>`,
      bag: `<svg ${svgAttrs}><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/></svg>`,
      tick: `<svg ${svgAttrs}><circle cx="12" cy="12" r="9"/><path d="m8.2 12.2 2.6 2.6 5-5.2"/></svg>`
    };
    const systemProducts = ['ARC ONE', 'LINE ONE', 'SYNC ONE', 'TRACE ONE'];
    const slides = [
      { icon: 'club', bought: true, text: (p, prod) => `${p.name} from ${p.city} just bought ${prod}!` },
      { icon: 'gift', text: (p) => `${p.name} unlocked a free gift with their order!` },
      { icon: 'bag', bought: true, text: (p, prod) => `${p.name} from ${p.city} just bought ${prod}!` },
      { icon: 'tick', text: (p) => `${p.name} selected the 3-item bundle — 50% off!` }
    ];

    let index = 0;
    let productIndex = 0;
    let hideTimer = null;
    let cycleTimer = null;
    let stopped = false;

    // Keep toast above sticky ATC / footer bars without covering the button
    const clearStickyBars = () => {
      const mobile = window.matchMedia('(max-width: 900px)').matches;
      let clear = mobile ? 96 : 24;
      if (mobile) {
        const candidates = document.querySelectorAll(
          '[data-gn-sticky-atc], .gn-arc-hero__sticky, [class*="sticky-add"], [class*="sticky-atc"], [id*="sticky-cart"], [class*="StickyAddToCart"]'
        );
        let tallest = 0;
        candidates.forEach((el) => {
          const style = window.getComputedStyle(el);
          if (style.display === 'none' || style.visibility === 'hidden') return;
          const h = el.getBoundingClientRect().height;
          if (h > tallest) tallest = h;
        });
        if (tallest > 0) clear = Math.ceil(tallest) + 14;
      }
      toast.style.setProperty('--gn-toast-clear', clear + 'px');
    };
    clearStickyBars();
    window.addEventListener('resize', clearStickyBars);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', clearStickyBars);
    }
    window.setTimeout(clearStickyBars, 800);
    window.setTimeout(clearStickyBars, 2500);

    const stop = () => {
      stopped = true;
      toast.classList.remove('is-visible');
      toast.setAttribute('hidden', '');
      if (hideTimer) window.clearTimeout(hideTimer);
      if (cycleTimer) window.clearInterval(cycleTimer);
    };

    const showNext = () => {
      if (stopped || document.hidden) return;
      clearStickyBars();
      const person = people[index % people.length];
      const slide = slides[index % slides.length];
      index += 1;
      let prod = 'ARC ONE';
      if (slide.bought) {
        prod = systemProducts[productIndex % systemProducts.length];
        productIndex += 1;
      }
      if (iconEl) iconEl.innerHTML = icons[slide.icon] || icons.bag;
      messageEl.textContent = slide.text(person, prod);
      toast.removeAttribute('hidden');
      requestAnimationFrame(() => toast.classList.add('is-visible'));
      if (hideTimer) window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        window.setTimeout(() => {
          if (!toast.classList.contains('is-visible')) toast.setAttribute('hidden', '');
        }, 280);
      }, visibleFor);
    };

    dismissBtn?.addEventListener('click', () => {
      try { sessionStorage.setItem(storageKey, '1'); } catch (e) {}
      stop();
    });

    window.setTimeout(() => {
      showNext();
      cycleTimer = window.setInterval(showNext, interval);
    }, firstDelay);
  })();
</script>
