{%- doc -%}
  Renders a cart discount form.
  @param {string} section_id - The section ID
{%- enddoc -%}

{% liquid
  assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
  for item in cart.items
    for allocation in item.line_level_discount_allocations
      if allocation.discount_application.type == 'discount_code'
        assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
      endif
    endfor
  endfor

  assign discount_codes = discount_codes | uniq
%}
<cart-discount-component class="gn-discount" data-section-id="{{ section_id }}">
  {%- if discount_codes.size > 0 -%}
    <div class="gn-discount__codes cart-discount__codes">
      {%- for discount_code in discount_codes -%}
        <div
          class="cart-discount__pill gn-discount__pill"
          data-discount-code="{{ discount_code }}"
          aria-label="{{ 'general.cart.discount_applied' | t: code: discount_code }}"
        >
          <button
            type="button"
            class="cart-discount__pill-remove gn-discount__pill-btn"
            aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
          >
            <span>{{ discount_code }}</span>
            {%- render 'icon-close-small' -%}
          </button>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <details class="gn-discount__details">
    <summary class="gn-discount__summary">Have a discount code?</summary>
    <div class="gn-discount__panel cart-discount__content">
      <form on:submit="/applyDiscount" onsubmit="return false;" class="cart-discount__form gn-discount__form">
        <label for="cart-discount-{{ section_id }}" class="visually-hidden">{{- 'general.cart.discount' | t -}}</label>
        <input
          id="cart-discount-{{ section_id }}"
          class="gn-discount__input"
          type="text"
          name="discount"
          placeholder="{{ 'general.cart.discount_code' | t }}"
          autocomplete="off"
          required
        >
        <button type="submit" class="gn-discount__apply" aria-label="{{- 'general.cart.discount' | t -}}">
          {{ 'general.cart.apply' | t }}
        </button>
      </form>
      <div class="cart-discount__error gn-discount__error body3 hidden" role="alert" ref="cartDiscountError">
        <p class="mt0 cart-discount__error-text hidden" ref="cartDiscountErrorDiscountCode">
          {{ 'general.cart.discount_code_error' | t: code: 'test' }}
        </p>
        <p class="mt0 cart-discount__error-text hidden" ref="cartDiscountErrorShipping">
          {{ 'general.cart.shipping_discount_error' | t }}
        </p>
      </div>
    </div>
  </details>
</cart-discount-component>
{% stylesheet %}
.gn-discount {
  display: block;
}
.gn-discount__codes {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0 0 8px;
}
.gn-discount__pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.03);
  color: inherit;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  line-height: 1;
  text-transform: uppercase;
  cursor: pointer;
}
.gn-discount__pill-btn svg {
  width: 10px;
  height: 10px;
  opacity: 0.55;
}
.gn-discount__summary {
  display: inline-flex;
  cursor: pointer;
  list-style: none;
  font-size: 0.8rem;
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
  text-decoration-color: rgba(0, 0, 0, 0.2);
}
.gn-discount__summary::-webkit-details-marker,
.gn-discount__summary::marker {
  display: none;
  content: '';
}
.gn-discount__details[open] .gn-discount__summary {
  margin-bottom: 8px;
  text-decoration: none;
}
.gn-discount__form {
  display: flex;
  align-items: stretch;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 6px;
  overflow: hidden;
  background: #fff;
}
.gn-discount__input {
  flex: 1 1 auto;
  min-width: 0;
  height: 38px;
  margin: 0;
  padding: 0 12px;
  border: 0;
  background: transparent;
  font-size: 0.875rem;
  box-shadow: none;
}
.gn-discount__input:focus {
  outline: none;
}
.gn-discount__apply {
  flex: 0 0 auto;
  height: 38px;
  padding: 0 14px;
  border: 0;
  border-left: 1px solid rgba(0, 0, 0, 0.12);
  background: transparent;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  cursor: pointer;
}
.gn-discount__error {
  margin-top: 6px;
}
.gn-discount__error p {
  margin: 0;
  font-size: 0.75rem;
}
{% endstylesheet %}
