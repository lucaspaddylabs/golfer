{% comment %}
  Mobile menu
  
  Accepts:
  - section: {Object}
  - page_width: page width
  - secondary_menu_links: {Object} Secondary menu links
  - social_media: {String} html social media icons
  - country_selector: {String} html country selector
  - language_selector: {String} html language selector
  - svg_icons: {Object} with icons

  Usage:
  {%- render "header-mobile",
      section: section,
      page_width:page_width,
      social_media: social_media,
      country_selector: country_selector,
      language_selector:language_selector
  -%}
{% endcomment %}

<style>
  .header__mobile__grid{
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    row-gap: 20px;
    min-height: 40px;
    padding: 0;
  }
  .header__mobile__grid>* {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
  }
</style>
{%- capture logo -%}
{%- if request.page_type == 'index' -%}
<h4 class="header__heading">
{%- else -%}
<div>
{%- endif -%}
  <a href="{{ routes.root_url }}" class="header__heading-link clear-underline" aria-label="{{ shop.name }}">
    {%- comment -%} Mobile chrome (≤900 sticky-ATC band) always uses the horizontal wordmark — stacked is desktop-only. {%- endcomment -%}
    {%- render 'gn-logo-horizontal', max_width: 148 -%}
  </a>
  {%- if template.name == "index" and settings.fixed_header_on_index_mobile -%}
  <a href="{{ routes.root_url }}" class="header__heading-link__transparent header__heading-link clear-underline" aria-label="{{ shop.name }}">
    {%- render 'gn-logo-horizontal', max_width: 148 -%}
  </a>
  {%- endif -%}
{%- if request.page_type != 'index' -%}  
</div>
{%- else -%}
</h4>
{%- endif -%}
{%- endcapture -%}
{%- capture user_icons -%}
{%- if settings.enable_compare -%}
<a href="{{ settings.page_compare.url }}" class="header__button body2">
  {%- render 'icon-compare' -%}
  <span>{{ 'compare.header.icon_compare' | t }}</span>
  <compare-bubble class="menu-drawer__button-bubble">
    <span class="menu-drawer__bubble-count"></span>
  </compare-bubble>
</a>
{%- endif -%}
{%- if settings.enable_wishlist -%}
<a href="{{ settings.page_wishlist.url }}" class="header__button body2">
  {%- render 'icon-wishlist', icon_type:"normal" -%}
  <span>{{ 'wishlist.header.icon_wishlist' | t }}</span>
  <wishlist-bubble class="menu-drawer__button-bubble">
    <span class="menu-drawer__bubble-count"></span>
  </wishlist-bubble>
</a>
{%- endif -%}
{%- endcapture -%}

{{ 'gn-mobile-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gn-mobile-menu.js' | asset_url }}" defer></script>
<div class="{{ page_width }}{% if settings.show_shadow_header_mobile %} header__mobile__shadow{% endif %}">
  {%- if section_settings_background -%}<div class="section-background border__radius">{%- endif -%}
  <div class="header__mobile__grid">
    <div class="menu-drawer gn-mnav-host">
      <menu-drawer>
        <details class="disclosure-has-popup">
          <summary>
            <div class="menu-drawer__button header__button" aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}">
              {%- render "icon-hamburger" -%}
            </div>
          </summary>
          <div class="popup-modal popup-modal__left">
            <div class="popup-modal__overlay" onclick="this.closest('menu-drawer').closeMenuDrawer('custom')"></div>
            <div class="popup-modal__content popup-modal__content__f-height">
              <div
                class="popup-modal__content__data custom__scrollbar"
                role="dialog"
                aria-modal="true"
                aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}"
                tabindex="-1"
              >
                {%- render 'gn-mobile-menu', linklist: section.settings.menu.links -%}
              </div>
            </div>
          </div>
        </details>
      </menu-drawer>
    </div>

    {{ logo }}
    
    {%- assign show_search = section.settings.show_search | default: true -%}
    <div class="header__icons">
      {%- if show_search != 'hide' -%}
      <div class="search-container">
        <modal-opener class="display-flex popup-modal__opener" data-modal="#header-modal-search">
          <a href="{{routes.search_url}}" class="header__button unstyled" aria-haspopup="dialog">
            {%- render "icon-search" -%}
          </a>
        </modal-opener>
      </div>
      {%- endif -%}
      {%- if settings.cart_type != "catalog_mode" -%}
      {%- comment -%}
        Policy A: href stays /cart for no-JS fallback. cart-drawer.js intercepts when drawer JS works.
      {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="header__button" id="cart-icon-bubble--mobile" aria-controls="CartDrawer">
        {%- render 'cart-icon-bubble' -%}
      </a>
      {%- endif -%}
    </div>

  </div>
  {%- if section_settings_background -%}</div>{%- endif -%}
</div>