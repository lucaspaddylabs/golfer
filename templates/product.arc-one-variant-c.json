      "type": "gn-arc-v2-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "quote": "It works! I'm hitting my drives 20-30 yards further. My partner in my scramble league is very happy. We won our league this year. The long par 4s are reachable again!",
            "attribution": "Verified buyer",
            "featured": true
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "quote": "It helps my timing when I swing.",
            "attribution": "Verified buyer",
            "featured": false
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "quote": "I use it in my right hand for about 6 swings. Then I do in in the left hand about 6 swings, then both hands with the normal grip. it is like a quick tune up.",
            "attribution": "Verified buyer",
            "featured": false
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "quote": "Using the swing trainer is an easy way to evaluate your swing without going to the driving range.",
            "attribution": "Verified buyer",
            "featured": false
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "quote": "Has really helped improve my contact. Very noticeable the first time I went to the range after using it every day for less than a week",
            "attribution": "Verified buyer",
            "featured": false
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "quote": "I purchased 2 of them. I use them and they help me groove my swing. I'm a satisfied person",
            "attribution": "Verified buyer",
            "featured": false
          }
        }
