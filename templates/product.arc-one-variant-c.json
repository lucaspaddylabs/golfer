    "faq": {
      "type": "gn-arc-v2-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What does ARC ONE actually do?",
            "answer": "<p>It clicks inside the shaft the moment your wrists release. You hear when you let go, then work to move the click later in the swing.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to hit balls with it?",
            "answer": "<p>No. It's built for practice swings. No ball, net, or app needed.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it indoors?",
            "answer": "<p>Yes, if you have room to swing safely. Start with half swings.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Will it fit in my golf bag?",
            "answer": "<p>Yes. It collapses to about 15.3 inches and extends to 26.5 inches.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn't work for me?",
            "answer": "<p>Send it back within 30 days for a full refund.</p>"
