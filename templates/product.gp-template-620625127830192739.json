        "gg6so9fI-NN_text": "<p>The Click That Trains Your Timing</p>",
        "gg8q4hPlQwc_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0986/1755/7338/files/click-test-still-4.png",
