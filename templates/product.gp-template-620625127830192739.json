        "ggQ4B1rVl4N_text": "<p>Engineered for control on every swing — the ergonomic grip keeps your hands locked in position so you can focus on form, not your hold.</p>",
        "ggQXBMkWI0I_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0986/1755/7338/files/click-test-still-2.jpg",
