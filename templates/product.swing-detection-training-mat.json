          "settings": {
            "label": "Usual problem",
            "title": "It felt flush — the ball didn’t",
            "copy": "A lot of golfers leave the range sure they struck it well. Without a mark, thin and fat feel almost the same."
          }
        },
        "contrast_2": {
          "type": "contrast",
          "settings": {
            "label": "With TRACE ONE",
            "title": "You get a mark you can train against",
            "copy": "The mat shows where you struck and how the low point behaved, so the next swing isn’t a guess."
          }
        },
        "beat_1": {
          "type": "beat",
          "settings": {
            "time": "1 min",
            "title": "See where you are now",
            "copy": "Take a few easy swings and just read the marks. Don’t try to fix anything yet."
          }
        },
        "beat_2": {
          "type": "beat",
          "settings": {
            "time": "3 min",
            "title": "Move the mark to center",
            "copy": "Make small changes. Keep going until the mark sits in the middle with a cleaner low point."
