    "faq": {
      "type": "gn-arc-one-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What does TRACE ONE actually do?",
            "answer": "<p>It’s a training mat that shows where you struck and how your low point behaved after each swing.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to hit balls with it?",
            "answer": "<p>You can use it for dry swings or with balls at the range. The mark is the feedback either way.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it indoors?",
            "answer": "<p>Yes — garage, patio, or any space where you can swing safely into the mat.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Will it roll up for travel?",
            "answer": "<p>Most people keep it rolled or flat near their practice spot. It’s made for repeated home and range use.</p>"
          }
        }
