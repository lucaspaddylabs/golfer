    "faq": {
      "type": "gn-arc-one-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What does LINE ONE actually do?",
            "answer": "<p>It’s a putting tutor that helps you see whether the ball starts on your aim line and builds a quieter stroke for better rolls.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a real green?",
            "answer": "<p>No. Short indoor or patio putts are enough to train start line. Take the same feel to the practice green later.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it indoors?",
            "answer": "<p>Yes — living room, office, or any flat space where you can roll a few putts safely.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Is it only for short putts?",
            "answer": "<p>Short putts are the best place to start. Once the start is solid, add a little distance.</p>"
          }
        }
      },
