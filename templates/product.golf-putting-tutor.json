          "settings": {
            "label": "Usual problem",
            "title": "You blame the green",
            "copy": "A lot of missed putts get blamed on pace or break. Often the ball never started on the line you picked."
          }
        },
        "contrast_2": {
          "type": "contrast",
          "settings": {
            "label": "With LINE ONE",
            "title": "You see the start immediately",
            "copy": "The tutor makes start line and stroke quietness obvious, so the next putt isn’t a guess."
          }
        },
        "beat_1": {
          "type": "beat",
          "settings": {
            "time": "1 min",
            "title": "See where you are now",
            "copy": "Roll a few short putts and just watch the start. Don’t try to fix anything yet."
          }
        },
        "beat_2": {
          "type": "beat",
          "settings": {
            "time": "3 min",
