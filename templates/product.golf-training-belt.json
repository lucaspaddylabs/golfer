    "faq": {
      "type": "gn-arc-one-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What does LINK ONE actually do?",
            "answer": "<p>It’s a training belt that gives you a physical cue when your arms disconnect from your body during the swing.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to hit balls with it?",
            "answer": "<p>No. Dry swings at home work great. Light range work is fine once the feel is there.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it indoors?",
            "answer": "<p>Yes, as long as you’ve got room to swing safely. Half swings are a good place to start.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Will it fit most golfers?",
            "answer": "<p>It’s adjustable, so most people can dial in a comfortable fit for practice.</p>"
          }
        }
