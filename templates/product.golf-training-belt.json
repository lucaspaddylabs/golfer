      "blocks": {
        "contrast_1": {
          "type": "contrast",
          "settings": {
            "label": "Usual problem",
            "title": "It feels connected — until it isn’t",
            "copy": "A lot of golfers think their arms and body move together. On video, the arms are already gone."
          }
        },
        "contrast_2": {
          "type": "contrast",
          "settings": {
            "label": "With LINK ONE",
            "title": "You feel the disconnect in real time",
            "copy": "The belt gives a clear cue when the arms race ahead, so the next swing isn’t a guess."
          }
        },
        "beat_1": {
          "type": "beat",
          "settings": {
            "time": "1 min",
            "title": "Feel where you are now",
            "copy": "Take a few easy swings and notice when the belt pulls. Don’t try to fix anything yet."
          }
        },
        "beat_2": {
          "type": "beat",
          "settings": {
            "time": "3 min",
            "title": "Keep arms and turn together",
            "copy": "Slow the takeaway and transition. Keep going until the pull softens and the move feels quieter."
          }
        },
        "beat_3": {
          "type": "beat",
          "settings": {
            "time": "1 min",
            "title": "Take it to a full swing",
            "copy": "Build a little speed while holding that same connected feel."
