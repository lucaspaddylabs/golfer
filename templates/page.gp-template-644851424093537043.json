        "ggA5Lab0001_text": "<p>THE OBJECT ITSELF</p>",
        "ggA5Spec001_text": "<p><span style=\"color:#C9C3B6;font-size:11px;letter-spacing:1.5px\">STOWED</span><br>15.2 in (38.5 cm) · fits in your golf bag</p><hr style=\"border:0;border-top:1px solid #3E5146\"><p><span style=\"color:#C9C3B6;font-size:11px;letter-spacing:1.5px\">EXTENDED</span><br>25.6 in (65 cm) for training</p><hr style=\"border:0;border-top:1px solid #3E5146\"><p><span style=\"color:#C9C3B6;font-size:11px;letter-spacing:1.5px\">BUILD</span><br>Stainless steel shaft, resin head, rubber grip</p><hr style=\"border:0;border-top:1px solid #3E5146\"><p><span style=\"color:#C9C3B6;font-size:11px;letter-spacing:1.5px\">SIGNAL</span><br>Audible click when you release</p><hr style=\"border:0;border-top:1px solid #3E5146\"><p><span style=\"color:#C9C3B6;font-size:11px;letter-spacing:1.5px\">SETUP</span><br>No app, no batteries, no subscription</p>"
