<script>
(function () {
  var origFetch = window.fetch;
  var origSearch = window.location.search || '';
  function getCookie(name) {
    var m = ('; ' + document.cookie).split('; ' + name + '=');
    if (m.length === 2) return m.pop().split(';').shift();
    return '';
  }
  function parseQS(qs) {
    var out = [];
    if (!qs) return out;
    var s = qs.charAt(0) === '?' ? qs.slice(1) : qs;
    if (!s) return out;
    s.split('&').forEach(function (pair) {
      if (!pair) return;
      var idx = pair.indexOf('=');
      var k = idx >= 0 ? pair.slice(0, idx) : pair;
      var v = idx >= 0 ? pair.slice(idx + 1) : '';
      if (!k) return;
      if (k === 'spf_cur' || k === 'currency_code' || k === 'reload_sid' || k === 'sf') return;
      if (k === 'undefined' || k === '=undefined' || v === 'undefined') return;
      out.push([k, v]);
    });
    return out;
  }

  window.fetch = function (input, init) {
    try {
      var urlStr = typeof input === 'string' ? input : (input && input.url) ? input.url : '';
      if (urlStr && window.CORAS_API && urlStr.indexOf(window.CORAS_API) === 0) {
        var u = new URL(urlStr, window.location.origin);

        if (u.searchParams.has('')) u.searchParams.delete('');
        u.searchParams.forEach(function (val, key) {
          if (!key || key === 'undefined' || val === 'undefined') u.searchParams.delete(key);
        });

        var cookieLanding = getCookie('_landing_detail');
        var cookieQS = '';
        if (cookieLanding) {
          try { cookieQS = decodeURIComponent(cookieLanding); } catch (e) { cookieQS = cookieLanding; }
        }

        var cookiePairs = parseQS(cookieQS);
        var urlPairs = parseQS(origSearch);
        var merged = {};
        cookiePairs.forEach(function (p) { merged[p[0]] = p[1]; });
        urlPairs.forEach(function (p) {
          if (!(p[0] in merged)) merged[p[0]] = p[1];
        });
        var pairs = Object.keys(merged).map(function (k) { return [k, merged[k]]; });

        for (var i = 0; i < pairs.length; i++) {
          var k = pairs[i][0], v = pairs[i][1];
          if (!u.searchParams.has(k)) u.searchParams.append(k, v);
        }

        if (typeof input === 'string') input = u.toString();
        else input = new Request(u.toString(), input);
      }
    } catch (e) {}

    return origFetch.call(this, input, init);
  };
})();
</script>
