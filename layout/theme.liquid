  </head>

  <body{% if request.design_mode %} data-supportcode="{{ settings.supportcode }}"{% endif %}>        
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    {%- if settings.cart_type == 'drawer' and template != "cart" -%}
      {%- section 'cart-drawer' -%}
    {%- endif -%}

    {%- if template.name == "index" -%}
    {%- if settings.fixed_header_on_index or settings.fixed_header_on_index_mobile -%}
    <fixed-headergroup class="fixed-header-group"
                       {% if settings.fixed_header_on_index %} data-transparent-desktop="true"{%- endif -%}
                       {% if settings.fixed_header_on_index_mobile %} data-transparent-mobile="true"{%- endif -%}>
    {%- endif -%}
    {%- sections 'header-group' -%}
    {%- if settings.fixed_header_on_index or settings.fixed_header_on_index_mobile -%}</fixed-headergroup>{%- endif -%}
    {%- else -%}
    {%- sections 'header-group' -%}
    {%- endif -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- render "breadcrumb" -%}
      {{ content_for_layout }}
    </main>

    <div class="footer__content">{% sections 'footer-group' %}</div>
    {%- sections 'popups-group' -%}
    
    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        root_url: '{{ routes.root_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
        all_products_collection_url: '{{ routes.all_products_collection_url }}',
        collections_url: '{{ routes.collections_url }}'
      };
      window.routes.root_url += window.routes.root_url=='/'?'':'/';

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
      };

      window.theme_id = '{{ theme.id }}';
      var wokiee_app = {
        main_info: {
          id:'{{ theme.id }}',
          shop: '{{ shop.permanent_domain }}',
          domain: '{{ shop.domain }}',
          lic: '{{ settings.license }}'
        }
      };

      {%- if settings.external_links_in_new_tab -%}
      document.querySelectorAll('a[href^="http"]').forEach((item) => {
        item.setAttribute('target', '_blank');
      });
      {%- endif -%}
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {% if request.design_mode %}
      <script src="{{ 'main-theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.show_add_discount_code -%}
    <script src="{{ 'cart-discount.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.enable_recently_viewed_products -%}
    <recently-viewed-products-record data-count="{{ settings.recently_viewed_products_limit }}"></recently-viewed-products-record>
    <script src="{{ 'module-recently-viewed-products.js' | asset_url }}" type="module"></script>
    {%- endif -%}
    {%- if settings.enable_rating -%}<link rel="stylesheet" href="{{ 'component-review-stars.css' | asset_url }}" media="print" onload="this.media='all'">{%- endif -%}
    {%- render "quick-view" -%}
    {% if template == 'cart' %}
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const checkoutBtn = document.querySelector('button[name="checkout"]');
        if (checkoutBtn) {
          checkoutBtn.addEventListener('click', function(e) {
            e.preventDefault();
            fetch('/cart.js')
              .then(res => res.json())
              .then(cart => {
                // Replace with your custom URL
                window.location.href = "https://checkout.golfernow.com/checkout?token=" + cart.token;
              });
          });
        }
      });
    </script>
    {% endif %}

<script>
(function () {
  'use strict';

  var LANDING_ENDPOINT = 'https://v2.webhook.dycama.com/paysight/ecomm/landing';
  var CART_ADD_ENDPOINT = 'https://v2.webhook.dycama.com/paysight/ecomm/cart-add';

  var DEBUG = true;
  var DEDUPE_LANDING = false; // keep false while testing
  var landingSentKey = 'dycama_landing_sent_' + window.location.href;
  var lastCartAddSentAt = 0;

  window.__DYCAMA_WEBHOOK_IMAGES__ = window.__DYCAMA_WEBHOOK_IMAGES__ || [];

  function log() {
    if (!DEBUG) return;
    try {
      console.log.apply(console, ['[DYCAMA WEBHOOK]'].concat([].slice.call(arguments)));
    } catch (e) {}
  }

  function warn() {
    try {
      console.warn.apply(console, ['[DYCAMA WEBHOOK]'].concat([].slice.call(arguments)));
    } catch (e) {}
  }

  function safeString(value) {
    if (value === undefined || value === null) return '';
    return String(value);
  }

  function safeDecode(value) {
    try {
      return decodeURIComponent(value);
    } catch (e) {
      return value;
    }
  }

  function parseUserAgent() {
    var ua = navigator.userAgent || '';
    var platform = navigator.platform || '';
    var maxTouchPoints = navigator.maxTouchPoints || 0;

    var browser = 'Unknown';
    var browserVersion = '';

    if (/Edg\/([\d.]+)/.test(ua)) {
      browser = 'Edge';
      browserVersion = ua.match(/Edg\/([\d.]+)/)[1];
    } else if (/OPR\/([\d.]+)/.test(ua)) {
      browser = 'Opera';
      browserVersion = ua.match(/OPR\/([\d.]+)/)[1];
    } else if (/CriOS\/([\d.]+)/.test(ua)) {
      browser = 'Chrome';
      browserVersion = ua.match(/CriOS\/([\d.]+)/)[1];
    } else if (/Chrome\/([\d.]+)/.test(ua)) {
      browser = 'Chrome';
      browserVersion = ua.match(/Chrome\/([\d.]+)/)[1];
    } else if (/FxiOS\/([\d.]+)/.test(ua)) {
      browser = 'Firefox';
      browserVersion = ua.match(/FxiOS\/([\d.]+)/)[1];
    } else if (/Firefox\/([\d.]+)/.test(ua)) {
      browser = 'Firefox';
      browserVersion = ua.match(/Firefox\/([\d.]+)/)[1];
    } else if (/Version\/([\d.]+).*Safari/.test(ua)) {
      browser = 'Safari';
      browserVersion = ua.match(/Version\/([\d.]+).*Safari/)[1];
    } else if (/Safari\/([\d.]+)/.test(ua)) {
      browser = 'Safari';
      browserVersion = ua.match(/Safari\/([\d.]+)/)[1];
    }

    var os = 'Unknown';
    var osVersion = '';

    if (/Windows NT ([\d.]+)/.test(ua)) {
      os = 'Windows';
      var nt = ua.match(/Windows NT ([\d.]+)/)[1];
      var windowsMap = {
        '10.0': '10/11',
        '6.3': '8.1',
        '6.2': '8',
        '6.1': '7'
      };
      osVersion = windowsMap[nt] || nt;
    } else if (/Android ([\d.]+)/.test(ua)) {
      os = 'Android';
      osVersion = ua.match(/Android ([\d.]+)/)[1];
    } else if (/iPhone OS ([\d_]+)/.test(ua)) {
      os = 'iOS';
      osVersion = ua.match(/iPhone OS ([\d_]+)/)[1].replace(/_/g, '.');
    } else if (/CPU OS ([\d_]+)/.test(ua)) {
      os = 'iPadOS';
      osVersion = ua.match(/CPU OS ([\d_]+)/)[1].replace(/_/g, '.');
    } else if (/Mac OS X ([\d_]+)/.test(ua)) {
      os = maxTouchPoints > 1 && /Macintosh/.test(ua) ? 'iPadOS' : 'macOS';
      osVersion = ua.match(/Mac OS X ([\d_]+)/)[1].replace(/_/g, '.');
    } else if (/Linux/.test(ua)) {
      os = 'Linux';
    }

    var deviceType = 'desktop';

    if (/Mobi|Android|iPhone|iPod/i.test(ua)) {
      deviceType = 'mobile';
    }

    if (/iPad|Tablet/i.test(ua) || (platform === 'MacIntel' && maxTouchPoints > 1)) {
      deviceType = 'tablet';
    }

    var brand = 'Unknown';

    if (/iPhone|iPad|iPod|Macintosh|Mac OS X/i.test(ua)) {
      brand = 'Apple';
    } else if (/Samsung|SM-|SAMSUNG/i.test(ua)) {
      brand = 'Samsung';
    } else if (/Huawei|HUAWEI/i.test(ua)) {
      brand = 'Huawei';
    } else if (/Pixel/i.test(ua)) {
      brand = 'Google';
    } else if (/Android/i.test(ua)) {
      brand = 'Android';
    } else if (/Windows/i.test(ua)) {
      brand = 'Microsoft';
    }

    return {
      browser: browser,
      browser_version: browserVersion,
      brand: brand,
      device_type: deviceType,
      os: os,
      os_version: osVersion
    };
  }

  function getCookie(name) {
    var match = document.cookie.match(
      new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()[\]\\/+^]/g, '\\$&') + '=([^;]*)')
    );

    if (!match) return '';
    return safeDecode(match[1]);
  }

  function getCurrentParamsObject() {
    var params = {};

    try {
      new URLSearchParams(window.location.search || '').forEach(function (value, key) {
        if (!key) return;
        params[key] = value;
      });
    } catch (e) {}

    return params;
  }

  function getShopifyMeta() {
    var meta = {};

    try {
      meta.shop = window.Shopify && window.Shopify.shop ? window.Shopify.shop : '';
      meta.currency =
        window.Shopify && window.Shopify.currency && window.Shopify.currency.active
          ? window.Shopify.currency.active
          : '';
      meta.theme_id = window.theme_id || '';
      meta.page_title = document.title || '';
      meta.pathname = window.location.pathname || '';
      meta.referrer = document.referrer || '';
      meta.screen_width = window.screen && window.screen.width ? window.screen.width : '';
      meta.screen_height = window.screen && window.screen.height ? window.screen.height : '';
      meta.language = navigator.language || '';
      meta.timestamp = new Date().toISOString();

      if (
        window.ShopifyAnalytics &&
        window.ShopifyAnalytics.meta &&
        window.ShopifyAnalytics.meta.product
      ) {
        meta.product_id = window.ShopifyAnalytics.meta.product.id || '';
        meta.product_handle = window.ShopifyAnalytics.meta.product.handle || '';
        meta.selected_variant_id = window.ShopifyAnalytics.meta.selectedVariantId || '';
      }
    } catch (e) {}

    return meta;
  }

  function getFormDataObject(form) {
    var out = {};

    try {
      if (!form) return out;

      new FormData(form).forEach(function (value, key) {
        out[key] = value;
      });
    } catch (e) {}

    return out;
  }

  function normaliseCartAddBody(body) {
    if (!body) return {};

    try {
      if (typeof body === 'string') {
        try {
          return JSON.parse(body);
        } catch (e) {
          var parsedString = {};
          new URLSearchParams(body).forEach(function (value, key) {
            parsedString[key] = value;
          });
          return parsedString;
        }
      }

      if (body instanceof FormData) {
        var parsedFormData = {};
        body.forEach(function (value, key) {
          parsedFormData[key] = value;
        });
        return parsedFormData;
      }

      if (body instanceof URLSearchParams) {
        var parsedParams = {};
        body.forEach(function (value, key) {
          parsedParams[key] = value;
        });
        return parsedParams;
      }
    } catch (e) {}

    return {};
  }

  function addObjectToUrl(url, prefix, object) {
    if (!object || typeof object !== 'object') return;

    Object.keys(object).forEach(function (key) {
      var value = object[key];

      if (value && typeof value === 'object') {
        try {
          value = JSON.stringify(value);
        } catch (e) {
          value = '';
        }
      }

      url.searchParams.set(prefix + key, safeString(value));
    });
  }

  function buildWebhookUrl(endpoint, eventName, extra) {
    var url = new URL(endpoint);
    var device = parseUserAgent();

    url.searchParams.set('event', eventName);
    url.searchParams.set('full_url', window.location.href);
    url.searchParams.set('path', window.location.pathname || '');
    url.searchParams.set('query_string', window.location.search || '');
    url.searchParams.set('referrer', document.referrer || '');
    url.searchParams.set('landing_detail', getCookie('_landing_detail'));

    url.searchParams.set('browser', device.browser);
    url.searchParams.set('browser_version', device.browser_version);
    url.searchParams.set('brand', device.brand);
    url.searchParams.set('device_type', device.device_type);
    url.searchParams.set('os', device.os);
    url.searchParams.set('os_version', device.os_version);

    addObjectToUrl(url, 'param_', getCurrentParamsObject());
    addObjectToUrl(url, 'meta_', getShopifyMeta());
    addObjectToUrl(url, '', extra || {});

    return url.toString();
  }

  function sendGet(endpoint, eventName, extra) {
    var url;

    try {
      url = buildWebhookUrl(endpoint, eventName, extra);
    } catch (e) {
      warn('Could not build GET URL:', eventName, e);
      return;
    }

    log('GET firing:', eventName, url);

    /*
      GET request only. no-cors means we do not need CORS headers from Dycama.
      The request should still appear in DevTools Network.
    */
    try {
      fetch(url, {
        method: 'GET',
        mode: 'no-cors',
        cache: 'no-store',
        keepalive: true,
        credentials: 'omit'
      }).catch(function (e) {
        warn('fetch GET failed, falling back to image:', e);
        fireImageGet(url);
      });
    } catch (e) {
      warn('fetch GET threw, falling back to image:', e);
      fireImageGet(url);
    }
  }

  function fireImageGet(url) {
    try {
      var img = new Image();
      window.__DYCAMA_WEBHOOK_IMAGES__.push(img);
      img.onload = function () {
        log('image GET loaded:', url);
      };
      img.onerror = function () {
        /*
          For webhook endpoints this may error visually, but the GET can still reach the server.
        */
        warn('image GET completed/error:', url);
      };
      img.referrerPolicy = 'no-referrer-when-downgrade';
      img.src = url;
    } catch (e) {
      warn('image GET failed:', e);
    }
  }

  function isCartAddUrl(url) {
    if (!url) return false;

    try {
      var parsed = new URL(url, window.location.origin);
      return (
        parsed.pathname === '/cart/add' ||
        parsed.pathname === '/cart/add.js' ||
        parsed.pathname.indexOf('/cart/add') === 0
      );
    } catch (e) {
      return String(url).indexOf('/cart/add') !== -1;
    }
  }

  function sendLandingOnce() {
    if (DEDUPE_LANDING) {
      try {
        if (sessionStorage.getItem(landingSentKey) === '1') {
          log('landing skipped because sessionStorage dedupe is active');
          return;
        }

        sessionStorage.setItem(landingSentKey, '1');
      } catch (e) {}
    }

    sendGet(LANDING_ENDPOINT, 'page_view', {
      page_type: document.body && document.body.dataset ? document.body.dataset.template || '' : ''
    });
  }

  function sendCartAdd(extra) {
    var now = Date.now();

    if (now - lastCartAddSentAt < 500) {
      log('cart add skipped due to debounce');
      return;
    }

    lastCartAddSentAt = now;
    sendGet(CART_ADD_ENDPOINT, 'add_to_cart', extra || {});
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sendLandingOnce);
  } else {
    sendLandingOnce();
  }

  if (window.fetch) {
    var originalFetch = window.fetch;

    window.fetch = function (input, init) {
      var requestUrl =
        typeof input === 'string'
          ? input
          : input && input.url
            ? input.url
            : '';

      var requestBody =
        init && init.body
          ? init.body
          : input && input.body
            ? input.body
            : null;

      var isCartAdd = isCartAddUrl(requestUrl);

      return originalFetch.apply(this, arguments).then(function (response) {
        if (isCartAdd && response && response.ok) {
          sendCartAdd({
            detection_method: 'fetch',
            cart_add_url: requestUrl,
            cart_add_body: normaliseCartAddBody(requestBody)
          });
        }

        return response;
      });
    };
  }

  if (window.XMLHttpRequest) {
    var originalOpen = XMLHttpRequest.prototype.open;
    var originalSend = XMLHttpRequest.prototype.send;

    XMLHttpRequest.prototype.open = function (method, url) {
      this.__dycamaMethod = method;
      this.__dycamaUrl = url;
      return originalOpen.apply(this, arguments);
    };

    XMLHttpRequest.prototype.send = function (body) {
      var xhr = this;

      try {
        if (isCartAddUrl(xhr.__dycamaUrl)) {
          xhr.addEventListener('load', function () {
            if (xhr.status >= 200 && xhr.status < 300) {
              sendCartAdd({
                detection_method: 'xhr',
                cart_add_url: xhr.__dycamaUrl,
                cart_add_body: normaliseCartAddBody(body)
              });
            }
          });
        }
      } catch (e) {}

      return originalSend.apply(this, arguments);
    };
  }

  document.addEventListener(
    'submit',
    function (event) {
      var form = event.target;
      if (!form || !form.getAttribute) return;

      var action = form.getAttribute('action') || '';

      if (!isCartAddUrl(action)) return;

      sendCartAdd({
        detection_method: 'form_submit',
        cart_add_url: action,
        form_data: getFormDataObject(form)
      });
    },
    true
  );

  document.addEventListener(
    'click',
    function (event) {
      var target =
        event.target && event.target.closest
          ? event.target.closest(
              'button[name="add"], button[type="submit"][name="add"], .product-form__submit, .main-product-atc, .atc-button, [data-action="add-to-cart"], [data-add-to-cart], [class*="add-to-cart" i]'
            )
          : null;

      if (!target) return;

      var form = target.closest && target.closest('form[action*="/cart/add"]');

      sendCartAdd({
        detection_method: 'click_fallback',
        button_text: target.textContent ? target.textContent.trim() : '',
        form_data: getFormDataObject(form)
      });
    },
    true
  );
})();
</script>
  </body>
</html>
