            if (!form.matches(ADD_TO_CART_FORM_SELECTOR))
                return;
            const submitter = event.submitter || document.activeElement;
            if (submitter && isBuyNowTrigger(submitter))
                return;
            if (submitter && findCheckoutTrigger(submitter))
                return;
            trackAddToCartEvent("submit", submitter || form, {});
        }, true);
        if (typeof window.fetch === "function") {
            const originalFetch = window.fetch.bind(window);
            window.fetch = function (input, init) {
                try {
                    const url = typeof input === "string"
                        ? input
                        : input && input.url
                            ? input.url
                            : "";
                    const method = String((init && init.method) ||
                        (input && input.method) ||
                        "GET").toUpperCase();
                    if (method === "POST" &&
                        url &&
                        (url.indexOf("/cart/add") !== -1 ||
                            url.indexOf("/cart/add.js") !== -1)) {
                        let variantId = "";
                        let quantity = 1;
                        try {
                            const body = init && init.body;
                            if (typeof body === "string") {
                                try {
                                    const parsed = JSON.parse(body);
                                    if (parsed && parsed.items && parsed.items[0]) {
                                        variantId = String(parsed.items[0].id || "");
                                        quantity = parsed.items[0].quantity || 1;
                                    }
                                    else if (parsed && parsed.id) {
                                        variantId = String(parsed.id);
                                        quantity = parsed.quantity || 1;
                                    }
                                }
                                catch (e) {
                                    const params = new URLSearchParams(body);
                                    variantId = params.get("id") || "";
                                    quantity = parseInt(params.get("quantity") || "1", 10) || 1;
                                }
                            }
                            else if (typeof FormData !== "undefined" &&
                                body instanceof FormData) {
                                variantId = String(body.get("id") || "");
                                quantity = parseInt(body.get("quantity") || "1", 10) || 1;
                            }
                        }
                        catch (e) { }
                        trackAddToCartEvent("fetch", document.body, {
                            variant_id: variantId || getProductContext(document.body).variant_id,
                            quantity: quantity,
                        });
                    }
                }
                catch (e) { }
                return originalFetch(input, init);
            };
        }
    }
    async function startPSCheckout(trigger, meta) {
        meta = meta || {};
        if (shouldBypassIntercept())
            return;
        if (checkoutInProgress) {
            log("Checkout already in progress, ignoring.");
            return;
        }
        const startedAt = Date.now();
        activeCheckoutAttemptId = randomUuid();
        activeNativeAction =
            meta.nativeAction ||
                readNativeAction(trigger, meta.nativeUrl) ||
                activeNativeAction;
        const triggerType = meta.triggerType ||
            (isBuyNowTrigger(trigger) ? "buy_now" : "checkout");
        trackCheckoutClick(trigger, {
            triggerType: triggerType,
            isBuyNow: isBuyNowTrigger(trigger) || !!meta.forceBuyNow,
        });
        track("storefront_checkout_intercepted", {
            trigger_source: normalizeTriggerSource(triggerType),
            duration_ms: 0,
        });
        lockCheckout(trigger);
        try {
            let expectedVariants = null;
            if (isBuyNowTrigger(trigger) || meta.forceBuyNow) {
                const prep = await prepareBuyNow(trigger);
                expectedVariants = prep.expectedVariants;
            }
            const cartResult = await fetchCartWithRetry({
                expectedVariants: expectedVariants,
                syncTimeoutMs: expectedVariants ? CART_SYNC_TIMEOUT_MS : null,
                maxAttempts: CONFIG.cartRetries,
            });
            if (!shouldRedirectCart(cartResult.cart)) {
                log("Cart not in allowlist — native checkout");
                goNativeCheckout("allowlist_miss");
                return;
            }
            const redirectUrl = await postToPSWithRetries(cartResult.items, cartResult.cart);
            const checkoutSessionId = extractCheckoutSessionId(redirectUrl);
            track("storefront_checkout_created", {
                checkout_session_id: checkoutSessionId,
                result: checkoutSessionId ? "created" : "missing_checkout_session",
                duration_ms: Date.now() - startedAt,
            });
            redirectToUrl(redirectUrl, Date.now() - startedAt);
        }
        catch (error) {
            const code = safeErrorCode(error, "unknown");
            warn("Checkout failed:", code);
            goNativeCheckout(code);
        }
    }
    function blockAndStart(event, trigger, meta) {
        if (shouldBypassIntercept())
            return true;
        meta = meta || {};
        if (!meta.nativeAction) {
            meta.nativeAction = readNativeAction(trigger);
        }
        if (event) {
            event.preventDefault();
            event.stopPropagation();
            if (event.stopImmediatePropagation)
                event.stopImmediatePropagation();
        }
        if (trigger &&
            trigger.tagName &&
            trigger.tagName.toLowerCase() === "button") {
            trigger.setAttribute("type", "button");
        }
        startPSCheckout(trigger, meta);
        return false;
    }
    function findCheckoutTrigger(target) {
        if (!target)
            return null;
        const trigger = findClosest(target, CHECKOUT_SELECTOR);
        if (!trigger)
            return null;
        const addToCartForm = findClosest(trigger, "form[action^='/cart/add'], form[action^='/cart/add.js']");
        if (addToCartForm && !isBuyNowTrigger(trigger))
            return null;
        return trigger;
    }
    function isCartCheckoutForm(form, submitter) {
        if (!form || !form.matches)
            return false;
        const action = form.getAttribute("action") || "";
        if (action.indexOf("/cart/add") === 0 ||
            action.indexOf("/cart/add.js") === 0) {
            return false;
        }
        if (submitter && findCheckoutTrigger(submitter))
            return true;
        if (form.matches(CART_FORM_SELECTOR))
            return true;
        if (form.querySelector(CHECKOUT_SELECTOR))
            return true;
        return false;
    }
    function isCheckoutPath(pathname) {
        if (!pathname)
            return false;
        return (pathname.indexOf("/checkout") !== -1 ||
            pathname.indexOf("/checkouts") !== -1 ||
            pathname.indexOf("/cn/") !== -1 ||
            pathname.indexOf("/cart/c/") !== -1 ||
            /\/[a-z]{2}(-[a-z]{2})?\/checkout/i.test(pathname));
    }
    function setupNavigationIntercept() {
        if (typeof navigation === "undefined")
            return false;
        navigation.addEventListener("navigate", function (event) {
            if (shouldBypassIntercept(event.destination && event.destination.url)) {
                return;
            }
            let url;
            try {
                url = new URL(event.destination.url);
            }
            catch (e) {
                return;
            }
            if (url.origin !== window.location.origin)
                return;
            const pathname = url.pathname;
            const isCartFormNav = (pathname === "/cart" || pathname === "/cart/") && event.formData;
            if (!isCheckoutPath(pathname) && !isCartFormNav)
                return;
            log("Intercepted checkout navigation:", pathname);
            event.preventDefault();
            if (event.stopImmediatePropagation)
                event.stopImmediatePropagation();
            const tokenMatch = pathname.match(/^\/cart\/c\/([^/]+)/);
            if (tokenMatch) {
                cartToken = decodeURIComponent(tokenMatch[1]);
                startPSCheckout(null, {
                    triggerType: "nav_buy_now_token",
                    nativeUrl: url.toString(),
                });
            }
            else {
                startPSCheckout(null, {
                    triggerType: "navigation",
                    nativeUrl: url.toString(),
                });
            }
        });
        log("Navigation API intercept active");
        return true;
    }
    function setupDocumentIntercepts() {
        document.addEventListener("click", function (event) {
            const trigger = findCheckoutTrigger(event.target);
            if (!trigger)
                return;
            log("Checkout click intercepted");
            return blockAndStart(event, trigger, {
                triggerType: isBuyNowTrigger(trigger) ? "buy_now" : "click",
            });
        }, true);
        document.addEventListener("submit", function (event) {
            const form = event.target;
            const submitter = event.submitter || document.activeElement;
            if (!isCartCheckoutForm(form, submitter))
                return;
            log("Checkout form submit intercepted");
            return blockAndStart(event, findCheckoutTrigger(submitter) || submitter || form, { triggerType: "submit" });
        }, true);
        function forceButtonType(event) {
            const trigger = findCheckoutTrigger(event.target);
            if (!trigger)
                return;
            if (trigger.tagName &&
                trigger.tagName.toLowerCase() === "button") {
                trigger.setAttribute("type", "button");
            }
        }
        document.addEventListener("mousedown", forceButtonType, true);
        document.addEventListener("touchstart", forceButtonType, true);
    }
    function hookButtons(selector, handler) {
        const ATTRS_TO_REMOVE = [
            "onclick",
            "form",
            "action",
            "name",
            "type",
            "method",
            "data-ocu-checkout",
        ];
        document.querySelectorAll(selector).forEach(function (btn) {
            if (btn._psBound)
                return;
            btn._psBound = true;
            btn.__psNativeAction = readNativeAction(btn);
            ATTRS_TO_REMOVE.forEach(function (attr) {
                btn.removeAttribute(attr);
            });
            if (btn.tagName && btn.tagName.toLowerCase() === "button") {
                btn.type = "button";
            }
            const observer = new MutationObserver(function () {
                const needsStrip = ATTRS_TO_REMOVE.some(function (attr) {
                    return btn.hasAttribute(attr);
                });
                if (needsStrip) {
                    observer.disconnect();
                    ATTRS_TO_REMOVE.forEach(function (attr) {
                        btn.removeAttribute(attr);
                    });
                    if (btn.tagName && btn.tagName.toLowerCase() === "button") {
                        btn.type = "button";
                    }
                    observer.observe(btn, { attributes: true });
                }
            });
            observer.observe(btn, { attributes: true });
            btn.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                handler(btn, e);
            }, true);
        });
    }
    function hookUpcartDrawer() {
        const shadowHost = document.querySelector("#upCart");
        const root = (shadowHost && shadowHost.shadowRoot) || document.documentElement;
        const observer = new MutationObserver(function () {
            const link = root.querySelector(".upcart-checkout-button-container a");
            if (!link || link._psBound)
                return;
            link._psBound = true;
            link.__psNativeAction = readNativeAction(link);
            link.removeAttribute("href");
            link.style.cursor = "pointer";
            link.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                startPSCheckout(link, { triggerType: "upcart" });
            }, true);
        });
        observer.observe(root, { childList: true, subtree: true });
    }
    function hookOCUCartCheckout() {
        const SELECTOR = "button.ocu-checkout-button, [form='ocu-cart-form'][name='checkout']";
        const EVENTS = ["pointerdown", "mousedown", "click", "touchstart"];
        const handler = function (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            startPSCheckout(e.currentTarget || e.target, {
                triggerType: "ocu",
            });
        };
        document.querySelectorAll(SELECTOR).forEach(function (btn) {
            if (btn.__psHardBound)
                return;
            btn.__psHardBound = true;
            btn.__psNativeAction = readNativeAction(btn);
            EVENTS.forEach(function (evt) {
                btn.addEventListener(evt, handler, true);
            });
            ["onclick", "form", "type"].forEach(function (attr) {
                btn.removeAttribute(attr);
            });
            btn.type = "button";
        });
    }
    function hookMonsterCartDrawer() {
        const btn = document.getElementById("mu-checkout-button");
        if (!btn || btn._psBound)
            return;
        btn._psBound = true;
        btn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            startPSCheckout(btn, { triggerType: "monster" });
        }, true);
    }
    let hookRaf = null;
    function runAllHooks() {
        if (CONFIG.buyNowEnabled !== false && BUY_NOW_SELECTORS) {
            hookButtons(BUY_NOW_SELECTORS, function (btn, e) {
                blockAndStart(e, btn, { triggerType: "buy_now" });
            });
        }
        hookButtons(CART_CHECKOUT_SELECTORS, function (btn, e) {
            blockAndStart(e, btn, { triggerType: "hook_checkout" });
        });
        hookUpcartDrawer();
        hookOCUCartCheckout();
        hookMonsterCartDrawer();
    }
    function scheduleHooks() {
        if (hookRaf)
            return;
        hookRaf = requestAnimationFrame(function () {
            hookRaf = null;
            runAllHooks();
        });
    }
    function setupHooks() {
        const observer = new MutationObserver(scheduleHooks);
        if (document.body) {
            observer.observe(document.body, { childList: true, subtree: true });
            runAllHooks();
        }
        else {
            document.addEventListener("DOMContentLoaded", function () {
                observer.observe(document.body, {
                    childList: true,
                    subtree: true,
                });
                runAllHooks();
            });
        }
    }
    function setupAttributionListeners() {
        window.addEventListener("popstate", function () {
            if (!firstTouchParams && hasUsableParams(window.location.search)) {
                captureFirstTouchParams();
            }
        });
    }
    function preconnectApi() {
        try {
            const url = new URL(CONFIG.api, window.location.origin);
            const link = document.createElement("link");
            link.rel = "preconnect";
            link.href = url.origin;
            link.crossOrigin = "anonymous";
            document.head.appendChild(link);
        }
        catch (e) { }
    }
    window.PS = {
        version: SCRIPT_VERSION,
        ingressContract: INGRESS_CONTRACT_MARKER,
        startCheckout: function (trigger) {
            return startPSCheckout(trigger || null, {
                triggerType: "api",
            });
        },
        getConfig: function () {
            return CONFIG;
        },
        captureAttribution: function () {
            captureFirstTouchParams();
            return getLandingDetail();
        },
        getLandingDetail: getLandingDetail,
        registerHook: function (name, fn) {
            if (!hooks[name])
                hooks[name] = [];
            if (typeof fn === "function")
                hooks[name].push(fn);
        },
    };
    setupNavigationIntercept();
    setupLifecycleHandlers();
    function init() {
        log("v" + SCRIPT_VERSION, "| store:", shopId());
        pssid = getOrCreatePssid();
        clearStaleNativeFallback();
        preconnectApi();
        captureFirstTouchParams();
        captureSessionTouchParams();
        setupAttributionListeners();
        setupAddToCartTracking();
        setupDocumentIntercepts();
        setupHooks();
        loadPostHog();
        if (!CONFIG.posthog || !CONFIG.posthog.enabled) {
            log("PostHog disabled; V3 browser events will not be captured.");
        }
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    }
    else {
        init();
    }
})();

